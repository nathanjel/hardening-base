#!/usr/bin/env bash
# hb-backup — encrypted, deduplicated backups with restic, read from a read-only
# btrfs snapshot so that every file comes from the same instant.
#
#   hb backup init        create the repository and its password (once)
#   hb backup run         state dump, snapshot, backup, forget old snapshots
#   hb backup dry-run     the same, but restic writes nothing: shows the size
#   hb backup maintain    prune, then check the repository; in the first week of
#                         a month also read back backup.read_data_percent of the data
#   hb backup status      recent runs, what the last one covered, the newest restic snapshots
#   hb backup check       one-line verdict on the last good backup: its age, and
#                         whether it covered what backup.paths asks for
#   hb backup restic ...  any restic command against the repository, e.g.
#                           hb backup restic snapshots
#                           hb backup restic restore latest --target /tmp/r --include /etc/hb
#
# Before the backup, hb inventory run writes the state dump, what a rebuild
# needs to know, into /var/lib/hb/state: installed packages, snaps, accounts,
# firewall zones, enabled units, disks, Docker containers and, with microk8s,
# its add-ons and every object (secrets included; the repository is encrypted).
#
# Each run notes what it covered (last-coverage): paths that don't exist, paths read
# live rather than from the snapshot (not on the root filesystem, or no snapshot),
# and mounts or btrfs subvolumes below the paths, which neither the snapshot nor
# --one-file-system takes in. A missing path, a lookup that failed (so it can't tell),
# or something left out that isn't in backup.exclude makes check warn. A path with
# another listed path below it on a different filesystem is read live, both of them.
#
# Config ([backup] in hb.toml): repo, password_file, require_mount, paths,
# exclude, exclude_if_present, keep_daily, keep_weekly, keep_monthly,
# warn_hours, fail_hours, read_data_percent. Nothing happens while repo is "".
#
# The password file is the only key to the repository. Keep a copy away from
# this box: without it nobody, you included, can read the backup.
set -u
source "$(dirname "$(readlink -f "$0")")/../lib/hb.sh"
need_root
need_config

REPO="$(cfg backup.repo)"
PWFILE="$(cfg backup.password_file)"
MOUNT="$(cfg backup.require_mount)"
mapfile -t PATHS < <(cfg backup.paths)
mapfile -t EXCLUDE < <(cfg backup.exclude)
mapfile -t IF_PRESENT < <(cfg backup.exclude_if_present)
SNAP="$(cfg snapshot.dir)/backup-run"
STATUS="$HB_STATE/hb-backup"     # last-ok, last-run, last-check, last-coverage: read by `check`
CACHE="${HB_CACHE:-/var/cache}/hb-restic"   # not under /var/lib/hb, so not backed up
HOST="$(hostname -s)"
KEEP=(--keep-daily "$(cfg backup.keep_daily)" --keep-weekly "$(cfg backup.keep_weekly)"
      --keep-monthly "$(cfg backup.keep_monthly)")
export RESTIC_REPOSITORY="$REPO" RESTIC_PASSWORD_FILE="$PWFILE"

r() { restic --cache-dir "$CACHE" "$@"; }

# need_repo — configured, restic present, and the share mounted. Writing the
# repository to the local disk because the share was missing would fill it.
need_repo() {
  [ -n "$REPO" ] || die "backup.repo is not set"
  command -v restic >/dev/null || die "restic is not installed (dnf install restic)"
  if [ -n "$MOUNT" ]; then
    awk -v m="$MOUNT" '$2 == m {found=1} END {exit !found}' /proc/self/mounts \
      || die "$MOUNT is not mounted; refusing to write the backup anywhere else"
    case "$REPO" in "$MOUNT"/*) ;; *) die "backup.repo must be inside $MOUNT" ;; esac
  fi
  mkdir -p "$STATUS" "$CACHE"
}
need_init() { [ -f "$REPO/config" ] || die "no repository at $REPO yet: hb backup init"; }
take_lock() { exec 9>"$STATUS/lock"; flock -n 9 || die "another hb backup run or maintain is in progress"; }

# --- state dump -------------------------------------------------------------------
# hb inventory writes it into /var/lib/hb/state, which is backed up with the rest.
# A piece it can't read is noted there (and in its check), never fatal here.
dump_state() { "$HB_ROOT/hb" inventory run >/dev/null || log "state dump incomplete (hb inventory show)"; }

# --- snapshot -----------------------------------------------------------------------
take_snapshot() {
  if [ "$(stat -f -c %T /)" != btrfs ]; then SNAP=""; log "/ is not btrfs: backing up the live files"; return; fi
  [ -e "$SNAP" ] && btrfs subvolume delete "$SNAP" >/dev/null   # left by an interrupted run
  mkdir -p "$(dirname "$SNAP")"
  btrfs subvolume snapshot -r / "$SNAP" >/dev/null || die "cannot snapshot /"
}
drop_snapshot() { [ -n "$SNAP" ] && [ -e "$SNAP" ] && btrfs subvolume delete "$SNAP" >/dev/null; }

# Filesystems that hold nothing to back up (pseudo, in-memory, container layers, snap images).
PSEUDO='^(proc|sysfs|devtmpfs|devpts|tmpfs|ramfs|cgroup2?|securityfs|pstore|bpf|tracefs|debugfs|mqueue|hugetlbfs|configfs|fusectl|autofs|binfmt_misc|nsfs|efivarfs|overlay|squashfs|fuse\.snapfuse|rpc_pipefs)$'

# boundaries PATH... — mount points and btrfs subvolumes strictly below the paths (but not
# themselves one of the paths): the snapshot doesn't hold them and --one-file-system doesn't
# cross into them. A lookup that fails prints "?what: error" instead, so the report can say
# it doesn't know rather than that nothing was left out.
boundaries() {
  local p m t fs out fsroot snapdir found=()
  if out="$(findmnt -rn -o TARGET,FSTYPE 2>&1)"; then
    while read -r t fs; do
      [ -n "$t" ] && ! [[ $fs =~ $PSEUDO ]] && found+=("$(printf '%b' "$t")")   # -r writes bytes as \xHH
    done <<< "$out"
  else
    printf '?findmnt: %s\n' "${out##*$'\n'}"
  fi
  if [ "$(stat -f -c %T /)" = btrfs ]; then
    # subvolume paths are relative to the filesystem's top; / may be a subvolume of it (FSROOT)
    if ! fsroot="$(findmnt -no FSROOT / 2>&1)" || [[ $fsroot != /* ]]; then
      printf '?findmnt FSROOT of /: %s\n' "${fsroot##*$'\n'}"
      fsroot=""; out=""
    elif ! out="$(btrfs subvolume list -o / 2>&1)"; then
      printf '?btrfs subvolume list: %s\n' "${out##*$'\n'}"
      out=""
    fi
    fsroot="${fsroot%/}"
    if [ -n "$out" ]; then
      while IFS= read -r t; do
        [ -n "$t" ] || continue
        if [[ $t =~ ^ID\ [0-9]+\ gen\ [0-9]+\ top\ level\ [0-9]+\ path\ (.+)$ ]]; then
          m="/${BASH_REMATCH[1]}"                    # the whole path, spaces and all
          [ -n "$fsroot" ] && [[ $m == "$fsroot"/* ]] && m="${m#"$fsroot"}"
          found+=("$m")
        else
          printf '?btrfs subvolume list: a line it can'"'"'t read: %s\n' "${t:0:80}"
        fi
      done <<< "$out"
    fi
  fi
  snapdir="$(cfg snapshot.dir)"
  for m in "${found[@]}"; do
    { [ "$m" = "$snapdir" ] || [[ $m == "$snapdir"/* ]]; } && continue
    for p in "$@"; do [ "$m" = "$p" ] && continue 2; done      # listed itself: backed up on its own
    for p in "$@"; do
      [[ $m == "${p%/}"/* ]] && { printf '%s\n' "$m"; break; }
    done
  done | sort -u
}

# excluded PATH — backup.exclude names it or a folder above it: left out on purpose
excluded() {
  local e
  for e in "${EXCLUDE[@]}"; do [ "$1" = "$e" ] || [[ $1 == "${e%/}"/* ]] && return 0; done
  return 1
}

# boundary PATH — PATH is in some mount other than / itself (it is one, or lies inside one, bind
# mounts of the root filesystem included), or on another device (a subvolume). The snapshot of /
# holds what is below such a mount, not what is mounted there. If findmnt can't say, it counts as
# one: reading live is the safe side.
boundary() {
  local m
  m="$(findmnt -n -o TARGET -T "$1" 2>/dev/null)" || return 0
  [ "$m" != / ] || [ "$(stat -c %d "$1")" != "$rootdev" ]
}

# backup_paths [restic flags] — restic sees the snapshot's files at their real paths:
# in a private mount namespace, every path on the root filesystem gets the
# snapshot's copy bind-mounted over it. Paths on other filesystems are read live.
backup_paths() {
  local p rootdev have=() binds=() args=(backup --host "$HOST" --tag hb --one-file-system --exclude-caches)
  rootdev="$(stat -c %d /)"
  for p in "${IF_PRESENT[@]}"; do args+=(--exclude-if-present "$p"); done
  for p in "${EXCLUDE[@]}"; do args+=(--exclude "$p"); done
  local cov=() c line
  for p in "${PATHS[@]}"; do
    [ -e "$p" ] || { log "skipping $p: it doesn't exist"; cov+=("missing $p"); continue; }
    have+=("$p")
  done
  for p in "${have[@]}"; do
    # The snapshot's copy goes over p only when p is a plain folder of the root filesystem and no
    # listed path below it is a mount or another subvolume: the copy would hide that, and restic
    # would read the empty folder it was mounted on.
    local hides=""
    for c in "${have[@]}"; do
      [ "$c" != "$p" ] && [[ $c == "${p%/}"/* ]] && boundary "$c" && hides="$c"
    done
    if [ -n "$SNAP" ] && [ -z "$hides" ] && ! boundary "$p" && [ -d "$SNAP$p" ]; then
      binds+=("$p"); cov+=("snapshot $p")
    else
      cov+=("live $p")
    fi
  done
  while IFS= read -r line; do
    case "$line" in
      "?"*) log "can't tell what is left out: ${line#?}"; cov+=("unknown ${line#?}") ;;
      *) if excluded "$line"; then cov+=("excluded $line")
         else log "not in the backup: $line (a mount or subvolume below backup.paths)"; cov+=("left-out $line"); fi ;;
    esac
  done < <(boundaries "${have[@]}")
  [ "${COVERAGE:-}" ] && printf '%s\n' "${cov[@]}" > "$COVERAGE"
  [ ${#have[@]} -gt 0 ] || die "none of backup.paths exist"
  unshare --mount --propagation private -- bash -c '
    snap="$1"; shift
    while [ "$1" != -- ]; do mount --bind "$snap$1" "$1" || exit 1; shift; done; shift
    exec "$@"' _ "$SNAP" "${binds[@]}" -- restic --cache-dir "$CACHE" "${args[@]}" "$@" "${have[@]}"
}

cmd_run() {
  local dry="${1:-0}" rc start
  need_repo; need_init; take_lock
  [ ${#PATHS[@]} -gt 0 ] || die "backup.paths is empty"
  start="$(date +%s)"
  dump_state
  take_snapshot
  trap drop_snapshot EXIT
  if [ "$dry" = 1 ]; then
    backup_paths --dry-run
    return
  fi
  COVERAGE="$STATUS/last-coverage" backup_paths 2>&1 | tee "$STATUS/last-run.log"
  rc=${PIPESTATUS[0]}
  echo "$start $(date +%s) $rc" > "$STATUS/last-run"
  # 3: the snapshot was made, but some files couldn't be read (listed in the log)
  if [ "$rc" -eq 0 ] || [ "$rc" -eq 3 ]; then
    date +%s > "$STATUS/last-ok"
    r forget --host "$HOST" --tag hb "${KEEP[@]}" | tail -n 3
  fi
  return "$rc"
}

cmd_maintain() {
  local check=(check)
  need_repo; need_init; take_lock
  r forget --host "$HOST" --tag hb "${KEEP[@]}" --prune || return 1
  [ "$(date +%-d)" -le 7 ] && check+=(--read-data-subset "$(cfg backup.read_data_percent)%")
  if r "${check[@]}"; then
    date +%s > "$STATUS/last-check"
  else
    echo "failed $(date +%s)" > "$STATUS/last-check"
    return 1
  fi
}

cmd_init() {
  need_repo
  [ -f "$REPO/config" ] && die "a repository already exists at $REPO"
  if [ ! -s "$PWFILE" ]; then
    install -d -m 700 "$(dirname "$PWFILE")"
    head -c 20 /dev/urandom | base32 | fold -w4 | paste -sd- > "$PWFILE"
    chmod 600 "$PWFILE"
  fi
  r init || return 1
  printf '\nThe repository password is in %s:\n\n    %s\n\n' "$PWFILE" "$(cat "$PWFILE")"
  echo "Write it down and keep it away from this box. Without it the backup can't be read."
}

hours_since() { echo $(( ($(date +%s) - $1) / 3600 )); }

cmd_check() {
  [ -n "$REPO" ] || { echo "ok: not configured"; return 0; }
  local ok last rc warn fail h chk
  warn="$(cfg backup.warn_hours)"; fail="$(cfg backup.fail_hours)"
  ok="$(cat "$STATUS/last-ok" 2>/dev/null)"
  [ -n "$ok" ] || { echo "warn: no backup yet (hb backup init, then hb backup run)"; return 1; }
  h="$(hours_since "$ok")"
  [ "$h" -ge "$fail" ] && { echo "fail: last good backup $h h ago"; return 2; }
  [ "$h" -ge "$warn" ] && { echo "warn: last good backup $h h ago"; return 1; }
  read -r _ _ rc 2>/dev/null < "$STATUS/last-run"
  [ "${rc:-0}" -eq 3 ] && { echo "warn: last backup $h h ago skipped unreadable files (see $STATUS/last-run.log)"; return 1; }
  local missing left
  missing="$(grep -c '^missing ' "$STATUS/last-coverage" 2>/dev/null)"
  left="$(grep -c '^left-out ' "$STATUS/last-coverage" 2>/dev/null)"
  [ "${missing:-0}" -gt 0 ] && { echo "warn: last backup $h h ago; $missing of backup.paths don't exist (hb backup status)"; return 1; }
  grep -q '^unknown ' "$STATUS/last-coverage" 2>/dev/null \
    && { echo "warn: last backup $h h ago; couldn't tell what it left out (hb backup status)"; return 1; }
  [ "${left:-0}" -gt 0 ] && { echo "warn: last backup $h h ago left out $left mounts or subvolumes below backup.paths (hb backup status)"; return 1; }
  chk="$(cat "$STATUS/last-check" 2>/dev/null)"
  case "$chk" in
    failed*) echo "warn: last backup $h h ago, but the repository check failed (hb backup maintain)"; return 1 ;;
    "") ;;
    *) [ "$(hours_since "$chk")" -gt 192 ] && { echo "warn: last backup $h h ago; repository not checked for 8 days"; return 1; } ;;
  esac
  echo "ok: last backup $h h ago"
}

cmd_status() {
  local start end rc
  if read -r start end rc 2>/dev/null < "$STATUS/last-run"; then
    echo "last run:   $(date -d "@$start" '+%F %H:%M'), $(( (end - start) / 60 )) min, exit $rc"
    grep -E '^(Added to the repository|processed|snapshot .* saved)' "$STATUS/last-run.log" | sed 's/^/            /'
  else
    echo "last run:   never"
  fi
  if [ -s "$STATUS/last-coverage" ]; then
    echo "covered:"
    awk '{k = $1; sub(/^[^ ]+ /, ""); n[k] = n[k] (n[k] ? ", " : "") $0}
         END {split("snapshot live missing unknown left-out excluded", o, " ")
              t["unknown"] = "COULDN'"'"'T CHECK"
              t["snapshot"] = "from the snapshot"; t["live"] = "read live"; t["missing"] = "MISSING"
              t["left-out"] = "LEFT OUT (mounts, subvolumes)"; t["excluded"] = "left out, in backup.exclude"
              for (i = 1; i <= 6; i++) if (o[i] in n) printf "            %-30s %s\n", t[o[i]] ":", n[o[i]]}' "$STATUS/last-coverage"
  fi
  local a b
  if read -r a b 2>/dev/null < "$STATUS/last-check"; then
    if [ "$a" = failed ]; then echo "last check: FAILED $(date -d "@$b" '+%F %H:%M')"
    else echo "last check: $(date -d "@$a" '+%F %H:%M')"; fi
  fi
  need_repo; need_init
  echo; r snapshots --compact --latest 5
}

case "${1:-check}" in
  init) cmd_init ;;
  run) cmd_run 0 ;;
  dry-run) cmd_run 1 ;;
  maintain) cmd_maintain ;;
  check) cmd_check ;;
  status) cmd_status ;;
  restic) shift; need_repo; exec restic --cache-dir "$CACHE" "$@" ;;
  help|-h|--help) sed -n '2,/^$/s/^# \{0,1\}//p' "$0" ;;
  *) die "unknown verb '$1' (init, run, dry-run, maintain, status, check, restic)" ;;
esac
