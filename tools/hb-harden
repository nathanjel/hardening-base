#!/usr/bin/env bash
# hb-harden — host settings that close doors: unwanted accounts, stray files
# (root's keys, cloud-init sudo rules), personal admin accounts whose sudo takes
# their code, root login and X11 forwarding over SSH, NOPASSWD audit, kernel
# settings (sysctl), systemd-resolved's LLMNR responder and how much the journal keeps.
#
# admins: each login in harden.admins exists (made with no password), is in
# harden.admin_group and harden.admin_groups, and out of harden.admin_not_in (groups
# that give root without sudo, such as docker or microk8s); the group has no other
# members. /etc/sudoers.d/10-hb-admins lets the group run anything with sudo, and
# /etc/pam.d/sudo asks its members for their code (hb totp) instead of a password; a
# wrong code fails at once. After a code, sudo stays open harden.admin_sudo_minutes
# minutes since the last sudo: for all of the member's sessions with
# admin_sudo_shared (so agents on a shared SSH connection ride on it), else in that
# terminal only. sudo -K closes it. Everyone else's sudo, and NOPASSWD rules, are as
# before. Members need hb totp enrol before they can sudo; hb totp refuses every
# answer for 15 minutes after 5 wrong ones. The code gate goes in before the rule (a
# member can never sudo with a password), and the rule is put back if the whole set
# then fails visudo. Refused, before any change: a code checker someone other than
# root could change (apply with the installed hb, not from a checkout), another auth
# line before the gate, a primary group hb can't take away, and Defaults or rules in
# other files that change what hb's say (checked with sudo -l -U). Accounts are never
# deleted here (harden.remove_accounts does that).
# nopasswd: every line that skips the password (NOPASSWD, or !authenticate) is in a
# file listed for removal or written in harden.nopasswd_allowed, in the one form hb can
# read (programs by full path), and only root can change what it runs.
#
#   hb harden status        one line per item
#   hb harden plan          what apply would change (changes nothing)
#   hb harden apply [--yes] make the changes, asking before each item
#   hb harden check         one-line verdict (exit 0 ok, 1 pending, 2 broken)
#
# Config ([harden] in hb.toml): remove_accounts, remove_files, admins, admin_group,
# admin_sudo_minutes, admin_sudo_shared, admin_groups, admin_not_in, admin_shell,
# permit_root_login, x11_forwarding, nopasswd_allowed, sysctl ("key = value" lines;
# * stands for any one name, such as an interface), llmnr, journal_max_use.
# Every file or folder it changes or removes is copied to /var/lib/hb/backup/<run>/
# first; a deleted account's home is kept there as a tarball.
set -u
source "$(dirname "$(readlink -f "$0")")/../lib/hb.sh"
need_root
need_config

ITEMS=(files accounts admins root_login x11 nopasswd sysctl llmnr journal)
SSHD_DROPIN="${HB_SSHD_DIR:-/etc/ssh/sshd_config.d}/10-hb-harden.conf"
SYSCTL_FILE=/etc/sysctl.d/90-hb.conf
RESOLVED_DROPIN=/etc/systemd/resolved.conf.d/90-hb.conf
JOURNALD_DROPIN="${HB_JOURNALD_DIR:-/etc/systemd/journald.conf.d}/90-hb.conf"
JOURNALD_REMOVED="$HB_STATE/harden/journald-settings-removed"   # touched when files removes journald's settings

mapfile -t REMOVE_FILES < <(cfg harden.remove_files)
mapfile -t REMOVE_ACCOUNTS < <(cfg harden.remove_accounts)
ROOT_LOGIN="$(cfg harden.permit_root_login)"
X11="$(cfg harden.x11_forwarding)"
JOURNAL_MAX="$(cfg harden.journal_max_use)"
mapfile -t SYSCTL < <(cfg harden.sysctl)
LLMNR="$(cfg harden.llmnr)"
SUDOERS="${HB_SUDOERS:-/etc/sudoers}"
SUDOERS_DIR="${HB_SUDOERS_DIR:-/etc/sudoers.d}"
mapfile -t NOPASSWD_ALLOWED < <(cfg harden.nopasswd_allowed)
ROOT_ONLY_TOP="${HB_ROOT_ONLY_TOP:-/}"      # tests: where sudocheck's walk starts judging
mapfile -t ADMINS < <(cfg harden.admins)
ADMIN_GROUP="$(cfg harden.admin_group)"
ADMIN_MINUTES="$(cfg harden.admin_sudo_minutes)"
ADMIN_SHARED="$(cfg harden.admin_sudo_shared)"
mapfile -t ADMIN_GROUPS < <(cfg harden.admin_groups)
mapfile -t ADMIN_NOT_IN < <(cfg harden.admin_not_in)
ADMIN_SHELL="$(cfg harden.admin_shell)"
BREAKGLASS_USER="$(cfg breakglass.user)"
ADMIN_RULE="$SUDOERS_DIR/10-hb-admins"
HOME_BASE="${HB_HOME_BASE:-$(useradd -D 2>/dev/null | sed -n 's/^HOME=//p')}"; HOME_BASE="${HOME_BASE:-/home}"
PAM_SUDO="${HB_PAM_SUDO:-/etc/pam.d/sudo}"
PAM_SUDO_I="${HB_PAM_SUDO_I:-${PAM_SUDO%/*}/sudo-i}"     # what sudo -i asks with, whatever Defaults say
TOTP="${HB_TOTP:-$HB_ROOT/tools/hb-totp}"
SUDOPAM=(python3 -IB "${HB_SUDOPAM:-$HB_ROOT/lib/hbkit/sudopam.py}")   # tests: a stand-in that fails
SUDOCHECK=(python3 -IB "$HB_ROOT/lib/hbkit/sudocheck.py")
NAME_RE='^[a-z_][a-z0-9_-]{0,31}$'

# --- files: files and folders that must not exist -------------------------------
# Folders go too, with what's in them; a symlink is removed, never what it points to.
# Paths must be absolute, already normalised and at least two levels deep: never /,
# /etc or a relative a/b.
exists() { [ -e "$1" ] || [ -L "$1" ]; }
safe_path() { [[ $1 == /?*/?* ]] && [ "$(realpath -ms -- "$1")" = "$1" ]; }
chk_files() {
  local f present=()
  for f in "${REMOVE_FILES[@]}"; do
    safe_path "$f" || { echo "harden.remove_files: $f is not a normalised path two levels deep"; return 2; }
    exists "$f" || continue
    if [ -d "$f" ] && [ ! -L "$f" ]; then present+=("$f ($(du -sh "$f" 2>/dev/null | cut -f1))")
    else present+=("$f"); fi
  done
  [ ${#present[@]} -eq 0 ] && { echo "none of ${#REMOVE_FILES[@]} listed paths present"; return 0; }
  echo "will move away: ${present[*]}"; return 1
}
fix_files() {
  local f sudoers=0 journald
  for f in "${REMOVE_FILES[@]}"; do
    exists "$f" || continue
    safe_path "$f" || return 1
    # journald's settings (a drop-in, or a folder of them): the journal item then sees a change
    journald=0
    { [[ $f == *journald* ]] || { [ -d "$f" ] && [ -n "$(find "$f" -name '*journald*' -print -quit 2>/dev/null)" ]; }; } && journald=1
    keep_copy "$f" && rm -rf --one-file-system -- "$f" || return 1
    [ $journald = 1 ] && { mkdir -p "${JOURNALD_REMOVED%/*}" && touch "$JOURNALD_REMOVED"; }
    [[ $f == /etc/sudoers* ]] && sudoers=1
  done
  if [ $sudoers = 1 ] && ! visudo -cq; then
    log "visudo reports an error after the change; restore from $HB_STATE/backup/$HB_RUN"
    return 1
  fi
}

# --- accounts: login accounts that must not exist -------------------------------
chk_accounts() {
  local u home present=()
  for u in "${REMOVE_ACCOUNTS[@]}"; do
    getent passwd "$u" >/dev/null || continue
    home="$(getent passwd "$u" | cut -d: -f6)"
    present+=("$u ($home, $(du -sh "$home" 2>/dev/null | cut -f1))")
  done
  [ ${#present[@]} -eq 0 ] && { echo "none of ${#REMOVE_ACCOUNTS[@]} listed accounts exist"; return 0; }
  echo "will delete: ${present[*]}"; return 1
}
# host_procs USER — the user's processes that share the host's root directory.
# Containers running under the same numeric uid have their own root and don't
# count; userdel skips them the same way.
host_procs() {
  local pid root
  root="$(stat -c %d:%i /)"
  for pid in $(pgrep -u "$1"); do
    [ "$(stat -L -c %d:%i "/proc/$pid/root" 2>/dev/null)" = "$root" ] && echo "$pid"
  done
}
fix_accounts() {
  local u home procs failed=0 d="$HB_STATE/backup/$HB_RUN"
  for u in "${REMOVE_ACCOUNTS[@]}"; do
    getent passwd "$u" >/dev/null || continue
    procs="$(host_procs "$u" | tr '\n' ' ')"
    if [ -n "$procs" ]; then log "  $u still has processes on the host (pids $procs); not deleting"; failed=1; continue; fi
    home="$(getent passwd "$u" | cut -d: -f6)"
    mkdir -p "$d"
    [ -d "$home" ] && tar -C / -czf "$d/home-$u.tar.gz" "${home#/}"
    userdel -r "$u" 2>&1 | grep -v 'mail spool' >&2
    if getent passwd "$u" >/dev/null; then log "  userdel failed for $u"; failed=1; continue; fi
    log "  deleted $u; home kept in $d/home-$u.tar.gz"
  done
  return $failed
}

# --- root_login and x11: sshd's PermitRootLogin and X11Forwarding -----------------
# Both live in one drop-in, written whole from the config by either item.
sshd_text() {
  printf '# Managed by hb-harden. Files here are read in name order and the first\n# value wins, so this one sorts before the distribution defaults.\n'
  [ -n "$ROOT_LOGIN" ] && printf 'PermitRootLogin %s\n' "$ROOT_LOGIN"
  [ -n "$X11" ] && printf 'X11Forwarding %s\n' "$X11"
  return 0
}
sshd_has() { sshd -T 2>/dev/null | awk -v k="$1" '$1 == k {print $2}'; }
write_sshd_dropin() {
  local before had=0
  [ -e "$SSHD_DROPIN" ] && { had=1; before="$(cat "$SSHD_DROPIN")"; }
  keep_copy "$SSHD_DROPIN"
  sshd_text > "$SSHD_DROPIN" && chmod 600 "$SSHD_DROPIN" || return 1
  if ! sshd -t; then
    log "sshd -t rejected the config; putting $SSHD_DROPIN back as it was"
    if [ $had = 1 ]; then printf '%s\n' "$before" > "$SSHD_DROPIN"; else rm -f "$SSHD_DROPIN"; fi
    return 1
  fi
  systemctl reload sshd
}

chk_root_login() {
  [ -z "$ROOT_LOGIN" ] && { echo "not managed"; return 0; }
  local have
  have="$(sshd_has permitrootlogin)"
  [ "$have" = "$ROOT_LOGIN" ] && { echo "PermitRootLogin $have"; return 0; }
  echo "PermitRootLogin $have → $ROOT_LOGIN (via $SSHD_DROPIN)"; return 1
}
fix_root_login() { write_sshd_dropin; }

chk_x11() {
  [ -z "$X11" ] && { echo "not managed"; return 0; }
  case "$X11" in yes|no) ;; *) echo "harden.x11_forwarding must be yes or no"; return 2 ;; esac
  local have; have="$(sshd_has x11forwarding)"
  [ "$have" = "$X11" ] && { echo "X11Forwarding $have"; return 0; }
  echo "X11Forwarding $have → $X11 (via $SSHD_DROPIN)"; return 1
}
fix_x11() { write_sshd_dropin; }

# --- admins: personal admin accounts, sudo by their code ------------------------
in_group() { id -nG "$1" 2>/dev/null | tr ' ' '\n' | grep -qxF -- "$2"; }
# members GROUP — its members, those whose primary group it is included (getent group lists only
# the others)
members() {
  local line gid
  line="$(getent group "$1" 2>/dev/null)" || return 0
  gid="$(cut -d: -f3 <<< "$line")"
  { cut -d: -f4 <<< "$line" | tr ',' '\n'; getent passwd | awk -F: -v g="$gid" '$4 == g {print $1}'; } | grep -v '^$' | sort -u
}
primary_group() { getent group "$(getent passwd "$1" | cut -d: -f4)" 2>/dev/null | cut -d: -f1; }
# Defaults that change how long sudo stays open, whether it asks, whose password it asks for, or
# which PAM stack asks (sudoers(5)): set anywhere but hb's own rule, they could undo the gate
RISKY_DEFAULTS='timestamp_timeout|timestamp_type|tty_tickets|timestampowner|timestampdir|authenticate|exempt_group|rootpw|targetpw|runaspw|pam_service|pam_login_service|pam_askpass_service'
# risky_defaults — Defaults lines outside hb's rule that set one of them, as FILE:LINE:TEXT (files
# sudo reads: names without a dot or a trailing ~)
risky_defaults() {
  local f
  for f in "$SUDOERS" "$SUDOERS_DIR"/*; do
    [ -f "$f" ] && [ "$f" != "$ADMIN_RULE" ] || continue
    case "${f##*/}" in *.*|*~) [ "$f" = "$SUDOERS" ] || continue ;; esac
    grep -HnE "^[[:space:]]*Defaults[^#]*\b($RISKY_DEFAULTS)\b" "$f"
  done
}
# risky_grants — lines outside hb's rule that name the admins' group or one of admin_groups (as
# %GROUP or %:GROUP): an admin joining it would bring those rules too, NOPASSWD ones included
# ... and lines naming an admin's login (or #UID), or the own group useradd makes for it: making
# or keeping the account would bring those rules. Groups by name and by number (%#GID).
risky_grants() {
  local f g u id tokens=()
  for g in "$ADMIN_GROUP" "${ADMIN_GROUPS[@]}"; do
    tokens+=("%:?$g")
    id="$(getent group "$g" | cut -d: -f3)" && [ -n "$id" ] && tokens+=("%:?#$id")
  done
  for u in "${ADMINS[@]}"; do
    tokens+=("$u" "%:?$u")
    id="$(getent passwd "$u" | cut -d: -f3)" && [ -n "$id" ] && tokens+=("#$id")
  done
  local any; any="$(IFS='|'; echo "${tokens[*]}")"
  for f in "$SUDOERS" "$SUDOERS_DIR"/*; do
    [ -f "$f" ] && [ "$f" != "$ADMIN_RULE" ] || continue
    case "${f##*/}" in *.*|*~) [ "$f" = "$SUDOERS" ] || continue ;; esac
    grep -HnE "^[^#]*(^|[^A-Za-z0-9_.#%:-])($any)([^A-Za-z0-9_.-]|\$)" "$f"
  done
}
# effective_problems USER — what sudo itself says applies to USER (sudo -l -U: the user's Defaults,
# then the Runas and command-specific ones, then the commands) against hb's rule
effective_problems() {
  local u="$1" out defs cmds v want_type=global
  [ "$ADMIN_SHARED" = true ] || want_type=tty
  # in C: the parser reads sudo's English headings, which other locales translate
  out="$(LC_ALL=C sudo -l -U "$u" 2>&1)" || { echo "sudo -l -U $u fails: $(head -1 <<< "$out")"; return; }
  defs="$(sed '/may run the following commands/,$d' <<< "$out" | tr '\n' ' ')"
  cmds="$(sed -n '/may run the following commands/,$p' <<< "$out")"
  grep -qE 'timestamp_timeout=' <<< "$defs" || echo "sudo -l -U $u: no timestamp_timeout (hb's rule doesn't apply)"
  for v in $(grep -oE 'timestamp_timeout=-?[0-9.]+' <<< "$defs" | cut -d= -f2); do
    awk -v a="$v" -v b="$ADMIN_MINUTES" 'BEGIN { exit !(a + 0 == b + 0) }' || echo "sudo -l -U $u: timestamp_timeout=$v, not $ADMIN_MINUTES"
  done
  for v in $(grep -oE 'timestamp_type=[a-z]+' <<< "$defs" | cut -d= -f2); do
    [ "$v" = "$want_type" ] || echo "sudo -l -U $u: timestamp_type=$v, not $want_type"
  done
  grep -qE '(^|[ ,])!authenticate' <<< "$defs" && echo "sudo -l -U $u: !authenticate (sudo asks for nothing)"
  grep -qE '(^|[ ,])!?tty_tickets' <<< "$defs" && echo "sudo -l -U $u: tty_tickets set (it changes timestamp_type)"
  for v in $(grep -oE 'timestamp(owner|dir)=[^ ,]+' <<< "$defs"); do
    echo "sudo -l -U $u: $v (whoever owns the records could write an unlock)"
  done
  for v in $(grep -oE '(^|[ ,])(rootpw|targetpw|runaspw)\b' <<< "$defs" | tr -d ' ,'); do
    echo "sudo -l -U $u: $v (sudo would ask for another account's password, past hb's gate)"
  done
  for v in $(grep -oE 'pam_(login_|askpass_)?service=[^ ,]+' <<< "$defs"); do
    echo "sudo -l -U $u: $v (another PAM stack, past hb's gate)"
  done
  for v in $(grep -oE 'exempt_group=[^ ,]+' <<< "$defs" | cut -d= -f2 | tr -d '"%'); do
    in_group "$u" "$v" && echo "sudo -l -U $u: exempt_group=$v (sudo asks its members nothing)"
  done
  grep -qE 'NOPASSWD|!authenticate' <<< "$cmds" && echo "sudo -l -U $u: a rule lets them in without the code: $(grep -m1 -E 'NOPASSWD|!authenticate' <<< "$cmds" | sed 's/^ *//')"
  grep -qE '\(ALL( : ALL)?\) ALL' <<< "$cmds" || echo "sudo -l -U $u: hb's rule doesn't apply to them"
  return 0
}
listed() { local x="$1" y; shift; for y in "$@"; do [ "$x" = "$y" ] && return 0; done; return 1; }
admin_rule_text() {
  local scope=global who="for all of their sessions" when
  [ "$ADMIN_SHARED" = true ] || { scope=tty; who="in the terminal it was typed in"; }
  if [ "$ADMIN_MINUTES" = 0 ]; then when="sudo asks for one every time"
  else when="sudo asks again once $ADMIN_MINUTES minutes pass without a sudo, $who (sudo -K: at once)"; fi
  printf '%s\n' "# Managed by hb harden (harden.admins); changes made here are overwritten." \
    "# Members of $ADMIN_GROUP answer sudo with their code (hb totp, through $PAM_SUDO). After one," \
    "# $when." \
    "Defaults:%$ADMIN_GROUP timestamp_type=$scope, timestamp_timeout=$ADMIN_MINUTES, passprompt=\"[sudo] code for %p: \"" \
    "%$ADMIN_GROUP ALL=(ALL) ALL"
}
chk_admins() {
  [ ${#ADMINS[@]} -eq 0 ] && { echo "not managed"; return 0; }
  local u g x todo=() waiting=() pam prc out
  [[ $ADMIN_GROUP =~ $NAME_RE ]] || { echo "harden.admin_group: '$ADMIN_GROUP' isn't a group name"; return 2; }
  [[ $ADMIN_MINUTES =~ ^[0-9]+$ ]] || { echo "harden.admin_sudo_minutes must be a whole number"; return 2; }
  case "$ADMIN_SHARED" in true|false) ;; *) echo "harden.admin_sudo_shared must be true or false"; return 2 ;; esac
  [ -x "$ADMIN_SHELL" ] || { echo "harden.admin_shell: $ADMIN_SHELL isn't a program here"; return 2; }
  for u in "${ADMINS[@]}"; do
    [[ $u =~ $NAME_RE ]] || { echo "harden.admins: '$u' isn't a login name"; return 2; }
    [ "$u" = root ] && { echo "harden.admins: root can't be one"; return 2; }
    [ -n "$BREAKGLASS_USER" ] && [ "$u" = "$BREAKGLASS_USER" ] && {
      echo "harden.admins: $u is the break-glass account, whose sudo takes its kit's password"; return 2; }
  done
  for g in "${ADMIN_GROUPS[@]}"; do
    getent group "$g" >/dev/null || { echo "harden.admin_groups: there's no group $g here"; return 2; }
    listed "$g" "${ADMIN_NOT_IN[@]}" && { echo "$g is in both harden.admin_groups and harden.admin_not_in"; return 2; }
  done
  listed "$ADMIN_GROUP" "${ADMIN_NOT_IN[@]}" && { echo "harden.admin_not_in names $ADMIN_GROUP itself"; return 2; }
  # the code checker runs as root from sudo's PAM file: only root may be able to change it
  if ! out="$("${SUDOCHECK[@]}" root-only --top "$ROOT_ONLY_TOP" "$TOTP")"; then
    echo "the code checker $TOTP can be changed by others ($(tr '\n' ';' <<< "$out" | sed 's/;$//; s/;/; /g')): apply with the installed hb (sudo hb harden apply), not from a checkout"
    return 2
  fi
  for u in "${ADMINS[@]}"; do
    if ! getent passwd "$u" >/dev/null; then
      # useradd -m would adopt it, files of whoever had that uid included, and a rollback remove it
      [ -e "$HOME_BASE/$u" ] && { echo "$HOME_BASE/$u exists, but there's no account $u: move it away first (hb won't adopt or remove it)"; return 2; }
      continue
    fi
    g="$(primary_group "$u")"
    listed "$g" "${ADMIN_NOT_IN[@]}" && { echo "$u's primary group is $g (root without sudo); hb doesn't change primary groups: usermod -g by hand"; return 2; }
  done
  for x in $(members "$ADMIN_GROUP"); do
    listed "$x" "${ADMINS[@]}" || [ "$(primary_group "$x")" != "$ADMIN_GROUP" ] \
      || { echo "$x has $ADMIN_GROUP as their primary group but isn't in harden.admins; hb can't take them out: usermod -g by hand"; return 2; }
  done
  out="$(risky_defaults)"
  if [ -n "$out" ]; then
    echo "sudo settings outside hb's rule could undo its gate (how long it stays open, whether or how it asks): $(head -3 <<< "$out" | tr '\n' ';' | sed 's/;$//; s/;/; /g')"
    return 2
  fi
  out="$(risky_grants)"
  if [ -n "$out" ]; then
    echo "sudo rules outside hb's name an admin, their own group or a group they would be in, and would apply to them: $(head -3 <<< "$out" | tr '\n' ';' | sed 's/;$//; s/;/; /g')"
    return 2
  fi
  pam="$("${SUDOPAM[@]}" check "$PAM_SUDO" "$ADMIN_GROUP" "$TOTP")"; prc=$?
  [ $prc -ge 2 ] && { echo "$pam"; return 2; }
  out="$("${SUDOPAM[@]}" check-login "$PAM_SUDO_I")" || { echo "$out"; return 2; }
  getent group "$ADMIN_GROUP" >/dev/null || todo+=("group $ADMIN_GROUP")
  for u in "${ADMINS[@]}"; do
    getent passwd "$u" >/dev/null || { todo+=("create $u"); continue; }
    in_group "$u" "$ADMIN_GROUP" || todo+=("$u into $ADMIN_GROUP")
    for g in "${ADMIN_GROUPS[@]}"; do in_group "$u" "$g" || todo+=("$u into $g"); done
    for g in "${ADMIN_NOT_IN[@]}"; do in_group "$u" "$g" && todo+=("$u out of $g (root without sudo)"); done
  done
  for x in $(members "$ADMIN_GROUP"); do listed "$x" "${ADMINS[@]}" || todo+=("$x out of $ADMIN_GROUP (not in harden.admins)"); done
  [ "$(cat "$ADMIN_RULE" 2>/dev/null)" = "$(admin_rule_text)" ] || todo+=("the sudo rule ($ADMIN_RULE)")
  [ $prc -eq 1 ] && todo+=("sudo to ask $ADMIN_GROUP's members for their code ($PAM_SUDO)")
  if [ ${#todo[@]} -gt 0 ]; then out="$(printf '%s; ' "${todo[@]}")"; echo "${out%; }"; return 1; fi
  out="$(for u in "${ADMINS[@]}"; do effective_problems "$u"; done)"
  [ -n "$out" ] && { tr '\n' ';' <<< "$out" | sed 's/;$//; s/;/; /g'; echo; return 2; }
  for u in "${ADMINS[@]}"; do "$TOTP" ready "$u" >/dev/null 2>&1 || waiting+=("$u"); done
  if [ ${#waiting[@]} -gt 0 ]; then
    echo "${waiting[*]} can't sudo until enrolled in hb totp: sudo hb totp enrol ${waiting[0]}"; return 1
  fi
  out="${ADMINS[*]}: in $ADMIN_GROUP${ADMIN_GROUPS[*]:+ and ${ADMIN_GROUPS[*]}}"
  [ ${#ADMIN_NOT_IN[@]} -gt 0 ] && out+=", out of ${ADMIN_NOT_IN[*]}"
  if [ "$ADMIN_MINUTES" = 0 ]; then out+="; sudo takes their code every time"
  elif [ "$ADMIN_SHARED" = true ]; then out+="; sudo takes their code, then stays open $ADMIN_MINUTES idle minutes for all of their sessions"
  else out+="; sudo takes their code, then stays open $ADMIN_MINUTES idle minutes in that terminal"; fi
  echo "$out"
}
# undo_added — take back the memberships this apply added (ADDED, user:group), when a later step
# failed: a group joined can bring rules hb didn't write
undo_added() {
  local m
  for m in "${ADDED[@]}"; do gpasswd -d "${m%%:*}" "${m#*:}" >/dev/null 2>&1; done
  [ ${#ADDED[@]} -gt 0 ] && log "  took back the memberships this apply added: ${ADDED[*]}"
  # an account this apply made goes again: its name, uid or own group could be what a rule names
  for m in "${CREATED[@]}"; do
    if [ "${m#*:}" = 1 ]; then userdel "${m%%:*}" >/dev/null 2>&1 && log "  deleted ${m%%:*} again, made by this apply (its home stays: it was there before)"
    else userdel -r "${m%%:*}" >/dev/null 2>&1 && log "  deleted ${m%%:*} again, made by this apply"; fi
  done
  return 0
}
fix_admins() {
  local u g x
  ADDED=() CREATED=()
  getent group "$ADMIN_GROUP" >/dev/null || groupadd -r "$ADMIN_GROUP" || return 1
  for u in "${ADMINS[@]}"; do
    if ! getent passwd "$u" >/dev/null; then
      local had_home=0
      [ -e "$HOME_BASE/$u" ] && had_home=1
      if ! useradd -m -U -s "$ADMIN_SHELL" "$u"; then
        # useradd writes the account before the home: a failure can leave one behind
        getent passwd "$u" >/dev/null && CREATED+=("$u:$had_home")
        log "  useradd $u failed"; undo_added; return 1
      fi
      CREATED+=("$u:$had_home")
      log "  made $u: no password (sudo takes the code; the login, a key from ssh.keys)"
    fi
    for g in "$ADMIN_GROUP" "${ADMIN_GROUPS[@]}"; do
      in_group "$u" "$g" && continue
      usermod -aG "$g" "$u" || { undo_added; return 1; }
      ADDED+=("$u:$g")
    done
    for g in "${ADMIN_NOT_IN[@]}"; do in_group "$u" "$g" && { gpasswd -d "$u" "$g" >/dev/null || { undo_added; return 1; }; }; done
  done
  for x in $(members "$ADMIN_GROUP"); do
    listed "$x" "${ADMINS[@]}" || gpasswd -d "$x" "$ADMIN_GROUP" >/dev/null || { undo_added; return 1; }
  done
  gate_and_rule || { undo_added; return 1; }
  for u in "${ADMINS[@]}"; do
    "$TOTP" ready "$u" >/dev/null 2>&1 || log "  $u can't sudo until enrolled: sudo hb totp enrol $u"
  done
  return 0
}
gate_and_rule() {
  local u tmp
  # Never a group granted sudo whose members the gate doesn't ask for a code: the new rule is
  # checked first (nothing changed if visudo refuses it); a rule for another group is taken away
  # before the gate moves; the gate goes in before the new rule; and whatever fails after that
  # leaves no grant rather than one without its gate.
  local had=0 before="" old=""
  tmp=""
  if [ "$(cat "$ADMIN_RULE" 2>/dev/null)" != "$(admin_rule_text)" ]; then
    # written beside it under a name with a dot, which sudo's includedir skips
    tmp="$(mktemp "$SUDOERS_DIR/.hb-admins.XXXXXX")" || return 1
    { admin_rule_text > "$tmp" && chmod 440 "$tmp"; } || { rm -f "$tmp"; return 1; }
    if ! visudo -cqf "$tmp"; then log "  visudo rejects the rule; nothing changed"; rm -f "$tmp"; return 1; fi
    if [ -e "$ADMIN_RULE" ]; then
      had=1; before="$(cat "$ADMIN_RULE")"
      old="$(sed -nE 's/^%([^[:space:]]+)[[:space:]]+ALL=.*/\1/p' <<< "$before" | head -1)"
      if [ -n "$old" ] && [ "$old" != "$ADMIN_GROUP" ]; then
        keep_copy "$ADMIN_RULE"
        rm -f "$ADMIN_RULE" || { rm -f "$tmp"; return 1; }
        had=0
        log "  took $old's sudo away first: the code gate moves to $ADMIN_GROUP"
      fi
    fi
  fi
  if ! "${SUDOPAM[@]}" check "$PAM_SUDO" "$ADMIN_GROUP" "$TOTP" >/dev/null; then
    keep_copy "$PAM_SUDO"
    if ! "${SUDOPAM[@]}" write "$PAM_SUDO" "$ADMIN_GROUP" "$TOTP"; then
      log "  sudo's PAM file not changed, so neither is the rule"; [ -n "$tmp" ] && rm -f "$tmp"; return 1
    fi
  fi
  if [ -n "$tmp" ]; then
    keep_copy "$ADMIN_RULE"
    mv -f "$tmp" "$ADMIN_RULE" || { rm -f "$tmp"; return 1; }
  fi
  # what sudo now says applies, after every apply (a membership can change it with the rule as it
  # was); trouble undoes this run: the rule if it put one in, and (fix_admins) the memberships
  local why=""
  visudo -cq || why="visudo reports an error in the sudo rules with hb's"
  [ -z "$why" ] && why="$(for u in "${ADMINS[@]}"; do effective_problems "$u"; done | head -3 | tr '\n' ';' | sed 's/;$//; s/;/; /g')"
  if [ -n "$why" ]; then
    if [ -n "$tmp" ] && [ $had = 1 ]; then log "  $why: putting $ADMIN_RULE back as it was"; printf '%s\n' "$before" > "$ADMIN_RULE"
    elif [ -n "$tmp" ]; then log "  $why: taking $ADMIN_RULE out again"; rm -f "$ADMIN_RULE"
    else log "  $why"; fi
    return 1
  fi
  return 0
}

# --- nopasswd: sudo rules without a password -------------------------------------
# Any line that lets sudo skip the password (a NOPASSWD tag, a Defaults with !authenticate, or an
# exempt_group)
# passes only as written in harden.nopasswd_allowed (spaces don't count), only in the form
# lib/hbkit/sudocheck.py can read (USER HOST=(RUNAS) NOPASSWD: /full/path [args], ...: no
# aliases, ALL, other tags or wildcards), and only while root alone can change each program it
# runs, walked as written (links one hop at a time, ACLs refused).
squash() { tr -s ' \t' '  ' <<< "$1" | sed -E 's/^ //; s/ $//'; }
chk_nopasswd() {
  local f line n a ok hits=() allowed=0 bad=() out
  for f in "$SUDOERS" "$SUDOERS_DIR"/*; do
    [ -f "$f" ] || continue
    listed "$f" "${REMOVE_FILES[@]}" && continue
    while IFS= read -r line; do
      n="$(squash "$line")"; ok=0
      for a in "${NOPASSWD_ALLOWED[@]}"; do [ "$n" = "$(squash "$a")" ] && ok=1; done
      if [ $ok = 0 ]; then hits+=("$f: $n"); continue; fi
      allowed=$((allowed + 1))
      out="$("${SUDOCHECK[@]}" allowed --top "$ROOT_ONLY_TOP" "$n")" || bad+=("$(tr '\n' ';' <<< "$out" | sed 's/;$//; s/;/; /g')")
    done < <(grep -E '^[^#]*(NOPASSWD|!\s*authenticate|exempt_group)' "$f")
  done
  [ ${#bad[@]} -gt 0 ] && { out="$(printf '%s; ' "${bad[@]}")"; echo "${out%; }"; return 2; }
  if [ ${#hits[@]} -eq 0 ]; then
    echo "no NOPASSWD rules beyond files listed for removal$([ $allowed -gt 0 ] && echo " and $allowed allowed in harden.nopasswd_allowed")"
    return 0
  fi
  out="$(printf '%s; ' "${hits[@]}")"
  echo "rules that skip the password: ${out%; }: review by hand"; return 2
}

# --- sysctl: kernel settings, live and in one file read at boot ------------------
# The file sorts after the distribution's, so its values win at boot. Applying
# writes only these keys: running `sysctl --system` would also re-apply every
# other file, undoing what Calico and kube-proxy set at runtime.
SYSCTL_RE='^([a-z0-9_.*-]+)[[:space:]]*=[[:space:]]*(.*[^[:space:]])[[:space:]]*$'

sysctl_text() {
  echo "# Managed by hb-harden from hb.toml (harden.sysctl)."
  local e
  for e in "${SYSCTL[@]}"; do
    [[ $e =~ $SYSCTL_RE ]] && echo "${BASH_REMATCH[1]} = ${BASH_REMATCH[2]}"
  done
}
# sysctl_paths KEY — its files under /proc/sys; * matches any one name
sysctl_paths() { compgen -G "/proc/sys/${1//.//}" || true; }

chk_sysctl() {
  [ ${#SYSCTL[@]} -eq 0 ] && { echo "not managed"; return 0; }
  local e key val p have paths off diffs=()
  for e in "${SYSCTL[@]}"; do
    [[ $e =~ $SYSCTL_RE ]] || { echo "harden.sysctl: '$e' is not 'key = value'"; return 2; }
    key="${BASH_REMATCH[1]}" val="${BASH_REMATCH[2]}"
    mapfile -t paths < <(sysctl_paths "$key")
    [ ${#paths[@]} -eq 0 ] && { echo "harden.sysctl: the kernel has no $key"; return 2; }
    off=0
    for p in "${paths[@]}"; do
      have="$(tr -s '\t ' '  ' < "$p" 2>/dev/null)"
      [ "$have" = "$val" ] || { off=$((off + 1)); [ ${#paths[@]} -eq 1 ] && diffs+=("$key $have→$val"); }
    done
    [ $off -gt 0 ] && [ ${#paths[@]} -gt 1 ] && diffs+=("$key ($off of ${#paths[@]} →$val)")
  done
  cmp -s "$SYSCTL_FILE" <(sysctl_text) || diffs+=("file $SYSCTL_FILE")
  [ ${#diffs[@]} -eq 0 ] && { echo "${#SYSCTL[@]} settings as configured"; return 0; }
  local joined; printf -v joined '%s, ' "${diffs[@]}"
  echo "${joined%, }"; return 1
}
fix_sysctl() {
  keep_copy "$SYSCTL_FILE"
  ( umask 022; sysctl_text > "$SYSCTL_FILE" ) || return 1
  local e key val p failed=0
  for e in "${SYSCTL[@]}"; do
    [[ $e =~ $SYSCTL_RE ]] || continue
    key="${BASH_REMATCH[1]}" val="${BASH_REMATCH[2]}"
    for p in $(sysctl_paths "$key"); do
      [ -e "$p" ] || continue   # an interface that went away meanwhile
      { printf '%s' "$val" > "$p"; } 2>/dev/null || { log "  cannot set ${p#/proc/sys/}"; failed=1; }
    done
  done
  return $failed
}

# --- llmnr: systemd-resolved's LLMNR responder (5355/tcp+udp) -------------------
llmnr_text() { printf '# Managed by hb-harden from hb.toml (harden.llmnr).\n[Resolve]\nLLMNR=%s\n' "$LLMNR"; }
chk_llmnr() {
  [ -z "$LLMNR" ] && { echo "not managed"; return 0; }
  case "$LLMNR" in yes|no|resolve) ;; *) echo "harden.llmnr must be yes, no or resolve"; return 2 ;; esac
  local listening dir="${RESOLVED_DROPIN%/*}"
  listening="$(ss -lnH 'sport = :5355' 2>/dev/null | wc -l)"
  if [ -d "$dir" ] && [ -z "$(find "$dir" -maxdepth 0 -perm -005)" ]; then
    echo "systemd-resolved can't read $dir (mode $(stat -c %a "$dir")), so it ignores LLMNR=$LLMNR"; return 1
  fi
  if cmp -s "$RESOLVED_DROPIN" <(llmnr_text); then
    [ "$LLMNR" = no ] && [ "$listening" -gt 0 ] && { echo "LLMNR=no is set, yet $listening sockets listen on 5355"; return 1; }
    echo "LLMNR=$LLMNR"; return 0
  fi
  echo "LLMNR=$LLMNR via $RESOLVED_DROPIN (now $listening sockets on 5355)"; return 1
}
fix_llmnr() {
  keep_copy "$RESOLVED_DROPIN"
  # systemd-resolved runs as its own user, and hb's umask is 077: set the mode.
  install -d -m 755 "${RESOLVED_DROPIN%/*}" && ( umask 022; llmnr_text > "$RESOLVED_DROPIN" ) || return 1
  log "  restarting systemd-resolved (name lookups on this host pause for a moment)"
  systemctl restart systemd-resolved
}

# --- journal: how much the journal keeps on disk (journald's SystemMaxUse) ---------
# journald reads its drop-ins in name order and the last value wins, so a drop-in that
# sorts after hb's and sets SystemMaxUse too overrules it: that one goes in remove_files.
journal_text() { printf '# Managed by hb-harden from hb.toml (harden.journal_max_use).\n[Journal]\nSystemMaxUse=%s\n' "$JOURNAL_MAX"; }
# every file journald reads that sets SystemMaxUse, in the order it reads them: "FILE VALUE"
journal_setters() {
  systemd-analyze cat-config systemd/journald.conf 2>/dev/null | awk '
    /^# \// {f = $2; next}
    /^[[:space:]]*SystemMaxUse[[:space:]]*=/ {v = $0; sub(/^[^=]*=[[:space:]]*/, "", v); sub(/[[:space:]]+$/, "", v); print f, v}'
}
# listed_for_removal FILE — FILE, or a folder it's in, is in harden.remove_files
listed_for_removal() { local r; for r in "${REMOVE_FILES[@]}"; do [[ $1 == "$r" || $1 == "$r"/* ]] && return 0; done; return 1; }
# the latest change (ns since the epoch, ctime, which no one can set back) to what journald reads
# its settings from: every file it reads; the drop-in folders, whose time changes when a file is
# added to or removed from them; their parents, for a whole folder removed (not /run/systemd,
# which changes all the time); and hb's mark for settings its files item removed
journal_changed_ns() {
  local f paths=("${JOURNALD_DROPIN%/*}" /etc/systemd/journald.conf.d /run/systemd/journald.conf.d
                 /usr/local/lib/systemd/journald.conf.d /usr/lib/systemd/journald.conf.d
                 /etc/systemd /usr/local/lib/systemd /usr/lib/systemd "$JOURNALD_REMOVED")
  while read -r f; do paths+=("$f"); done < <(systemd-analyze cat-config systemd/journald.conf 2>/dev/null | awk '/^# \// {print $2}')
  stat -c %.9Z "${paths[@]}" 2>/dev/null | tr -d . | sort -n | tail -1
}
# when the running journald was started (ns since the epoch; 0 when systemd can't say). It reads
# its settings after that, so a change before it is in effect.
journald_started_ns() {
  local t; t="$(systemctl show systemd-journald.service -p ExecMainStartTimestamp --value --timestamp=us+utc 2>/dev/null)"
  case "$t" in ""|n/a) echo 0; return ;; esac
  date -d "$t" +%s%N 2>/dev/null || echo 0
}
chk_journal() {
  [ -z "$JOURNAL_MAX" ] && { echo "not managed"; return 0; }
  [[ $JOURNAL_MAX =~ ^[0-9]+(\.[0-9]+)?[KMGT]$ ]] || { echo "harden.journal_max_use must be a size such as 500M or 2G"; return 2; }
  local LC_ALL=C f v last="" lastv="(journald's default)" mine="${JOURNALD_DROPIN##*/}" later=()   # systemd sorts bytewise
  while read -r f v; do
    last=$f lastv=$v
    [[ $f == */journald.conf.d/* && $f != "$JOURNALD_DROPIN" ]] || continue
    [[ "${f##*/}" > "$mine" ]] && ! listed_for_removal "$f" && later+=("$f")
  done < <(journal_setters)
  if [ ${#later[@]} -gt 0 ]; then
    echo "${later[*]} sets SystemMaxUse after hb's $mine, so it would win: list it in harden.remove_files"; return 2
  fi
  local usage; usage="$(journalctl --disk-usage 2>/dev/null | grep -oE '[0-9.]+[KMGT]?B? in' | cut -d' ' -f1)"
  if [ "$last" != "$JOURNALD_DROPIN" ] || ! cmp -s "$JOURNALD_DROPIN" <(journal_text); then
    echo "SystemMaxUse=$lastv${last:+ (${last})} → $JOURNAL_MAX via $JOURNALD_DROPIN${usage:+; the journal now takes $usage}"; return 1
  fi
  # journald reads its settings when it starts, so it must have started after they last changed
  # (a file written, or one removed): to the nanosecond, as both can fall in the same second
  if [ "$(journald_started_ns)" -le "$(journal_changed_ns)" ]; then
    echo "SystemMaxUse=$JOURNAL_MAX is written, but journald started before its settings last changed (apply restarts it)"; return 1
  fi
  echo "SystemMaxUse=$JOURNAL_MAX${usage:+ (the journal now takes $usage)}"
}
fix_journal() {
  keep_copy "$JOURNALD_DROPIN"
  install -d -m 755 "${JOURNALD_DROPIN%/*}" && ( umask 022; journal_text > "$JOURNALD_DROPIN" ) || return 1
  # Services' output streams survive this: journald keeps them in systemd's store across restarts.
  systemctl restart systemd-journald
}

item_main "$@"
