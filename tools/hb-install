#!/usr/bin/env bash
# hb-install — run hb from a root-owned copy, so nothing running as your user
# can change the code root's timers run.
#
#   hb install status        one line per item
#   hb install plan          what apply would change (changes nothing)
#   hb install apply [--yes] make the changes, asking before each item
#   hb install check         one-line verdict (exit 0 ok, 1 pending, 2 broken)
#
# Items:
#   code    /opt/hb holds the checkout's files (git-tracked and new, never ignored
#           ones such as hb.toml or local/)
#   link    /usr/local/bin/hb points at /opt/hb/hb
#   config  /etc/hb/hb.toml is root's and matches the checkout's hb.toml, if any; and
#           everything in /etc/hb (secrets, tokens, TOTP keys) is root's, unreadable by
#           anyone else: apply tightens what isn't. A link there is broken until replaced
#           by the file itself: where it leads, this can't vouch for
#   restic  with backup.restic_version set, restic's own release binary of that version at
#           /usr/local/bin/restic: downloaded from restic's GitHub releases, and installed
#           only when its SHA-256 is backup.restic_sha256 (take it from the release's
#           SHA256SUMS, whose signature restic's documentation says how to check). Unset: not
#           managed; hb backup uses the restic on PATH
#   units   units/* are installed in /etc/systemd/system. A unit that leaves
#           units/ is removed only if it carries units/' first line ("# Managed
#           by hb install"); units other tools write (hb-webshell.service) stay.
#   timers  the timers in install.timers are enabled, other hb timers are not
#
# Run apply from the checkout: sudo ./hb install apply. Run it again after
# changing code or hb.toml. The installed copy remembers the checkout, so its
# check (and the login banner) says when the two differ.
# Config ([install] in hb.toml): timers, e.g. ["hb-status", "hb-backup"].
set -u
source "$(dirname "$(readlink -f "$0")")/../lib/hb.sh"
need_root
need_config

ITEMS=(code link config restic units timers)
PREFIX=/opt/hb
ETC=/etc/hb
UNITDIR=/etc/systemd/system
RESTIC_BIN=/usr/local/bin/restic
RESTIC_RELEASES=https://github.com/restic/restic/releases/download
# The timers come from /etc/hb/hb.toml as it is when they're checked: read after the config
# item has copied the checkout's, not when this script starts.
load_timers() { mapfile -t TIMERS < <(cfg install.timers); }

# The checkout to install from: this one, unless we are the installed copy.
if [ "$HB_ROOT" = "$PREFIX" ]; then
  SRC="$(cat "$PREFIX/.source" 2>/dev/null)"
else
  SRC="$HB_ROOT"
fi

# stage DIR — copy the checkout's files into DIR. git and tar run as the
# checkout's owner, so root never runs git hooks or reads past that user's rights.
stage() {
  local owner
  owner="$(stat -c %U "$SRC")"
  if [ -d "$SRC/.git" ]; then
    runuser -u "$owner" -- git -C "$SRC" ls-files -z -co --exclude-standard \
      | runuser -u "$owner" -- tar -C "$SRC" --null -T - -cf -
  else
    runuser -u "$owner" -- tar -C "$SRC" --exclude=./hb.toml --exclude=./local \
      --exclude=./phase0/out --exclude=__pycache__ -cf - .
  fi | tar -C "$1" --no-same-owner -xf - || return 1
  printf '%s\n' "$SRC" > "$1/.source"
  chmod -R u=rwX,go=rX "$1"
}

# --- code -----------------------------------------------------------------------
chk_code() {
  [ -n "$SRC" ] && [ -d "$SRC" ] || { echo "installed copy; checkout unknown"; return 0; }
  [ -d "$PREFIX" ] || { echo "will copy $SRC to $PREFIX"; return 1; }
  local tmp n
  tmp="$(mktemp -d)"
  stage "$tmp" || { rm -rf "$tmp"; echo "cannot read $SRC"; return 2; }
  n="$(diff -rq --no-dereference "$tmp" "$PREFIX" 2>&1 | wc -l)"
  rm -rf "$tmp"
  [ "$n" -eq 0 ] && { echo "$PREFIX matches $SRC"; return 0; }
  echo "$n files differ between $SRC and $PREFIX"; return 1
}
fix_code() {
  local new="$PREFIX.new"
  rm -rf "$new" && mkdir -p "$new" && stage "$new" || return 1
  chmod 755 "$new"
  rm -rf "$PREFIX.old"
  [ -d "$PREFIX" ] && mv "$PREFIX" "$PREFIX.old"
  mv "$new" "$PREFIX" && rm -rf "$PREFIX.old"
}

# --- link -----------------------------------------------------------------------
chk_link() {
  [ "$(readlink /usr/local/bin/hb)" = "$PREFIX/hb" ] && { echo "/usr/local/bin/hb → $PREFIX/hb"; return 0; }
  echo "will link /usr/local/bin/hb → $PREFIX/hb"; return 1
}
fix_link() { ln -sfn "$PREFIX/hb" /usr/local/bin/hb; }

# --- config ---------------------------------------------------------------------
# links_in_etc — links in /etc/hb, /etc/hb itself included. Where they lead, this can't vouch
# for, and chown/chmod/install would follow them, so they come before anything else.
links_in_etc() { { [ -e "$ETC" ] || [ -L "$ETC" ]; } || return 0; find "$ETC" -type l -printf '%p ' 2>/dev/null | sed 's/ $//'; }
chk_config() {
  local etc="$ETC/hb.toml" src="" links loose
  [ -n "$SRC" ] && [ -f "$SRC/hb.toml" ] && src="$SRC/hb.toml"
  links="$(links_in_etc)"
  if [ -n "$links" ]; then echo "links in $ETC lead where this can't vouch for: $links (put the file itself there)"; return 2; fi
  if [ ! -f "$etc" ]; then
    [ -n "$src" ] && { echo "will copy $src → $etc"; return 1; }
    echo "no $etc, and no hb.toml in the checkout to copy"; return 2
  fi
  if [ "$(stat -c %u:%a "$etc")" != 0:600 ]; then echo "$etc will be made root's, mode 600"; return 1; fi
  loose="$(loose_in_etc)"
  if [ -n "$loose" ]; then echo "only root may read what is in $ETC; will tighten: $loose"; return 1; fi
  if [ -n "$src" ] && ! cmp -s "$src" "$etc"; then
    echo "$src differs from $etc (diff them; apply copies the checkout's)"; return 1
  fi
  echo "$etc"
}
# loose_in_etc — what in /etc/hb is someone else's, or open to group or others (links aside)
loose_in_etc() { find "$ETC" ! -type l \( ! -uid 0 -o -perm /077 \) -printf '%p ' 2>/dev/null | sed 's/ $//'; }
fix_config() {
  local etc="$ETC/hb.toml" src=""
  [ -n "$SRC" ] && [ -f "$SRC/hb.toml" ] && src="$SRC/hb.toml"
  [ -z "$(links_in_etc)" ] || { echo "links in $ETC: not touching anything there" >&2; return 1; }
  install -d -m 700 "$ETC"
  if [ -n "$src" ] && ! cmp -s "$src" "$etc" 2>/dev/null; then
    keep_copy "$etc"
    install -m 600 "$src" "$etc" || return 1
  fi
  chown root:root "$etc" && chmod 600 "$etc" || return 1
  chown -R root:root "$ETC" && chmod -R go-rwx "$ETC"   # only root ever writes here, so nothing to follow
}

# --- restic ---------------------------------------------------------------------
# Read when checked, like the timers: after the config item has copied the checkout's hb.toml.
restic_arch() { case "$(uname -m)" in x86_64) echo amd64 ;; aarch64) echo arm64 ;; *) return 1 ;; esac; }
restic_asset() { echo "restic_$(cfg backup.restic_version)_linux_$(restic_arch).bz2"; }
chk_restic() {
  local v sha have todo
  v="$(cfg backup.restic_version)"; sha="$(cfg backup.restic_sha256)"
  [ -n "$v" ] || { echo "not managed (backup.restic_version is empty; hb backup uses the restic on PATH)"; return 0; }
  [[ $v =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "backup.restic_version must look like 0.19.1"; return 2; }
  restic_arch >/dev/null || { echo "no restic release for $(uname -m)"; return 2; }
  [[ $sha =~ ^[0-9a-f]{64}$ ]] || { echo "backup.restic_sha256 must be the SHA-256 of $(restic_asset) (from the release's SHA256SUMS)"; return 2; }
  if [ ! -e "$RESTIC_BIN" ] && [ ! -L "$RESTIC_BIN" ]; then
    todo="will install restic $v at $RESTIC_BIN"
  elif [ -L "$RESTIC_BIN" ] || [ ! -f "$RESTIC_BIN" ] || [ "$(stat -c %u "$RESTIC_BIN")" != 0 ] \
       || [ -n "$(find "$RESTIC_BIN" -perm /022)" ]; then
    todo="$RESTIC_BIN isn't a file only root can change: will replace it with restic $v"
  else
    have="$("$RESTIC_BIN" version 2>/dev/null)"     # root's own file: safe to run
    [[ $have == "restic $v "* ]] && { echo "restic $v at $RESTIC_BIN"; return 0; }
    todo="will replace ${have:-an unknown restic} at $RESTIC_BIN with restic $v"
  fi
  echo "$todo ($(restic_asset), SHA-256 checked)"; return 1
}
fix_restic() {
  local v sha asset tmp rc=1
  v="$(cfg backup.restic_version)"; sha="$(cfg backup.restic_sha256)"; asset="$(restic_asset)"
  tmp="$(mktemp -d)" || return 1
  if ! curl -fsSL --proto =https --proto-redir =https --retry 3 --max-time 600 -o "$tmp/$asset" \
       "$RESTIC_RELEASES/v$v/$asset"; then
    echo "  can't download $RESTIC_RELEASES/v$v/$asset" >&2
  elif ! printf '%s  %s\n' "$sha" "$tmp/$asset" | sha256sum -c --status; then
    echo "  $asset's SHA-256 is $(sha256sum < "$tmp/$asset" | cut -d' ' -f1), not backup.restic_sha256: not installed" >&2
  elif ! python3 -I -c 'import bz2, shutil, sys; shutil.copyfileobj(bz2.open(sys.argv[1]), open(sys.argv[2], "wb"))' \
         "$tmp/$asset" "$tmp/restic" || ! chmod 755 "$tmp/restic"; then
    echo "  can't unpack $asset" >&2
  elif [[ "$("$tmp/restic" version 2>/dev/null)" != "restic $v "* ]]; then
    echo "  $asset doesn't say it is restic $v: not installed" >&2
  else
    install -m 755 "$tmp/restic" "$RESTIC_BIN.new" && mv -fT "$RESTIC_BIN.new" "$RESTIC_BIN" && rc=0
  fi
  rm -rf "$tmp"
  return $rc
}

# --- units ----------------------------------------------------------------------
unit_files() { local f; for f in "$PREFIX"/units/hb-*.service "$PREFIX"/units/hb-*.timer; do [ -f "$f" ] && echo "$f"; done; }
# Ours: installed from units/, whose files all start with this line.
MARK="# Managed by hb install"
stale_units() {
  local f
  for f in "$UNITDIR"/hb-*.service "$UNITDIR"/hb-*.timer; do
    [ -f "$f" ] && [ ! -f "$PREFIX/units/${f##*/}" ] && [[ "$(head -n1 "$f")" == "$MARK"* ]] && echo "$f"
  done
  return 0
}
chk_units() {
  [ -d "$PREFIX/units" ] || { echo "install code first"; return 1; }
  local f differ=() stale
  for f in $(unit_files); do cmp -s "$f" "$UNITDIR/${f##*/}" || differ+=("${f##*/}"); done
  stale="$(stale_units | xargs -r -n1 basename | tr '\n' ' ')"
  [ ${#differ[@]} -eq 0 ] && [ -z "$stale" ] && { echo "$(unit_files | wc -l) units installed"; return 0; }
  echo "will install: ${differ[*]:-none}; will remove: ${stale:-none}"; return 1
}
fix_units() {
  local f
  for f in $(stale_units); do systemctl disable --now -q "${f##*/}" 2>/dev/null; rm -f "$f"; done
  for f in $(unit_files); do install -m 644 "$f" "$UNITDIR/${f##*/}"; done
  systemctl daemon-reload
}

# --- timers ---------------------------------------------------------------------
chk_timers() {
  local t want on=() off=() missing=()
  load_timers
  for t in "${TIMERS[@]}"; do
    [ -f "$UNITDIR/$t.timer" ] || { missing+=("$t"); continue; }
    systemctl is-enabled -q "$t.timer" && systemctl is-active -q "$t.timer" || on+=("$t")
  done
  for t in $(systemctl list-unit-files 'hb-*.timer' --state=enabled --no-legend 2>/dev/null | awk '{print $1}'); do
    want=0
    for w in "${TIMERS[@]}"; do [ "$w.timer" = "$t" ] && want=1; done
    [ $want = 0 ] && off+=("${t%.timer}")
  done
  [ ${#missing[@]} -gt 0 ] && { echo "no such timer: ${missing[*]} (install units first, or check install.timers)"; return 1; }
  [ ${#on[@]} -eq 0 ] && [ ${#off[@]} -eq 0 ] && { echo "enabled: ${TIMERS[*]:-none}"; return 0; }
  echo "will enable: ${on[*]:-none}; will disable: ${off[*]:-none}"; return 1
}
fix_timers() {
  local t want
  load_timers
  for t in "${TIMERS[@]}"; do systemctl enable --now -q "$t.timer" || return 1; done
  for t in $(systemctl list-unit-files 'hb-*.timer' --state=enabled --no-legend | awk '{print $1}'); do
    want=0
    for w in "${TIMERS[@]}"; do [ "$w.timer" = "$t" ] && want=1; done
    [ $want = 0 ] && systemctl disable --now -q "$t"
  done
  return 0
}

item_main "$@"
