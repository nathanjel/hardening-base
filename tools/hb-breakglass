#!/usr/bin/python3 -IB
"""hb-breakglass — a rescue account and a kit for one trusted person.

  hb breakglass status         one line per item, and the kit
  hb breakglass plan           what apply would change (changes nothing)
  hb breakglass apply [--yes]  make the changes, asking before each item
  hb breakglass kit [--to DIR] a new kit; the previous one stops working
  hb breakglass check          one-line verdict (exit 0 ok, 1 attention, 2 broken)
  hb breakglass login          (run by systemd when the account logs in)

Items:
  account  breakglass.user with uid breakglass.uid, in wheel; its password
           stays locked until the first kit
  alert    a drop-in for user@<uid>.service, so a login of that account (ssh
           or console) sends hb notify fail and counts as a kit test. It runs
           when the account's first session starts: a login while another of
           its sessions is open adds nothing. Every such login texts (hb notify
           send --every-time: past notify.repeat_hours, within sms_per_day).
           It runs hb as root, so it fails unless hb's whole tree, the
           folders above it and hb.toml are root's alone (the copy in /opt/hb
           that hb install makes)

The kit (`kit`, again to rotate) is made in root's own folder, then written to
DIR (default ~/hb-kit-DATE of the person running sudo, mode 700), which must be
new and whose path may not go through a link. DIR is made first, so one that
can't take the kit fails before anything changes; if writing to it fails
later, the new kit stays in root's folder and the command says where:
  rescue.key   a new ed25519 key with a passphrase; its public half goes into
               /etc/ssh/authorized_keys/<user>, replacing the previous kit's
  kit.html     the page to print, kit.txt the same as text: how to log in from
               any Windows PC or the provider's console, the key passphrase,
               the account password (for sudo and the console), 10 recovery
               codes for the code prompt (hb totp) and, with backup.repo, the
               password of a restic key made for the kit (the previous kit's
               restic key is removed)
Copy DIR off the server, print kit.html, put rescue.key and kit.html on a USB
stick, delete DIR; `check` reminds you while it, or an earlier kit's folder, is
still there, until the kit has been used once, and when it hasn't been used for
breakglass.test_days.

Config ([breakglass] in hb.toml): user, uid, host (the name the kit connects
to; default probe.host), note (printed at the top of the page: where the
provider login is kept, who to call, host-specific jobs), test_days.
"""
import datetime
import grp
import hashlib
import html
import json
import os
import pwd
import re
import secrets
import shutil
import socket
import stat
import subprocess
import sys
import tempfile
import time

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), os.pardir, "lib"))
import hbkit.start  # noqa: E402,F401  (first: Python 3.11+, and a quiet end when the output pipe closes)
from hbkit import config, sudocheck, util  # noqa: E402

KEYDIR = "/etc/ssh/authorized_keys"
WORDLIST = os.path.join(util.HB_ROOT, "lib", "eff_large_wordlist.txt")
WORDLIST_SHA256 = "addd35536511597a02fa0a9ff1e5284677b8883b83e986e43f15a3db996b903e"
USER = re.compile(r"^[a-z_][a-z0-9_-]{0,31}$")
DROPIN_DIR = "/etc/systemd/system/user@{uid}.service.d"
DROPIN_NAME = "hb-breakglass.conf"
RESTIC_HOST = "hb-kit"
WORDS = 6   # 6 of 7776 words: about 77 bits


def state_path():
    return os.path.join(util.state_dir("breakglass"), "state.json")


def load_state():
    return util.read_json(state_path(), {})


def save_state(st):
    util.write_json(state_path(), st)


def settings(cfg):
    b = cfg["breakglass"]
    return b["user"], int(b["uid"])


# --- account ------------------------------------------------------------------------

def uid_in_use(uid):
    """Processes running as uid (containers included)."""
    pids = []
    for d in os.listdir("/proc"):
        if not d.isdigit():
            continue
        try:
            with open(f"/proc/{d}/status") as f:
                for line in f:
                    if line.startswith("Uid:"):
                        if int(line.split()[1]) == uid:
                            pids.append(d)
                        break
        except OSError:
            continue
    return pids


def chk_account(cfg):
    user, uid = settings(cfg)
    if not USER.match(user):
        return 2, f"breakglass.user {user!r} is not a user name"
    try:
        pw = pwd.getpwnam(user)
    except KeyError:
        pw = None
    if pw is None:
        try:
            other = pwd.getpwuid(uid).pw_name
            return 2, f"uid {uid} already belongs to {other}; pick another breakglass.uid"
        except KeyError:
            pass
        pids = uid_in_use(uid)
        if pids:
            return 2, f"uid {uid} is in use by processes {' '.join(pids[:5])} (a container?); pick another"
        return 1, f"will create {user} (uid {uid}, in wheel, password locked until the kit)"
    if pw.pw_uid != uid:
        return 2, f"{user} exists with uid {pw.pw_uid}, not {uid}"
    if user not in grp.getgrnam("wheel").gr_mem:
        return 1, f"will add {user} to wheel"
    return 0, f"{user} (uid {uid}, wheel)"


def fix_account(cfg):
    user, uid = settings(cfg)
    try:
        pwd.getpwnam(user)
    except KeyError:
        rc, _, err = util.run("useradd", "-u", str(uid), "-m", "-s", "/bin/bash", "-G", "wheel",
                              "-c", "hb break-glass account", user)
        if rc != 0:
            return f"useradd: {err.strip()}"
        util.run("passwd", "-l", user)
        return None
    rc, _, err = util.run("usermod", "-aG", "wheel", user)
    return None if rc == 0 else f"usermod: {err.strip()}"


# --- alert --------------------------------------------------------------------------

def dropin_path(uid):
    return os.path.join(DROPIN_DIR.format(uid=uid), DROPIN_NAME)


def dropin_text():
    return ("# Managed by hb-breakglass: tells the owner when the break-glass account logs in.\n"
            "[Service]\n"
            f"ExecStartPre=-+{util.HB} breakglass login\n")


def unsafe_tree():
    """The first thing that lets someone other than root change what the alert runs or reads as
    root, or None: hb's whole tree (the dispatcher, this tool, hb notify, the libraries), the
    folders above it, and hb.toml (it names the SMS command)."""
    # The hooks run without HB_CONFIG: they read the system file, else the tree's own (walked).
    bad = sudocheck.hb_problems(util.HB_ROOT, [config.SYSTEM_FILE])
    return bad[0] if bad else None


def chk_alert(cfg):
    _, uid = settings(cfg)
    path = dropin_path(uid)
    try:
        with open(path) as f:
            have = f.read()
    except FileNotFoundError:
        have = None
    bad = unsafe_tree()
    if bad:
        return 2, (f"the alert {'runs' if have == dropin_text() else 'would run'} {util.HB} as root, but {bad}: "
                   "use the copy in /opt/hb that hb install makes (sudo hb ...)")
    if have == dropin_text():
        return 0, f"logins alert via {path}"
    return 1, f"will write {path}"


def fix_alert(cfg):
    _, uid = settings(cfg)
    path = dropin_path(uid)
    os.makedirs(os.path.dirname(path), mode=0o755, exist_ok=True)
    util.write_atomic(path, dropin_text(), mode=0o644)
    rc, _, err = util.run("systemctl", "daemon-reload")
    return None if rc == 0 else f"systemctl daemon-reload: {err.strip()}"


ITEMS = (("account", chk_account, fix_account), ("alert", chk_alert, fix_alert))


# --- login (run by user@<uid>.service) -----------------------------------------------

def sessions_text(uid):
    rc, out, _ = util.run("loginctl", "show-user", str(uid), "-p", "Sessions", "--value")
    via = []
    for s in out.split() if rc == 0 else []:
        _, info, _ = util.run("loginctl", "show-session", s, "-p", "Service", "-p", "RemoteHost", "-p", "TTY")
        d = dict(line.split("=", 1) for line in info.splitlines() if "=" in line)
        if d.get("Service") == "systemd-user":
            continue
        if d.get("RemoteHost"):
            via.append(f"{d.get('Service') or 'remote'} from {d['RemoteHost']}")
        elif d.get("TTY"):
            via.append(f"console {d['TTY']}")
    return ", ".join(dict.fromkeys(via)) or "unknown session"


def do_login(cfg):
    user, uid = settings(cfg)
    via = sessions_text(uid)
    st = load_state()
    st.update(last_login=time.time(), last_login_via=via)
    save_state(st)
    # Its own transient unit: the login doesn't wait for the SMS, and a quick
    # logout (which stops user@<uid>.service) doesn't cut it off.
    # --every-time: each login texts, however soon after the last (a test, say); only
    # notify.sms_per_day limits it.
    util.run("systemd-run", "--no-block", "--collect", "--quiet", "--description=hb breakglass login alert",
             util.HB, "notify", "send", "--every-time", "fail", "breakglass.login", f"{user} logged in ({via})")
    return 0


# --- kit ------------------------------------------------------------------------------

def words():
    with open(WORDLIST, "rb") as f:
        data = f.read()
    if hashlib.sha256(data).hexdigest() != WORDLIST_SHA256:
        raise RuntimeError(f"{WORDLIST} isn't the EFF long wordlist (checksum differs)")
    # Passphrases join words with dashes, so the four words that have one (t-shirt...) are left out.
    return [w for w in (line.split()[1] for line in data.decode().splitlines()) if "-" not in w]


def passphrase(wordlist, n=WORDS):
    return "-".join(secrets.choice(wordlist) for _ in range(n))


def restic_env(cfg):
    b = cfg["backup"]
    return dict(os.environ, RESTIC_REPOSITORY=b["repo"], RESTIC_PASSWORD_FILE=b["password_file"])


def restic_add_key(cfg, password, user):
    """The new key's id, or raises RuntimeError."""
    env = restic_env(cfg)
    with tempfile.NamedTemporaryFile("w", dir=util.state_dir("breakglass"), delete=True) as f:
        os.chmod(f.name, 0o600)
        f.write(password + "\n")
        f.flush()
        rc, _, err = util.run("restic", "key", "add", "--new-password-file", f.name, "--host", RESTIC_HOST,
                              "--user", user, timeout=300, env=env)
    if rc != 0:
        raise RuntimeError(f"restic key add: {err.strip()}")
    rc, out, err = util.run("restic", "key", "list", "--json", timeout=300, env=env)
    if rc != 0:
        raise RuntimeError(f"restic key list: {err.strip()}")
    mine = [k for k in json.loads(out) if k.get("hostName") == RESTIC_HOST]
    if not mine:
        raise RuntimeError("restic key list doesn't show the new key")
    return max(mine, key=lambda k: k.get("created", ""))["id"]


def restic_remove_key(cfg, key_id):
    rc, _, err = util.run("restic", "key", "remove", key_id, timeout=300, env=restic_env(cfg))
    return None if rc == 0 else err.strip()


KEYGEN = "ssh-keygen"          # tests point it at a stand-in
KEYGEN_ENV = {"PATH": "/usr/sbin:/usr/bin:/sbin:/bin", "LC_ALL": "C"}


def keygen(args, stdin):
    """ssh-keygen with the passphrase on stdin, never on argv (anyone can read a command line).
    It reads stdin only when it can't open a terminal: readpassphrase tries /dev/tty first, so
    from a terminal it would ask the person instead. So it runs in a session of its own, with no
    terminal, and without DISPLAY or SSH_ASKPASS, with which it would ask a helper program (and
    take a failed one's answer as an empty passphrase)."""
    return subprocess.run([KEYGEN, *args], input=stdin, text=True, capture_output=True, timeout=60,
                          env=KEYGEN_ENV, start_new_session=True)


def make_ssh_key(path, phrase, comment):
    """A new ed25519 key at path, locked with phrase; its public line. Checked both ways before it
    is used: phrase opens it, an empty passphrase doesn't."""
    p = keygen(["-q", "-t", "ed25519", "-C", comment, "-f", path], f"{phrase}\n{phrase}\n")
    if p.returncode != 0 or not os.path.exists(path):
        raise RuntimeError(f"ssh-keygen: {p.stderr.strip()}")
    with open(path + ".pub") as f:
        pub = f.read().strip()
    opened, bare = keygen(["-y", "-f", path], f"{phrase}\n"), keygen(["-y", "-f", path], "\n")
    if opened.returncode != 0 or opened.stdout.split()[:2] != pub.split()[:2] or bare.returncode == 0:
        raise RuntimeError("ssh-keygen didn't lock the key with the kit's passphrase; no kit made")
    return pub


def host_fingerprint():
    rc, out, _ = util.run("ssh-keygen", "-lf", "/etc/ssh/ssh_host_ed25519_key.pub")
    return out.split()[1] if rc == 0 and len(out.split()) > 1 else "(unknown)"


def refused_text():
    """What "Connection refused" may mean. On every kit, without the ban's length: a printed kit
    outlives changes to [fail2ban] (turned on later, another bantime)."""
    return ("\"Connection refused\": after repeated failed logins the server may stop answering your address "
            "for a while (fail2ban). Wait an hour and try again, or ask the owner to lift it "
            "(sudo hb fail2ban unban YOUR-ADDRESS).")


def kit_host(cfg):
    return cfg["breakglass"]["host"] or cfg["probe"]["host"] or socket.getfqdn()


def kit_sections(k):
    """[(heading, [(kind, text)])] shared by kit.txt and kit.html; kind is p, cmd or secret."""
    host, user = k["host"], k["user"]
    s = [("What this is", [
        ("p", f"This opens the server {host} when its owner can't. Using it sends the owner a text message."),
        *([("p", k["note"])] if k["note"] else []),
        ("p", "You need this page, the USB stick (it holds rescue.key and a copy of this page) and a "
              "Windows 10 or 11 PC with internet. Nothing to install."),
    ]), ("Log in", [
        ("p", "1. Plug in the stick. Open PowerShell: Start, type powershell, press Enter."),
        ("p", "2. Copy the key and make it private (E: is the stick's letter; use yours):"),
        ("cmd", "copy E:\\rescue.key $env:USERPROFILE\\rescue.key"),
        ("cmd", 'icacls $env:USERPROFILE\\rescue.key /inheritance:r /grant:r "${env:USERNAME}:R"'),
        ("p", "3. Connect:"),
        ("cmd", f"ssh -o IdentitiesOnly=yes -i $env:USERPROFILE\\rescue.key {user}@{host}"),
        ("p", f"If it asks whether to continue connecting, the fingerprint must be {k['fingerprint']}; "
              "then type yes."),
        ("p", "At \"Enter passphrase for key\" type the KEY PASSPHRASE. At \"Password:\" type ONE recovery "
              "code and cross it out."),
        ("p", "4. For admin commands type sudo -i and then the ACCOUNT PASSWORD."),
    ]), ("If SSH doesn't work", [
        *([("p", k["refused"])] if k.get("refused") else []),
        ("p", "Log in to the hosting provider's web panel, open this server's console (IPMI, "
              f"\"Serial over LAN\"), press Enter and log in as {user} with the ACCOUNT PASSWORD."),
    ]), ("Common jobs (after sudo -i)", [
        ("p", "Shut the server down:"), ("cmd", "systemctl poweroff"),
        ("p", "Restart it:"), ("cmd", "systemctl reboot"),
        ("p", "Copy files to the PC (in PowerShell on the PC, not on the server):"),
        ("cmd", f"scp -o IdentitiesOnly=yes -i $env:USERPROFILE\\rescue.key -r {user}@{host}:/path/on/server ."),
        *([("p", f"Backups (restic, repository {k['repo']}; it asks for the BACKUP PASSWORD):"),
           ("cmd", f"restic -r {k['repo']} snapshots"),
           ("cmd", f"restic -r {k['repo']} restore latest --target /root/restored")] if k["repo"] else []),
    ]), ("Secrets", [
        ("secret", f"KEY PASSPHRASE    {k['phrase']}"),
        ("secret", f"ACCOUNT PASSWORD  {k['password']}"),
        *([("secret", f"BACKUP PASSWORD   {k['restic_password']}")] if k["restic_password"] else []),
        ("p", "RECOVERY CODES, each works once:"),
        *[("secret", "[ ] " + "      [ ] ".join(k["codes"][i:i + 2])) for i in range(0, len(k["codes"]), 2)],
    ]), ("Afterwards", [
        ("p", "Tell the owner. They make a new kit (sudo hb breakglass kit), which retires this one. "
              "Delete rescue.key from the PC you used."),
    ])]
    return s


def kit_txt(k):
    out = [f"BREAK-GLASS KIT for {k['host']}", f"Made {k['made']}. Keep this page and the USB stick together, sealed.", ""]
    for head, items in kit_sections(k):
        out += [head.upper(), ""]
        for kind, text in items:
            out.append(("    " if kind in ("cmd", "secret") else "") + text)
        out.append("")
    return "\n".join(out)


def kit_html(k):
    e = html.escape
    body = [f"<h1>Break-glass kit for {e(k['host'])}</h1>",
            f"<p class=made>Made {e(k['made'])}. Keep this page and the USB stick together, sealed.</p>"]
    for head, items in kit_sections(k):
        body.append(f"<h2>{e(head)}</h2>")
        for kind, text in items:
            body.append(f"<p>{e(text)}</p>" if kind == "p" else f"<pre class={kind}>{e(text)}</pre>")
    return ("<!doctype html>\n<html lang=en><meta charset=utf-8>\n"
            f"<title>Break-glass kit: {e(k['host'])}</title>\n<style>\n"
            "body{font:11pt/1.45 system-ui,sans-serif;max-width:46em;margin:2em auto;padding:0 1em;color:#000;background:#fff}\n"
            "h1{font-size:17pt;margin:0 0 .2em}h2{font-size:12.5pt;margin:1.3em 0 .3em;border-bottom:1px solid #999}\n"
            "p{margin:.35em 0}.made{color:#444}\n"
            "pre{font:10.5pt/1.4 ui-monospace,Consolas,monospace;margin:.3em 0 .5em 1.5em;white-space:pre-wrap}\n"
            "pre.secret{font-size:12.5pt;font-weight:600}\n"
            "@media print{body{margin:0}h2{break-after:avoid}}\n"
            "</style>\n" + "\n".join(body) + "\n</html>\n")


def kit_preflight(cfg):
    why = []
    for name, chk, _ in ITEMS:
        rc, line = chk(cfg)
        if rc:
            why.append(f"{name}: {line} (sudo hb breakglass apply)")
    rc, out, _ = util.run("sshd", "-T")
    akf = next((l.split(None, 1)[1] for l in out.splitlines() if l.startswith("authorizedkeysfile ")), "")
    if f"{KEYDIR}/%u" not in akf.split():
        why.append(f"sshd doesn't read {KEYDIR}/<user> yet (sudo hb ssh apply, then confirm)")
    if cfg["backup"]["repo"]:
        rc, _, err = util.run("restic", "cat", "config", timeout=120, env=restic_env(cfg))
        if rc != 0:
            why.append(f"the backup repository doesn't answer ({err.strip()[:80]}); is the share mounted?")
    return why


def kit_put(dfd, name, data, mode=0o600, owner=None):
    """A new file in the kit's folder: it can't already exist, or be a link. owner is (uid, gid),
    given to the file through its own descriptor."""
    fd = os.open(name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, mode, dir_fd=dfd)
    with os.fdopen(fd, "wb") as f:
        os.fchmod(f.fileno(), mode)
        f.write(data)
        if owner:
            os.fchown(f.fileno(), *owner)


def open_dir(path):
    """A descriptor for the folder path, opened from / one name at a time without following any link,
    so that what it refers to can't be changed by renaming or replacing something along the way."""
    if not os.path.isabs(path):
        raise RuntimeError(f"{path}: not an absolute path")
    fd = os.open("/", os.O_RDONLY | os.O_DIRECTORY)
    try:
        for name in [n for n in path.split("/") if n]:
            try:
                nfd = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
            except OSError as e:
                raise RuntimeError(f"{path}: {name} is a link or not a folder ({e.strerror}); "
                                   "give a path without links") from None
            os.close(fd)
            fd = nfd
        return fd
    except BaseException:
        os.close(fd)
        raise


def reserve(to):
    """Make the kit's folder before anything changes: created in the parent opened by open_dir, and
    checked to be this run's (root's, mode 700, empty). Returns (parent fd, folder fd)."""
    parent, name = os.path.split(to)
    pfd = open_dir(parent)
    kfd = None
    try:
        os.mkdir(name, 0o700, dir_fd=pfd)
        kfd = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=pfd)
        st = os.fstat(kfd)
        if st.st_uid != os.geteuid() or stat.S_IMODE(st.st_mode) != 0o700 or os.listdir(kfd):
            raise RuntimeError(f"{to} was replaced while it was being made")
        return pfd, kfd
    except BaseException as e:
        if kfd is not None:
            os.close(kfd)
        os.close(pfd)
        if isinstance(e, OSError):
            raise RuntimeError(f"{to}: {e.strerror or e}") from None
        raise


def release(pfd, kfd, name):
    """Take the reserved folder away again, if it is still the one made here and still empty."""
    try:
        here, mine = os.stat(name, dir_fd=pfd, follow_symlinks=False), os.fstat(kfd)
        if (here.st_dev, here.st_ino) == (mine.st_dev, mine.st_ino) and not os.listdir(kfd):
            os.rmdir(name, dir_fd=pfd)
    except OSError:
        pass
    finally:
        os.close(kfd)
        os.close(pfd)


def fill(kfd, files, owner):
    """Write the kit's files into the reserved folder, then give the folder to owner. Only that folder
    and the files written into it change hands, each through its own descriptor."""
    written = []
    try:
        for fname, data, mode in files:
            kit_put(kfd, fname, data, mode, owner)
            written.append(fname)
        if owner:
            os.fchown(kfd, *owner)
    except OSError as e:
        for fname in written:
            try:
                os.unlink(fname, dir_fd=kfd)
            except OSError:
                pass
        raise RuntimeError(e.strerror or str(e)) from None


def do_kit(cfg, to):
    user, _ = settings(cfg)
    owner = util.sudo_user()
    if not to:
        if not owner:
            print("say where to write the kit: hb breakglass kit --to DIR")
            return 2
        to = os.path.join(pwd.getpwnam(owner).pw_dir, f"hb-kit-{datetime.date.today():%Y%m%d}")
    to = os.path.abspath(to)
    if os.path.exists(to):
        print(f"{to} exists; delete it or choose another --to")
        return 2
    why = kit_preflight(cfg)
    if why:
        for w in why:
            print(f"cannot  {w}")
        return 2
    st = load_state()
    if st.get("kit_made"):
        q = f"make a new kit? The one made {st['kit_made']} stops working: its key, password, codes and backup key."
    else:
        q = f"make the kit for {user} in {to}?"
    if not util.ask(q):
        print("nothing changed")
        return 1
    # The destination first, so a path that can't take the kit fails while the old kit still works.
    # It stays root's (mode 700) until the kit is in it.
    try:
        pfd, kfd = reserve(to)
    except RuntimeError as e:
        print(f"{e}\nnothing changed")
        return 2
    try:
        return make_kit(cfg, st, user, owner, to, kfd)
    finally:
        release(pfd, kfd, os.path.basename(to))      # only does something when the folder is still empty


def keep_secrets(staging, k):
    """Write the kit's secrets down in root's folder, so a run that stops part-way loses none of them."""
    util.write_atomic(os.path.join(staging, "secrets.json"), json.dumps(
        {key: k[key] for key in ("user", "made", "phrase", "password", "restic_password", "codes") if key in k},
        indent=1) + "\n", mode=0o600)


def kit_written(st, made, path):
    """The new kit is in path. The previous kit's folder, if still there, joins the old ones check names:
    their secrets no longer work, but the folders should go too."""
    old = [d for d in st.get("old_kit_dirs", []) + [st.get("kit_dir")] if d and d != path and os.path.exists(d)]
    st.update(kit_made=made, kit_made_ts=time.time(), kit_dir=path, old_kit_dirs=old)


def make_kit(cfg, st, user, owner, to, kfd):
    wl = words()
    k = {"host": kit_host(cfg), "user": user, "made": datetime.date.today().isoformat(),
         "note": cfg["breakglass"]["note"].strip(), "fingerprint": host_fingerprint(),
         "repo": cfg["backup"]["repo"], "phrase": passphrase(wl), "password": passphrase(wl)}
    k["restic_password"] = passphrase(wl) if k["repo"] else ""
    k["refused"] = refused_text()
    before = st.get("rotation")                      # left by earlier runs that didn't finish
    earlier = ([before["staging"]] + before.get("earlier", [])) if before else []

    # Every secret is written down in root's own folder before it goes live, and the state says a
    # rotation is under way until a whole kit exists: whatever fails part-way, nothing made is lost,
    # and hb breakglass check fails until a kit is complete.
    staging = tempfile.mkdtemp(prefix=f"kit-{k['made']}-", dir=util.state_dir("breakglass"))
    try:
        pub = make_ssh_key(os.path.join(staging, "rescue.key"), k["phrase"], f"{user} kit {k['made']}")
        keep_secrets(staging, k)
        st["rotation"] = {"since": int(time.time()), "staging": staging, "earlier": earlier}
        save_state(st)
    except (RuntimeError, OSError) as e:
        shutil.rmtree(staging, ignore_errors=True)
        print(f"{e}\nnothing changed")
        return 2

    # The backup key first: it is the step most likely to fail (the share), and
    # nothing else has changed yet. Its id is kept at once so a later run removes it.
    if k["repo"]:
        try:
            new_id = restic_add_key(cfg, k["restic_password"], user)
        except RuntimeError as e:
            st.pop("rotation", None)
            if before:
                st["rotation"] = before
            save_state(st)
            shutil.rmtree(staging, ignore_errors=True)
            print(f"{e}\nnothing changed")
            return 2
        old_id = st.get("restic_key")
        st["restic_key"] = new_id
        save_state(st)
        if old_id and old_id != new_id:
            err = restic_remove_key(cfg, old_id)
            if err:
                print(f"note: couldn't remove the previous kit's backup key {old_id[:8]}: {err}")

    try:
        util.write_atomic(os.path.join(KEYDIR, user),
                          f"# Managed by hb-breakglass: the kit made {k['made']}.\n{pub}\n", mode=0o644)
        rc, _, err = util.run("chpasswd", input=f"{user}:{k['password']}\n")
        if rc != 0:
            raise RuntimeError(f"chpasswd: {err.strip()}")
        rc, out, err = util.run(util.HB, "totp", "codes", user, "--plain")
        codes = out.split()
        if rc != 0 or len(codes) != 10:
            raise RuntimeError(f"hb totp codes: {(err or out).strip()[:120]}")
        k["codes"] = codes                           # live now: written down before anything else
        try:
            keep_secrets(staging, k)
        except OSError:
            print("couldn't write down the new recovery codes, which already work; copy them now:\n  "
                  + "  ".join(codes))
            raise
        util.write_atomic(os.path.join(staging, "kit.txt"), kit_txt(k), mode=0o600)
        util.write_atomic(os.path.join(staging, "kit.html"), kit_html(k), mode=0o600)
    except (RuntimeError, OSError) as e:
        util.notify("fail", "breakglass.kit", f"a new break-glass kit for {user} didn't finish")
        print(f"{e}\nThe kit is incomplete, and part of the old one may no longer work. What was made is in "
              f"{staging} (root's only; secrets.json has the passwords and codes).\n"
              "Run sudo hb breakglass kit again (to a new --to); hb breakglass check fails until then.")
        return 2

    files = []
    for n in ("rescue.key", "rescue.key.pub", "kit.txt", "kit.html"):
        with open(os.path.join(staging, n), "rb") as f:
            files.append((n, f.read(), os.fstat(f.fileno()).st_mode & 0o777))
    for old in earlier:                              # earlier unfinished runs: their secrets no longer work
        shutil.rmtree(old, ignore_errors=True)
    st.pop("rotation", None)
    pw = pwd.getpwnam(owner) if owner else None
    try:
        fill(kfd, files, (pw.pw_uid, pw.pw_gid) if pw else None)
    except RuntimeError as e:
        # The new kit is whole and live, and the old one is not: keep it where it was made, and say so.
        kit_written(st, k["made"], staging)
        save_state(st)
        util.notify("warn", "breakglass.kit", f"new break-glass kit made for {user}, but not delivered")
        print(f"couldn't write the kit to {to}: {e}\n"
              f"The new kit is made (the old one no longer works) and is in {staging}, root's only.\n"
              f"Copy it from there, e.g.  sudo cp -r {staging} ~/hb-kit  and  sudo chown -R $USER ~/hb-kit,"
              f" then:  sudo rm -r {staging}")
        return 2
    shutil.rmtree(staging, ignore_errors=True)
    kit_written(st, k["made"], to)
    save_state(st)
    util.notify("info", "breakglass.kit", f"new break-glass kit made for {user}")
    print(f"\nThe kit is in {to}: rescue.key, rescue.key.pub, kit.html, kit.txt")
    print("1. Copy it to your PC (e.g. scp -r), then delete it here:  rm -r " + to)
    print("2. Print kit.html. Put rescue.key and kit.html on the USB stick.")
    print("3. Test it from a Windows PC with only the stick and the page (it uses one recovery code).")
    return 0


# --- verbs ----------------------------------------------------------------------------

def kit_verdict(cfg):
    st = load_state()
    rot = st.get("rotation")
    if rot:
        also = f", and from earlier tries in {', '.join(rot['earlier'])}" if rot.get("earlier") else ""
        return 2, (f"a new kit started {datetime.date.fromtimestamp(rot['since'])} didn't finish; what was made is "
                   f"in {rot['staging']}{also} (root's only); run sudo hb breakglass kit again")
    if not st.get("kit_made"):
        return 1, "no kit yet: sudo hb breakglass kit"
    files = []
    if st.get("kit_dir") and os.path.exists(st["kit_dir"]):
        files.append(f"kit files still on the server: {st['kit_dir']} (copy them off, then delete)")
    old = [d for d in st.get("old_kit_dirs", []) if os.path.exists(d)]
    if old:
        files.append(f"earlier kits' files still on the server: {', '.join(old)} (no longer working; delete)")
    if files:
        return 1, "; ".join(files)
    made = st["kit_made"]
    last = st.get("last_login")
    if not last or last < st.get("kit_made_ts", 0):
        return 1, f"kit made {made}, not used yet: log in with it once"
    days = (time.time() - last) / 86400
    if days > int(cfg["breakglass"]["test_days"]):
        return 1, f"kit last used {int(days)} days ago: test it again"
    return 0, f"kit made {made}, last used {datetime.date.fromtimestamp(last)}"


def verdict(cfg):
    user, _ = settings(cfg)
    if not user:
        return 0, "ok: not managed"
    worst, parts = 0, []
    for name, chk, _ in ITEMS:
        rc, line = chk(cfg)
        if rc:
            worst = max(worst, rc)
            parts.append(f"{name}: {line}")
    if worst == 0:
        rc, line = kit_verdict(cfg)
        worst, parts = rc, [line]
    label = {0: "ok", 1: "warn", 2: "fail"}[worst]
    return worst, f"{label}: " + "; ".join(parts)


def do_status(cfg):
    user, _ = settings(cfg)
    if not user:
        print("not managed (no breakglass.user)")
        return 0
    worst = 0
    for name, chk, _ in ITEMS:
        rc, line = chk(cfg)
        worst = max(worst, rc)
        print(f"{['ok', 'todo', 'FAIL'][rc]:<5} {name:<8} {line}")
    rc, line = kit_verdict(cfg)
    print(f"{['ok', 'todo', 'FAIL'][rc]:<5} {'kit':<8} {line}")
    st = load_state()
    if st.get("last_login_via"):
        print(f"      last login {datetime.datetime.fromtimestamp(st['last_login']):%d %b %H:%M}, {st['last_login_via']}")
    return max(worst, rc)


def do_plan(cfg, apply=False, yes=False):
    user, _ = settings(cfg)
    if not user:
        print("not managed (no breakglass.user)")
        return 0
    worst, todo = 0, 0
    for name, chk, fix in ITEMS:
        rc, line = chk(cfg)
        if rc == 0:
            continue
        todo += 1
        print(f"{name}: {line}")
        if rc == 2 or not apply:
            worst = max(worst, rc)
            continue
        if not yes and not util.ask(f"  apply {name}?"):
            worst = max(worst, 1)
            continue
        err = fix(cfg)
        rc, line = chk(cfg)
        print(f"  now: {line}" if not err else f"  failed: {err}")
        worst = max(worst, rc if not err else 2)
    if not todo:
        print("nothing to change")
    return worst


def main(argv):
    verb = argv[1] if len(argv) > 1 else "status"
    if verb in ("help", "-h", "--help"):
        print(__doc__.strip())
        return 0
    if os.geteuid() != 0:
        print("error: run with sudo", file=sys.stderr)
        return 2
    cfg = config.load()
    if verb == "check":
        rc, line = verdict(cfg)
        print(line)
        return rc
    if verb == "status":
        return do_status(cfg)
    if not cfg["breakglass"]["user"]:
        print("not managed (no breakglass.user)")
        return 0
    if verb == "login":
        return do_login(cfg)
    with util.Lock(os.path.join(util.state_dir("breakglass"), "lock")):
        if verb == "plan":
            return do_plan(cfg)
        if verb == "apply":
            return do_plan(cfg, apply=True, yes="--yes" in argv[2:])
        if verb in ("kit", "rotate"):
            to = argv[argv.index("--to") + 1] if "--to" in argv[2:-1] else None
            return do_kit(cfg, to)
    print(__doc__.strip(), file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
