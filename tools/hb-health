#!/usr/bin/python3 -IB
"""hb-health — is the box healthy right now?

  hb health status   one line per check
  hb health check    one-line verdict (exit 0 ok, 1 warn, 2 fail)

Run with sudo: btrfs device errors and NVMe health are root-only (skipped otherwise).
Config ([health] in hb.toml): containers, urls, mounts, registry,
asterisk_container, disk_warn_pct, disk_fail_pct, reboot_fail_days,
cert_warn_days, nvme_wear_warn_pct.
"""
import json
import os
import re
import shutil
import socket
import ssl
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), os.pardir, "lib"))
from hbkit import config  # noqa: E402

OK, WARN, FAIL, SKIP = 0, 1, 2, -1
WORDS = {OK: "ok", WARN: "warn", FAIL: "FAIL", SKIP: "skip"}
KUBECTL = ["/snap/bin/microk8s", "kubectl"]


def run(*cmd, timeout=30):
    """(exit code, stdout) of a command; 127 when missing, 124 on timeout."""
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return p.returncode, p.stdout
    except FileNotFoundError:
        return 127, ""
    except subprocess.TimeoutExpired:
        return 124, ""


def check_reboot(cfg):
    running = os.uname().release
    rc, out = run("rpm", "-q", "--qf", "%{INSTALLTIME} %{VERSION}-%{RELEASE}.%{ARCH}\n", "kernel-core")
    rows = sorted((int(t), v) for t, v in (ln.split() for ln in out.splitlines() if ln.strip())) if rc == 0 else []
    installed, newest = rows[-1] if rows else (0, running)
    rc, _ = run("dnf", "needs-restarting", "-r", timeout=60)
    if newest != running:
        days = (time.time() - installed) / 86400
        detail = f"running kernel {running}, {newest} installed {days:.0f} days ago"
        return (FAIL if days >= cfg["reboot_fail_days"] else WARN), detail
    if rc == 1:
        return WARN, "updated system libraries need a reboot"
    return OK, f"kernel {running}"


def check_raid(cfg):
    try:
        mdstat = open("/proc/mdstat").read()
    except OSError:
        return SKIP, "no /proc/mdstat"
    arrays = re.findall(r"^(md\d+) : .*?\[([U_]+)\]", mdstat, re.M | re.S)
    if not arrays:
        return OK, "no md arrays"
    bad = [name for name, state in arrays if "_" in state]
    if bad:
        return FAIL, "degraded: " + " ".join(bad)
    return OK, " ".join(f"{name}[{state}]" for name, state in arrays)


def check_nvme(cfg):
    if os.geteuid() != 0:
        return SKIP, "needs root"
    rc, out = run("smartctl", "--scan", "-j")
    if rc == 127:
        return SKIP, "smartmontools not installed"
    devices = [d["name"] for d in json.loads(out or "{}").get("devices", []) if d.get("type") == "nvme"]
    if not devices:
        return SKIP, "no NVMe devices"
    sev, notes = OK, []
    for dev in devices:
        rc, out = run("smartctl", "-j", "-H", "-A", dev)
        data = json.loads(out or "{}")
        log = data.get("nvme_smart_health_information_log")
        name = dev.removeprefix("/dev/")
        if not log:
            sev = max(sev, WARN)
            notes.append(f"{name} unreadable")
            continue
        if data.get("smart_status", {}).get("passed") is False or log.get("critical_warning"):
            sev = FAIL
            notes.append(f"{name} critical warning {log.get('critical_warning')}")
        elif log.get("available_spare", 100) < log.get("available_spare_threshold", 0):
            sev = FAIL
            notes.append(f"{name} spare {log['available_spare']}% below threshold")
        elif log.get("media_errors"):
            sev = max(sev, WARN)
            notes.append(f"{name} {log['media_errors']} media errors")
        elif log.get("percentage_used", 0) >= cfg["nvme_wear_warn_pct"]:
            sev = max(sev, WARN)
            notes.append(f"{name} worn {log['percentage_used']}%")
        else:
            notes.append(f"{name} wear {log.get('percentage_used', '?')}%")
    return sev, ", ".join(notes)


def check_btrfs(cfg):
    if os.geteuid() != 0:
        return SKIP, "needs root"
    rc, out = run("btrfs", "device", "stats", "-c", "/")
    if rc == 127:
        return SKIP, "btrfs-progs not installed"
    if rc == 0:
        return OK, "no device errors"
    errors = [ln.strip() for ln in out.splitlines() if not ln.rstrip().endswith(" 0")]
    return FAIL, "; ".join(errors) or "btrfs device stats reported errors"


def check_disk(cfg):
    du = shutil.disk_usage("/")
    pct = round(du.used * 100 / du.total)
    detail = f"/ {pct}% used, {du.free // 2**30} GiB free"
    if pct >= cfg["disk_fail_pct"]:
        return FAIL, detail
    if pct >= cfg["disk_warn_pct"]:
        return WARN, detail
    return OK, detail


def check_mounts(cfg):
    if not cfg["mounts"]:
        return SKIP, "none configured"
    # Read the mount table instead of stat()ing: a dead hard NFS mount would hang us.
    mounted = {line.split()[1] for line in open("/proc/self/mounts")}
    missing = [m for m in cfg["mounts"] if m not in mounted]
    if missing:
        return FAIL, "not mounted: " + " ".join(missing)
    return OK, " ".join(cfg["mounts"])


def check_containers(cfg):
    if not cfg["containers"]:
        return SKIP, "none configured"
    rc, out = run("docker", "inspect", "-f", "{{.Name}} {{.State.Running}}", *cfg["containers"])
    running = {ln.split()[0].lstrip("/") for ln in out.splitlines() if ln.endswith(" true")}
    down = [c for c in cfg["containers"] if c not in running]
    if down:
        return FAIL, "not running: " + " ".join(down)
    return OK, " ".join(cfg["containers"])


def check_k8s(cfg):
    if not os.path.exists(KUBECTL[0]):
        return SKIP, "microk8s not installed"
    rc, out = run(*KUBECTL, "get", "nodes", "--no-headers")
    if rc != 0:
        return FAIL, "API not answering"
    if any(ln.split()[1] != "Ready" for ln in out.splitlines()):
        return FAIL, "node not Ready"
    rc, out = run(*KUBECTL, "get", "pods", "-A", "-o", "json")
    try:
        pods = json.loads(out)["items"] if rc == 0 else None
    except (ValueError, KeyError):
        pods = None
    if pods is None:
        return FAIL, "cannot list pods"
    bad, evicted, fine = pod_states(pods)
    left = (f"; {evicted} evicted pods left over (kubectl delete pod -A --field-selector=status.phase=Failed)"
            if evicted else "")
    if bad:
        return FAIL, "; ".join(bad) + left
    return (WARN if evicted else OK), f"node Ready, {fine} pods fine" + left


def pod_states(pods):
    """([pods that are down, as "ns/name why have/want"], evicted pods, pods fine).

    A pod the kubelet evicted (disk or memory pressure) stays as a Failed record
    after its controller has started a replacement; the replacement shows here on
    its own, so the record itself is only worth a warning."""
    bad, evicted, fine = [], 0, 0
    for p in pods:
        st, meta = p.get("status", {}), p.get("metadata", {})
        phase = st.get("phase")
        if phase == "Succeeded":
            continue
        if phase == "Failed" and st.get("reason") == "Evicted":
            evicted += 1
            continue
        cs = st.get("containerStatuses") or []
        ready = sum(1 for c in cs if c.get("ready"))
        want = len(cs) or len(p.get("spec", {}).get("containers", []))
        if phase == "Running" and cs and ready == want:
            fine += 1
            continue
        why = next((c["state"]["waiting"].get("reason") for c in cs if "waiting" in c.get("state", {})), None)
        bad.append(f"{meta.get('namespace')}/{meta.get('name')} {why or st.get('reason') or phase} {ready}/{want}")
    return bad, evicted, fine


def http_status(url):
    try:
        with urllib.request.urlopen(url, timeout=10) as r:
            return r.status, ""
    except urllib.error.HTTPError as e:
        return e.code, ""
    except (urllib.error.URLError, OSError) as e:
        return 0, str(getattr(e, "reason", e))


def cert_days_left(url):
    """Days until the TLS certificate of an https URL expires (None if not https)."""
    u = urllib.parse.urlsplit(url)
    if u.scheme != "https":
        return None
    ctx = ssl.create_default_context()
    with socket.create_connection((u.hostname, u.port or 443), timeout=10) as sock:
        with ctx.wrap_socket(sock, server_hostname=u.hostname) as tls:
            not_after = ssl.cert_time_to_seconds(tls.getpeercert()["notAfter"])
    return (not_after - time.time()) / 86400


def check_urls(cfg):
    if not cfg["urls"]:
        return SKIP, "none configured"
    bad, expiring = [], []
    for url in cfg["urls"]:
        code, why = http_status(url)
        if code == 0 or code >= 500:
            bad.append(f"{url} {code or why}")
            continue
        days = cert_days_left(url)
        if days is not None and days < cfg["cert_warn_days"]:
            expiring.append(f"{urllib.parse.urlsplit(url).hostname} certificate expires in {days:.0f} days")
    if bad:
        return FAIL, "; ".join(bad + expiring)
    if expiring:
        return WARN, "; ".join(expiring)
    return OK, f"{len(cfg['urls'])} sites answer (TLS verified, certificates good for {cfg['cert_warn_days']}+ days)"


def check_registry(cfg):
    if not cfg["registry"]:
        return SKIP, "none configured"
    code, why = http_status(cfg["registry"])
    if code == 200:
        return OK, cfg["registry"]
    return FAIL, f"{cfg['registry']} {code or why}"


def check_asterisk(cfg):
    c = cfg["asterisk_container"]
    if not c:
        return SKIP, "none configured"
    rc, out = run("docker", "exec", c, "asterisk", "-rx", "pjsip show registrations")
    if rc != 0:
        return FAIL, f"cannot reach Asterisk in {c}"
    rows = [ln for ln in out.splitlines() if re.search(r"\b(Registered|Unregistered|Rejected|Failed|Stopped)\b", ln)]
    down = [ln.split()[0] for ln in rows if " Registered " not in f" {ln} "]
    if down:
        return FAIL, "trunk not registered: " + " ".join(down)
    return OK, f"{len(rows)} trunk registration(s) up"


CHECKS = [
    ("reboot", check_reboot),
    ("raid", check_raid),
    ("nvme", check_nvme),
    ("btrfs", check_btrfs),
    ("disk", check_disk),
    ("mounts", check_mounts),
    ("containers", check_containers),
    ("k8s", check_k8s),
    ("sites", check_urls),
    ("registry", check_registry),
    ("asterisk", check_asterisk),
]


def main(argv):
    verb = argv[1] if len(argv) > 1 else "status"
    if verb not in ("status", "check"):
        print(__doc__.strip(), file=sys.stderr)
        return 2
    cfg = config.load()["health"]
    results = []
    for name, fn in CHECKS:
        try:
            sev, detail = fn(cfg)
        except Exception as e:  # a broken check must not hide the others
            sev, detail = FAIL, f"check crashed: {e.__class__.__name__}: {e}"
        results.append((name, sev, detail))
        if verb == "status":
            print(f"{WORDS[sev]:5} {name:11} {detail}", flush=True)
    worst = max([sev for _, sev, _ in results] + [OK])
    if verb == "check":
        names = lambda s: " ".join(n for n, sev, _ in results if sev == s)  # noqa: E731
        print("fail: " + names(FAIL) if worst == FAIL else "warn: " + names(WARN) if worst == WARN else "ok")
    return worst


if __name__ == "__main__":
    sys.exit(main(sys.argv))
