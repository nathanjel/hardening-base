#!/usr/bin/env bash
# hb-k8s — microk8s plug-in: keep NodePorts off public addresses, keep
# service-account tokens out of pods that never talk to the Kubernetes API,
# stop certificate reissues that restart every container, keep the
# cluster agent (for joining nodes, unused on one box) on localhost, and keep
# microk8s's daemons retrying after a failure instead of giving up.
#
#   hb k8s status        one line per item
#   hb k8s plan          what apply would change (changes nothing)
#   hb k8s apply [--yes] make the changes, asking before each item
#   hb k8s check         one-line verdict (exit 0 ok, 1 pending, 2 broken)
#
# Items come in pairs: the setting, then whether it is live.
#   nodeport       --nodeport-addresses in kube-proxy's args file
#   nodeport_live  kube-proxy's rules match it (fix: restart kubelite, or reboot)
#   tokens         the default service account in each listed namespace doesn't mount tokens
#   tokens_live    no running pod there still carries one (fix: recreate the pods,
#                  only when busy.d says nothing is in progress)
#   certs          microk8s's apiserver-kicker reissues the API server certificate
#                  whenever the host gains an address (a WireGuard interface, a
#                  new docker bridge, docker coming up after boot) and then
#                  restarts every container to load it. Its no-cert-reissue lock
#                  stops that; a certificate about to expire still needs renewing
#                  (this item fails health.cert_warn_days before, so you can pick
#                  the moment: sudo microk8s refresh-certs --cert server.crt).
#   agent          --bind in the cluster agent's args file
#   agent_live     the agent listens there (fix: restart it; pods are unaffected)
#   restart        a systemd drop-in for each daemon in k8s.keep_restarting (e.g.
#                  kubelite, k8s-dqlite, containerd): retry every 10 s with no limit.
#                  snapd's units give up after 5 failures in 10 s, 100 ms apart, so
#                  a full disk for a few minutes left Kubernetes down for good.
#                  Live at once (daemon-reload); nothing restarts.
#
# Config ([k8s] in hb.toml): nodeport_addresses, token_off_namespaces,
# freeze_certs, cluster_agent_bind, keep_restarting.
set -u
source "$(dirname "$(readlink -f "$0")")/../lib/hb.sh"
need_root
need_config

[ "$(cfg k8s.flavour)" = microk8s ] || die "only microk8s is supported"
command -v /snap/bin/microk8s >/dev/null || { echo "ok: microk8s not installed"; exit 0; }

ITEMS=(nodeport nodeport_live tokens tokens_live certs agent agent_live restart)
SNAPDATA=/var/snap/microk8s/current
ARGS=$SNAPDATA/args/kube-proxy
AGENT_ARGS=$SNAPDATA/args/cluster-agent
NO_REISSUE=$SNAPDATA/var/lock/no-cert-reissue
SERVER_CRT=$SNAPDATA/certs/server.crt
k() { /snap/bin/microk8s kubectl "$@"; }

mapfile -t NODEPORT_ADDRS < <(cfg k8s.nodeport_addresses)
mapfile -t TOKEN_OFF_NS < <(cfg k8s.token_off_namespaces)
WANT_NODEPORT="--nodeport-addresses=$(IFS=,; echo "${NODEPORT_ADDRS[*]}")"
FREEZE="$(cfg k8s.freeze_certs)"
AGENT_BIND="$(cfg k8s.cluster_agent_bind)"
mapfile -t KEEP_RESTARTING < <(cfg k8s.keep_restarting)
UNITDIR="${HB_SYSTEMD_DIR:-/etc/systemd/system}"
RESTART_SEC=10
WARN_DAYS="$(cfg health.cert_warn_days)"

# --- nodeport -------------------------------------------------------------------
chk_nodeport() {
  [ ${#NODEPORT_ADDRS[@]} -eq 0 ] && { echo "not managed"; return 0; }
  grep -qxF -- "$WANT_NODEPORT" "$ARGS" && { echo "$WANT_NODEPORT"; return 0; }
  local now
  now="$(grep -- '^--nodeport-addresses=' "$ARGS" || echo "not set (every local address)")"
  echo "$now → $WANT_NODEPORT"; return 1
}
fix_nodeport() {
  keep_copy "$ARGS"
  sed -i '/^--nodeport-addresses=/d' "$ARGS" && echo "$WANT_NODEPORT" >> "$ARGS"
  log "  written; takes effect when kubelite restarts (next item) or at reboot"
}

chk_nodeport_live() {
  [ ${#NODEPORT_ADDRS[@]} -eq 0 ] && { echo "not managed"; return 0; }
  local jump
  jump="$(iptables-save -t nat 2>/dev/null | grep -E -- '^-A KUBE-SERVICES .*-j KUBE-NODEPORTS')"
  [ -z "$jump" ] && { echo "no NodePort rules found; is kube-proxy running?"; return 2; }
  if grep -q -- '--dst-type LOCAL' <<<"$jump"; then
    echo "NodePorts answer on every local address, the public IP included"; return 1
  fi
  echo "NodePorts only on: $(grep -oE -- '-d [0-9./]+' <<<"$jump" | cut -d' ' -f2 | tr '\n' ' ')"
}
fix_nodeport_live() {
  chk_nodeport >/dev/null || { log "apply nodeport first"; return 1; }
  log "  restarting kubelite (API down for about a minute; running pods keep running)"
  snap restart microk8s.daemon-kubelite || return 1
  wait_node_ready
}

wait_node_ready() {
  local i
  for i in $(seq 60); do
    k get nodes --no-headers 2>/dev/null | grep -qw Ready && return 0
    sleep 3
  done
  log "  node not Ready after 3 minutes"; return 1
}

# --- tokens ---------------------------------------------------------------------
chk_tokens() {
  [ ${#TOKEN_OFF_NS[@]} -eq 0 ] && { echo "not managed"; return 0; }
  local ns val pending=()
  for ns in "${TOKEN_OFF_NS[@]}"; do
    val="$(k get serviceaccount default -n "$ns" -o jsonpath='{.automountServiceAccountToken}' 2>/dev/null)" \
      || { echo "namespace $ns: cannot read its default service account"; return 2; }
    [ "$val" = false ] || pending+=("$ns")
  done
  [ ${#pending[@]} -eq 0 ] && { echo "token mounting off in: ${TOKEN_OFF_NS[*]}"; return 0; }
  echo "default service account mounts tokens in: ${pending[*]}"; return 1
}
fix_tokens() {
  local ns
  for ns in "${TOKEN_OFF_NS[@]}"; do
    k patch serviceaccount default -n "$ns" -p '{"automountServiceAccountToken": false}' >/dev/null || return 1
  done
  log "  pods pick this up when they are recreated (next item)"
}

# pods_with_token NS — running pods in NS that have a service-account token volume
pods_with_token() {
  k get pods -n "$1" --field-selector=status.phase=Running -o jsonpath='{range .items[*]}{.metadata.name}{" "}{.spec.volumes[*].projected.sources[*].serviceAccountToken.path}{"\n"}{end}' \
    | awk 'NF > 1 {print $1}'
}

chk_tokens_live() {
  [ ${#TOKEN_OFF_NS[@]} -eq 0 ] && { echo "not managed"; return 0; }
  local ns n total=0 where=()
  for ns in "${TOKEN_OFF_NS[@]}"; do
    n="$(pods_with_token "$ns" | wc -l)"
    [ "$n" -gt 0 ] && { where+=("$ns:$n"); total=$((total + n)); }
  done
  [ $total -eq 0 ] && { echo "no running pod carries a token in: ${TOKEN_OFF_NS[*]}"; return 0; }
  echo "$total running pods still carry a token (${where[*]})"; return 1
}
fix_tokens_live() {
  chk_tokens >/dev/null || { log "apply tokens first"; return 1; }
  local why ns d
  if ! why="$(hb_busy)"; then log "  not now: $why"; return 1; fi
  for ns in "${TOKEN_OFF_NS[@]}"; do
    [ -n "$(pods_with_token "$ns")" ] || continue
    for d in $(k get deploy -n "$ns" -o jsonpath='{.items[*].metadata.name}'); do
      restart_deploy "$ns" "$d" || return 1
    done
  done
  # old pods count as Running until they finish terminating
  local i
  for i in $(seq 30); do
    chk_tokens_live >/dev/null && return 0
    sleep 2
  done
}

# restart_deploy NS NAME — recreate a deployment's pods without ever running two
# copies against a ReadWriteOnce volume: those get scaled to 0 and back unless
# the deployment already uses the Recreate strategy.
restart_deploy() {
  local ns="$1" d="$2" strategy replicas claim rwo=0 sel i
  strategy="$(k get deploy "$d" -n "$ns" -o jsonpath='{.spec.strategy.type}')"
  for claim in $(k get deploy "$d" -n "$ns" -o jsonpath='{.spec.template.spec.volumes[*].persistentVolumeClaim.claimName}'); do
    k get pvc "$claim" -n "$ns" -o jsonpath='{.spec.accessModes[*]}' | grep -qw ReadWriteOnce && rwo=1
  done
  if [ "$strategy" != Recreate ] && [ $rwo = 1 ]; then
    log "  $ns/$d: ReadWriteOnce volume with $strategy, so scaling to 0 and back"
    replicas="$(k get deploy "$d" -n "$ns" -o jsonpath='{.spec.replicas}')"
    sel="$(k get deploy "$d" -n "$ns" -o go-template='{{range $k, $v := .spec.selector.matchLabels}}{{$k}}={{$v}},{{end}}')"
    k scale deploy "$d" -n "$ns" --replicas=0 >/dev/null || return 1
    for i in $(seq 90); do
      [ -z "$(k get pods -n "$ns" -l "${sel%,}" -o name 2>/dev/null)" ] && break
      sleep 2
    done
    k scale deploy "$d" -n "$ns" --replicas="$replicas" >/dev/null || return 1
  else
    log "  $ns/$d: rollout restart ($strategy)"
    k rollout restart deploy "$d" -n "$ns" >/dev/null || return 1
  fi
  k rollout status deploy "$d" -n "$ns" --timeout=300s >/dev/null || { log "  $ns/$d did not become ready"; return 1; }
}

# --- certs ----------------------------------------------------------------------
chk_certs() {
  [ "$FREEZE" = true ] || { echo "not managed"; return 0; }
  [ -e "$NO_REISSUE" ] || { echo "will stop microk8s reissuing its certificate (and restarting every container) when an address appears"; return 1; }
  local end days
  end="$(openssl x509 -in "$SERVER_CRT" -noout -enddate 2>/dev/null | cut -d= -f2)"
  [ -n "$end" ] || { echo "frozen, but $SERVER_CRT is unreadable"; return 2; }
  days=$(( ($(date -d "$end" +%s) - $(date +%s)) / 86400 ))
  if [ "$days" -lt "$WARN_DAYS" ]; then
    echo "API certificate expires in $days days; renew at a quiet time: sudo microk8s refresh-certs --cert server.crt (restarts every container)"
    return 2
  fi
  echo "frozen; API certificate valid for $days more days"
}
fix_certs() {
  : > "$NO_REISSUE" && chmod 660 "$NO_REISSUE" && { chgrp microk8s "$NO_REISSUE" 2>/dev/null || true; }
}

# --- agent ----------------------------------------------------------------------
chk_agent() {
  [ -z "$AGENT_BIND" ] && { echo "not managed"; return 0; }
  grep -qxF -- "--bind $AGENT_BIND" "$AGENT_ARGS" && { echo "--bind $AGENT_BIND"; return 0; }
  echo "$(grep -- '^--bind ' "$AGENT_ARGS" || echo 'no --bind') → --bind $AGENT_BIND"; return 1
}
fix_agent() {
  keep_copy "$AGENT_ARGS"
  sed -i '/^--bind /d' "$AGENT_ARGS" && echo "--bind $AGENT_BIND" >> "$AGENT_ARGS" || return 1
  log "  written; takes effect when the cluster agent restarts (next item)"
}

agent_listening() { ss -ltnH "sport = :${AGENT_BIND##*:}" 2>/dev/null | awk '{print $4}' | sort -u | paste -sd' '; }
chk_agent_live() {
  [ -z "$AGENT_BIND" ] && { echo "not managed"; return 0; }
  local have; have="$(agent_listening)"
  [ -z "$have" ] && { echo "nothing listens on port ${AGENT_BIND##*:}; is the cluster agent running?"; return 2; }
  [ "$have" = "$AGENT_BIND" ] && { echo "listening on $AGENT_BIND only"; return 0; }
  echo "listening on $have → $AGENT_BIND"; return 1
}
fix_agent_live() {
  chk_agent >/dev/null || { log "  apply agent first"; return 1; }
  snap restart microk8s.daemon-cluster-agent >/dev/null || return 1
  local i
  for i in $(seq 15); do [ "$(agent_listening)" = "$AGENT_BIND" ] && return 0; sleep 2; done
  log "  the cluster agent isn't listening on $AGENT_BIND after 30 s"; return 1
}

# --- restart --------------------------------------------------------------------
restart_unit()   { echo "snap.microk8s.daemon-$1.service"; }
restart_dropin() { echo "$UNITDIR/$(restart_unit "$1").d/10-hb-keep-restarting.conf"; }
restart_text() {
  printf '%s\n' "# Managed by hb k8s (k8s.keep_restarting); changes made here are overwritten." \
    "# Retry every ${RESTART_SEC} s for as long as it takes, instead of giving up after 5 quick failures." \
    "[Unit]" "StartLimitIntervalSec=0" "[Service]" "RestartSec=${RESTART_SEC}s"
}
# what systemd has loaded for a unit: "<start limit interval> <restart delay>"
restart_loaded() {
  systemctl show "$(restart_unit "$1")" -p StartLimitIntervalUSec -p RestartUSec 2>/dev/null \
    | awk -F= '{v[$1]=$2} END {print v["StartLimitIntervalUSec"], v["RestartUSec"]}'
}
chk_restart() {
  [ ${#KEEP_RESTARTING[@]} -eq 0 ] && { echo "not managed"; return 0; }
  local d todo=()
  for d in "${KEEP_RESTARTING[@]}"; do
    [[ $d =~ ^[a-z0-9-]+$ ]] || { echo "k8s.keep_restarting: '$d' is not a daemon name (e.g. kubelite)"; return 2; }
    if [ "$(cat "$(restart_dropin "$d")" 2>/dev/null)" != "$(restart_text)" ]; then
      todo+=("$d: no drop-in"); continue
    fi
    [ "$(restart_loaded "$d")" = "0 ${RESTART_SEC}s" ] || todo+=("$d: not loaded ($(restart_loaded "$d"))")
  done
  [ ${#todo[@]} -eq 0 ] && { echo "${KEEP_RESTARTING[*]}: retry every ${RESTART_SEC} s, no limit"; return 0; }
  local out; out="$(printf '%s; ' "${todo[@]}")"; echo "${out%; }"; return 1
}
fix_restart() {
  local d f
  for d in "${KEEP_RESTARTING[@]}"; do
    f="$(restart_dropin "$d")"
    keep_copy "$f"
    mkdir -p "$(dirname "$f")" && chmod 755 "$(dirname "$f")" && restart_text > "$f" && chmod 644 "$f" || return 1
  done
  systemctl daemon-reload
}

item_main "$@"
