#!/usr/bin/env bash
# hb-k8s — microk8s plug-in: keep NodePorts off public addresses, keep
# service-account tokens out of pods that never talk to the Kubernetes API,
# stop certificate reissues that restart every container, keep the
# cluster agent (for joining nodes, unused on one box) on localhost, keep
# microk8s's daemons retrying after a failure instead of giving up, keep the
# microk8s and kubectl commands root runs from ending with someone else's session,
# and keep pods away from the instance metadata service (and the instance role).
#
#   hb k8s status        one line per item
#   hb k8s plan          what apply would change (changes nothing)
#   hb k8s apply [--yes] make the changes, asking before each item
#   hb k8s check         one-line verdict (exit 0 ok, 1 pending, 2 broken)
#
# Items come in pairs: the setting, then whether it is live.
#   nodeport       --nodeport-addresses in kube-proxy's args file
#   nodeport_live  kube-proxy's rules match it (fix: restart kubelite, or reboot)
#   tokens         the default service account in each listed namespace doesn't mount tokens
#   tokens_live    no running pod there still carries one (fix: recreate the pods,
#                  only when busy.d says nothing is in progress)
#   certs          microk8s's apiserver-kicker reissues the API server certificate
#                  whenever the host gains an address (a WireGuard interface, a
#                  new docker bridge, docker coming up after boot) and then
#                  restarts every container to load it. Its no-cert-reissue lock
#                  stops that; a certificate about to expire still needs renewing
#                  (this item fails health.cert_warn_days before, so you can pick
#                  the moment: sudo microk8s refresh-certs --cert server.crt).
#   agent          --bind in the cluster agent's args file
#   agent_live     the agent listens there (fix: restart it; pods are unaffected)
#   restart        a systemd drop-in for each daemon in k8s.keep_restarting (e.g.
#                  kubelite, k8s-dqlite, containerd): retry every 10 s with no limit.
#                  snapd's units give up after 5 failures in 10 s, 100 ms apart, so
#                  a full disk for a few minutes left Kubernetes down for good.
#                  Live at once (daemon-reload); nothing restarts.
#   linger         root lingers (loginctl enable-linger root): root's user manager runs
#                  from boot, not only while a root session is open. snap runs each
#                  microk8s and kubectl command in a scope under that manager whenever it
#                  runs, and the manager stops 10 s after the last root session ends (a
#                  root cron job's, or a sudo run by a service), ending those commands
#                  (SIGTERM): hb's dumps and checks, and any other service's. Not done
#                  where systemd-oomd watches user@.service, as it may end what runs
#                  there under memory pressure. Never undone here: loginctl
#                  disable-linger root stops the manager, ending what runs in it.
#   metadata       nft table inet hb_metadata drops what pods and containers send to the
#                  instance metadata service (169.254.169.254, fd00:ec2::254): what the
#                  host forwards, and what host-network pods send (matched by the cgroup the
#                  kubelet puts every pod in, kubepods). So no pod gets the instance role's
#                  credentials, whatever the hop limit; the host's own programs still reach
#                  it. hb-metadata-block.service loads it in one transaction before containerd
#                  and kubelite start, making the cgroup if the kubelet hasn't yet, and again
#                  whenever kubelite restarts. It fails closed: drop-ins let containerd and
#                  kubelite start only while the table is loaded. nftables.service no longer
#                  flushes the whole ruleset (on stop, reload, or the restart a package update
#                  does); it loads its file together with hb's table in one transaction, and
#                  that file must change nothing (hb loads it into a network namespace of its
#                  own, seeded with this node's tables, to see). A hand-run `nft flush
#                  ruleset` still drops the table; the check shows it. Not with the systemd
#                  cgroup driver (hb can't make its cgroup first). Not covered: host-network
#                  containers outside kubepods (docker run --network host), and a proxy on
#                  the host that fetches URLs for pods. Undone by hand: disable the unit,
#                  remove the three drop-ins, daemon-reload, nft delete table inet hb_metadata.
#   metadata_live  a pod's request to the metadata service is dropped by hb's rule: from the
#                  network of a pod running here (nsenter), curl (no proxy, no curlrc) opens a
#                  connection to it from a port picked for this one try; it must time out while
#                  a counter hb puts in its chain for just that address and port (and takes out
#                  again) rises. One try at a time. An answer means a pod can reach the role
#                  (broken: an eBPF dataplane routing past the host's hooks, say); anything else
#                  (a refusal, a timeout without the count) isn't proof. It never gets a token,
#                  so it fetches no credentials. (fix: wait for a pod, up to 60 s)
#
# Config ([k8s] in hb.toml): nodeport_addresses, token_off_namespaces,
# freeze_certs, cluster_agent_bind, keep_restarting, linger_root, block_metadata.
set -u
source "$(dirname "$(readlink -f "$0")")/../lib/hb.sh"
need_root
need_config

[ "$(cfg k8s.flavour)" = microk8s ] || die "only microk8s is supported"
MK="${HB_MICROK8S:-/snap/bin/microk8s}"
command -v "$MK" >/dev/null || { echo "ok: microk8s not installed"; exit 0; }

ITEMS=(nodeport nodeport_live tokens tokens_live certs agent agent_live restart linger metadata metadata_live)
SNAPDATA="${HB_SNAPDATA:-/var/snap/microk8s/current}"
ARGS=$SNAPDATA/args/kube-proxy
AGENT_ARGS=$SNAPDATA/args/cluster-agent
NO_REISSUE=$SNAPDATA/var/lock/no-cert-reissue
SERVER_CRT=$SNAPDATA/certs/server.crt
k() { "$MK" kubectl "$@"; }

mapfile -t NODEPORT_ADDRS < <(cfg k8s.nodeport_addresses)
mapfile -t TOKEN_OFF_NS < <(cfg k8s.token_off_namespaces)
WANT_NODEPORT="--nodeport-addresses=$(IFS=,; echo "${NODEPORT_ADDRS[*]}")"
FREEZE="$(cfg k8s.freeze_certs)"
AGENT_BIND="$(cfg k8s.cluster_agent_bind)"
mapfile -t KEEP_RESTARTING < <(cfg k8s.keep_restarting)
UNITDIR="${HB_SYSTEMD_DIR:-/etc/systemd/system}"
LINGER="$(cfg k8s.linger_root)"
LINGER_DIR="${HB_LINGER_DIR:-/var/lib/systemd/linger}"
METADATA="$(cfg k8s.block_metadata)"
NFT_DIR="${HB_NFT_DIR:-/etc/nftables}"
CGROUP_ROOT="${HB_CGROUP_ROOT:-/sys/fs/cgroup}"
MD_WAIT="${HB_MD_WAIT:-60}"     # seconds metadata_live's fix waits, at most, for a pod to try from
PROC="${HB_PROC:-/proc}"
RESTART_SEC=10
WARN_DAYS="$(cfg health.cert_warn_days)"

# --- nodeport -------------------------------------------------------------------
chk_nodeport() {
  [ ${#NODEPORT_ADDRS[@]} -eq 0 ] && { echo "not managed"; return 0; }
  grep -qxF -- "$WANT_NODEPORT" "$ARGS" && { echo "$WANT_NODEPORT"; return 0; }
  local now
  now="$(grep -- '^--nodeport-addresses=' "$ARGS" || echo "not set (every local address)")"
  echo "$now → $WANT_NODEPORT"; return 1
}
fix_nodeport() {
  keep_copy "$ARGS"
  sed -i '/^--nodeport-addresses=/d' "$ARGS" && echo "$WANT_NODEPORT" >> "$ARGS"
  log "  written; takes effect when kubelite restarts (next item) or at reboot"
}

chk_nodeport_live() {
  [ ${#NODEPORT_ADDRS[@]} -eq 0 ] && { echo "not managed"; return 0; }
  local jump
  jump="$(iptables-save -t nat 2>/dev/null | grep -E -- '^-A KUBE-SERVICES .*-j KUBE-NODEPORTS')"
  [ -z "$jump" ] && { echo "no NodePort rules found; is kube-proxy running?"; return 2; }
  if grep -q -- '--dst-type LOCAL' <<<"$jump"; then
    echo "NodePorts answer on every local address, the public IP included"; return 1
  fi
  echo "NodePorts only on: $(grep -oE -- '-d [0-9./]+' <<<"$jump" | cut -d' ' -f2 | tr '\n' ' ')"
}
fix_nodeport_live() {
  chk_nodeport >/dev/null || { log "apply nodeport first"; return 1; }
  log "  restarting kubelite (API down for about a minute; running pods keep running)"
  snap restart microk8s.daemon-kubelite || return 1
  wait_node_ready
}

wait_node_ready() {
  local i
  for i in $(seq 60); do
    k get nodes --no-headers 2>/dev/null | grep -qw Ready && return 0
    sleep 3
  done
  log "  node not Ready after 3 minutes"; return 1
}

# --- tokens ---------------------------------------------------------------------
chk_tokens() {
  [ ${#TOKEN_OFF_NS[@]} -eq 0 ] && { echo "not managed"; return 0; }
  local ns val pending=()
  for ns in "${TOKEN_OFF_NS[@]}"; do
    val="$(k get serviceaccount default -n "$ns" -o jsonpath='{.automountServiceAccountToken}' 2>/dev/null)" \
      || { echo "namespace $ns: cannot read its default service account"; return 2; }
    [ "$val" = false ] || pending+=("$ns")
  done
  [ ${#pending[@]} -eq 0 ] && { echo "token mounting off in: ${TOKEN_OFF_NS[*]}"; return 0; }
  echo "default service account mounts tokens in: ${pending[*]}"; return 1
}
fix_tokens() {
  local ns
  for ns in "${TOKEN_OFF_NS[@]}"; do
    k patch serviceaccount default -n "$ns" -p '{"automountServiceAccountToken": false}' >/dev/null || return 1
  done
  log "  pods pick this up when they are recreated (next item)"
}

# pods_with_token NS — running pods in NS that have a service-account token volume
pods_with_token() {
  k get pods -n "$1" --field-selector=status.phase=Running -o jsonpath='{range .items[*]}{.metadata.name}{" "}{.spec.volumes[*].projected.sources[*].serviceAccountToken.path}{"\n"}{end}' \
    | awk 'NF > 1 {print $1}'
}

chk_tokens_live() {
  [ ${#TOKEN_OFF_NS[@]} -eq 0 ] && { echo "not managed"; return 0; }
  local ns n total=0 where=()
  for ns in "${TOKEN_OFF_NS[@]}"; do
    n="$(pods_with_token "$ns" | wc -l)"
    [ "$n" -gt 0 ] && { where+=("$ns:$n"); total=$((total + n)); }
  done
  [ $total -eq 0 ] && { echo "no running pod carries a token in: ${TOKEN_OFF_NS[*]}"; return 0; }
  echo "$total running pods still carry a token (${where[*]})"; return 1
}
fix_tokens_live() {
  chk_tokens >/dev/null || { log "apply tokens first"; return 1; }
  local why ns d
  if ! why="$(hb_busy)"; then log "  not now: $why"; return 1; fi
  for ns in "${TOKEN_OFF_NS[@]}"; do
    [ -n "$(pods_with_token "$ns")" ] || continue
    for d in $(k get deploy -n "$ns" -o jsonpath='{.items[*].metadata.name}'); do
      restart_deploy "$ns" "$d" || return 1
    done
  done
  # old pods count as Running until they finish terminating
  local i
  for i in $(seq 30); do
    chk_tokens_live >/dev/null && return 0
    sleep 2
  done
}

# restart_deploy NS NAME — recreate a deployment's pods without ever running two
# copies against a ReadWriteOnce volume: those get scaled to 0 and back unless
# the deployment already uses the Recreate strategy.
restart_deploy() {
  local ns="$1" d="$2" strategy replicas claim rwo=0 sel i
  strategy="$(k get deploy "$d" -n "$ns" -o jsonpath='{.spec.strategy.type}')"
  for claim in $(k get deploy "$d" -n "$ns" -o jsonpath='{.spec.template.spec.volumes[*].persistentVolumeClaim.claimName}'); do
    k get pvc "$claim" -n "$ns" -o jsonpath='{.spec.accessModes[*]}' | grep -qw ReadWriteOnce && rwo=1
  done
  if [ "$strategy" != Recreate ] && [ $rwo = 1 ]; then
    log "  $ns/$d: ReadWriteOnce volume with $strategy, so scaling to 0 and back"
    replicas="$(k get deploy "$d" -n "$ns" -o jsonpath='{.spec.replicas}')"
    sel="$(k get deploy "$d" -n "$ns" -o go-template='{{range $k, $v := .spec.selector.matchLabels}}{{$k}}={{$v}},{{end}}')"
    k scale deploy "$d" -n "$ns" --replicas=0 >/dev/null || return 1
    for i in $(seq 90); do
      [ -z "$(k get pods -n "$ns" -l "${sel%,}" -o name 2>/dev/null)" ] && break
      sleep 2
    done
    k scale deploy "$d" -n "$ns" --replicas="$replicas" >/dev/null || return 1
  else
    log "  $ns/$d: rollout restart ($strategy)"
    k rollout restart deploy "$d" -n "$ns" >/dev/null || return 1
  fi
  k rollout status deploy "$d" -n "$ns" --timeout=300s >/dev/null || { log "  $ns/$d did not become ready"; return 1; }
}

# --- certs ----------------------------------------------------------------------
chk_certs() {
  [ "$FREEZE" = true ] || { echo "not managed"; return 0; }
  [ -e "$NO_REISSUE" ] || { echo "will stop microk8s reissuing its certificate (and restarting every container) when an address appears"; return 1; }
  local end days
  end="$(openssl x509 -in "$SERVER_CRT" -noout -enddate 2>/dev/null | cut -d= -f2)"
  [ -n "$end" ] || { echo "frozen, but $SERVER_CRT is unreadable"; return 2; }
  days=$(( ($(date -d "$end" +%s) - $(date +%s)) / 86400 ))
  if [ "$days" -lt "$WARN_DAYS" ]; then
    echo "API certificate expires in $days days; renew at a quiet time: sudo microk8s refresh-certs --cert server.crt (restarts every container)"
    return 2
  fi
  echo "frozen; API certificate valid for $days more days"
}
fix_certs() {
  : > "$NO_REISSUE" && chmod 660 "$NO_REISSUE" && { chgrp microk8s "$NO_REISSUE" 2>/dev/null || true; }
}

# --- agent ----------------------------------------------------------------------
chk_agent() {
  [ -z "$AGENT_BIND" ] && { echo "not managed"; return 0; }
  grep -qxF -- "--bind $AGENT_BIND" "$AGENT_ARGS" && { echo "--bind $AGENT_BIND"; return 0; }
  echo "$(grep -- '^--bind ' "$AGENT_ARGS" || echo 'no --bind') → --bind $AGENT_BIND"; return 1
}
fix_agent() {
  keep_copy "$AGENT_ARGS"
  sed -i '/^--bind /d' "$AGENT_ARGS" && echo "--bind $AGENT_BIND" >> "$AGENT_ARGS" || return 1
  log "  written; takes effect when the cluster agent restarts (next item)"
}

agent_listening() { ss -ltnH "sport = :${AGENT_BIND##*:}" 2>/dev/null | awk '{print $4}' | sort -u | paste -sd' '; }
chk_agent_live() {
  [ -z "$AGENT_BIND" ] && { echo "not managed"; return 0; }
  local have; have="$(agent_listening)"
  [ -z "$have" ] && { echo "nothing listens on port ${AGENT_BIND##*:}; is the cluster agent running?"; return 2; }
  [ "$have" = "$AGENT_BIND" ] && { echo "listening on $AGENT_BIND only"; return 0; }
  echo "listening on $have → $AGENT_BIND"; return 1
}
fix_agent_live() {
  chk_agent >/dev/null || { log "  apply agent first"; return 1; }
  snap restart microk8s.daemon-cluster-agent >/dev/null || return 1
  local i
  for i in $(seq 15); do [ "$(agent_listening)" = "$AGENT_BIND" ] && return 0; sleep 2; done
  log "  the cluster agent isn't listening on $AGENT_BIND after 30 s"; return 1
}

# --- restart --------------------------------------------------------------------
restart_unit()   { echo "snap.microk8s.daemon-$1.service"; }
restart_dropin() { echo "$UNITDIR/$(restart_unit "$1").d/10-hb-keep-restarting.conf"; }
restart_text() {
  printf '%s\n' "# Managed by hb k8s (k8s.keep_restarting); changes made here are overwritten." \
    "# Retry every ${RESTART_SEC} s for as long as it takes, instead of giving up after 5 quick failures." \
    "[Unit]" "StartLimitIntervalSec=0" "[Service]" "RestartSec=${RESTART_SEC}s"
}
# what systemd has loaded for a unit: "<start limit interval> <restart delay>"
restart_loaded() {
  systemctl show "$(restart_unit "$1")" -p StartLimitIntervalUSec -p RestartUSec 2>/dev/null \
    | awk -F= '{v[$1]=$2} END {print v["StartLimitIntervalUSec"], v["RestartUSec"]}'
}
chk_restart() {
  [ ${#KEEP_RESTARTING[@]} -eq 0 ] && { echo "not managed"; return 0; }
  local d todo=()
  for d in "${KEEP_RESTARTING[@]}"; do
    [[ $d =~ ^[a-z0-9-]+$ ]] || { echo "k8s.keep_restarting: '$d' is not a daemon name (e.g. kubelite)"; return 2; }
    if [ "$(cat "$(restart_dropin "$d")" 2>/dev/null)" != "$(restart_text)" ]; then
      todo+=("$d: no drop-in"); continue
    fi
    [ "$(restart_loaded "$d")" = "0 ${RESTART_SEC}s" ] || todo+=("$d: not loaded ($(restart_loaded "$d"))")
  done
  [ ${#todo[@]} -eq 0 ] && { echo "${KEEP_RESTARTING[*]}: retry every ${RESTART_SEC} s, no limit"; return 0; }
  local out; out="$(printf '%s; ' "${todo[@]}")"; echo "${out%; }"; return 1
}
fix_restart() {
  local d f
  for d in "${KEEP_RESTARTING[@]}"; do
    f="$(restart_dropin "$d")"
    keep_copy "$f"
    mkdir -p "$(dirname "$f")" && chmod 755 "$(dirname "$f")" && restart_text > "$f" && chmod 644 "$f" || return 1
  done
  systemctl daemon-reload
}

# --- linger ---------------------------------------------------------------------
manager_active() { [ "$(systemctl is-active user@0.service 2>/dev/null)" = active ]; }
oomd_watches_user() {
  [ "$(systemctl is-active systemd-oomd.service 2>/dev/null)" = active ] &&
    [ "$(systemctl show user@0.service -p ManagedOOMMemoryPressure --value 2>/dev/null)" = kill ]
}
chk_linger() {
  [ "$LINGER" = true ] || { echo "not managed"; return 0; }
  if oomd_watches_user; then
    echo "systemd-oomd ends processes in root's user manager under memory pressure (user@.service ManagedOOMMemoryPressure=kill), so root shouldn't linger here"
    return 2
  fi
  [ -e "$LINGER_DIR/root" ] || { echo "root's user manager stops after each root session, ending the microk8s and kubectl commands snap started in it"; return 1; }
  manager_active || { echo "root lingers, but its user manager isn't running"; return 1; }
  echo "root lingers: its user manager runs from boot, so no root session ending ends a command"
}
fix_linger() {
  loginctl enable-linger root || return 1
  # logind starts the manager only for a user it hasn't started yet: after a systemctl stop
  # user@0.service while a root session is still open, it counts root as started. So start it.
  systemctl start --no-block user@0.service || return 1
  local i
  for i in $(seq 30); do
    manager_active && return 0
    sleep 1
  done
  log "  root's user manager didn't start within 30 s (systemctl status user@0.service)"; return 1
}

# --- metadata -------------------------------------------------------------------
MD_UNIT=hb-metadata-block.service
MD_RULES=$NFT_DIR/hb-metadata.nft
MD_SERVICE_LOAD=$NFT_DIR/hb-nftables-service.nft   # what nftables.service loads instead of its file alone
MD_CG=kubepods        # where the kubelet puts every pod with the cgroupfs driver (microk8s's)
MD_V4=169.254.169.254
MD_V6=fd00:ec2::254
MD_NFT_DROPIN=$UNITDIR/nftables.service.d/10-hb-keep-tables.conf
md_gate_dropin() { echo "$UNITDIR/snap.microk8s.daemon-$1.service.d/10-hb-metadata.conf"; }

md_rules_text() {
  printf '%s\n' "# Managed by hb k8s (k8s.block_metadata); changes made here are overwritten." \
    "# One transaction: it replaces the whole table, or leaves the one loaded before if it fails." \
    "# What the host forwards comes from pods and containers; host-network pods send from the host" \
    "# itself and are matched by the cgroup the kubelet puts every pod in." \
    "table inet hb_metadata" "delete table inet hb_metadata" "table inet hb_metadata {" \
    "	chain forward {" "		type filter hook forward priority -10; policy accept;" \
    "		ip daddr $MD_V4 counter drop comment \"pods and containers\"" \
    "		ip6 daddr $MD_V6 counter drop comment \"pods and containers\"" "	}" \
    "	chain output {" "		type filter hook output priority -10; policy accept;" \
    "		ip daddr $MD_V4 socket cgroupv2 level 1 \"$MD_CG\" counter drop comment \"host-network pods\"" \
    "		ip6 daddr $MD_V6 socket cgroupv2 level 1 \"$MD_CG\" counter drop comment \"host-network pods\"" \
    "	}" "}"
}
md_unit_text() {
  printf '%s\n' "# Managed by hb k8s (k8s.block_metadata); changes made here are overwritten." \
    "[Unit]" "Description=hb: keep pods and containers away from the instance metadata service" \
    "# Loaded before containerd and kubelite start (their hb drop-ins wait for it), so before any" \
    "# pod runs, and again whenever kubelite or nftables.service restarts." \
    "After=nftables.service" \
    "Before=snap.microk8s.daemon-containerd.service snap.microk8s.daemon-kubelite.service" \
    "PartOf=nftables.service snap.microk8s.daemon-kubelite.service" "" \
    "[Service]" "Type=oneshot" "RemainAfterExit=yes" \
    "# The rules name the pods' cgroup, so it has to exist first; the kubelet uses the one it finds." \
    "ExecStart=/usr/bin/mkdir -p $CGROUP_ROOT/$MD_CG" \
    "ExecStart=/usr/sbin/nft -f $MD_RULES" \
    "# Nothing takes the table away on stop: stopping kubelite leaves its containers running." "" \
    "[Install]" "WantedBy=multi-user.target"
}
md_gate_text() {
  printf '%s\n' "# Managed by hb k8s (k8s.block_metadata); changes made here are overwritten." \
    "# Fails closed: this starts only while hb's metadata block is loaded, so no container runs without it." \
    "[Unit]" "Wants=$MD_UNIT" "After=$MD_UNIT" "" "[Service]" \
    "ExecStartPre=/bin/sh -c '/usr/sbin/nft list chain inet hb_metadata output >/dev/null'"
}
# the file nftables.service loads: nft -f FILE in its own unit file's ExecStart (not the one
# hb's drop-in puts in its place)
nft_service_file() {
  local unit; unit="$(systemctl show nftables.service -p FragmentPath --value 2>/dev/null)"
  [ -f "$unit" ] && sed -nE 's/^ExecStart=.*\/nft -f (\/[^ ]+).*/\1/p' "$unit" | head -1
}
nft_service_present() { [ "$(systemctl show nftables.service -p LoadState --value 2>/dev/null)" = loaded ]; }
md_service_load_text() {   # $1 = nftables.service's file
  printf '%s\n' "# Managed by hb k8s (k8s.block_metadata); changes made here are overwritten." \
    "# What nftables.service loads: its own file, then hb's table, in one transaction." \
    "include \"$1\"" "include \"$MD_RULES\""
}
md_nft_dropin_text() {
  printf '%s\n' "# Managed by hb k8s (k8s.block_metadata); changes made here are overwritten." \
    "# On a Kubernetes node kube-proxy, the CNI and hb keep tables of their own: this service never" \
    "# flushes the whole ruleset, and it loads its file together with hb's table in one transaction." \
    "[Service]" "ExecStartPre=/usr/bin/mkdir -p $CGROUP_ROOT/$MD_CG" \
    "ExecStart=" "ExecStart=/usr/sbin/nft -f $MD_SERVICE_LOAD" \
    "ExecReload=" "ExecReload=/usr/sbin/nft -f $MD_SERVICE_LOAD" "ExecStop="
}
# md_service_file_changes FILE — load FILE in a network namespace of its own, seeded with this
# node's tables (a rule in each), and print what that changed; nothing when it changes nothing.
# Includes and several commands on a line count, as nft itself runs them.
md_service_file_changes() {
  local seed
  seed="$( { nft list tables 2>/dev/null; echo "table inet hb_metadata"; } | sort -u \
    | awk 'NF == 3 && $1 == "table" {printf "add table %s %s\nadd chain %s %s hb_seen\nadd rule %s %s hb_seen counter\n", $2, $3, $2, $3, $2, $3}')"
  unshare --net -- bash -c '
    printf "%s\n" "$1" | nft -f /dev/stdin 2>/dev/null || { echo "a scratch ruleset could not be made"; exit; }
    before="$(nft list ruleset)"
    out="$(nft -f "$2" 2>&1)" || { echo "it does not load: $(head -1 <<<"$out")"; exit; }
    after="$(nft list ruleset)"
    [ "$before" = "$after" ] || diff <(echo "$before") <(echo "$after") | grep -E "^[<>]" | head -3 | tr "\t\n" "  "
  ' _ "$seed" "$1" 2>&1
}
# effective_cmds UNIT SETTING — the commands systemd runs for SETTING (ExecStart, ExecStop, ...)
# after every drop-in, from its own D-Bus property, one per line as JSON: [path, [argv...],
# ignore_errors]. Each argument stays one (systemctl show joins them with spaces, so a command
# quoted wrongly looks the same there); ignore_errors is the - prefix, a path unlike argv[0] the @.
# It fails (and prints nothing to compare) unless every step worked: the unit's object, the
# property read, and a reply of the type systemd serves commands in. A failed read is never "none".
effective_cmds() {
  local reply obj
  reply="$(busctl --json=short call org.freedesktop.systemd1 /org/freedesktop/systemd1 org.freedesktop.systemd1.Manager \
             LoadUnit s "$1" 2>/dev/null)" || return 1
  obj="$(python3 -I -c 'import json, sys
d = json.loads(sys.stdin.read())
if d.get("type") != "o" or len(d.get("data", [])) != 1: sys.exit(1)
print(d["data"][0])' <<<"$reply" 2>/dev/null)" || return 1
  reply="$(busctl --json=short get-property org.freedesktop.systemd1 "$obj" org.freedesktop.systemd1.Service "$2" 2>/dev/null)" || return 1
  python3 -I -c 'import json, sys
d = json.loads(sys.stdin.read())
if d.get("type") != "a(sasbttttuii)" or not isinstance(d.get("data"), list): sys.exit(1)
for c in d["data"]: print(json.dumps([c[0], c[1], c[2]]))' <<<"$reply" 2>/dev/null
}
# md_cmd PATH ARG... — that command as effective_cmds shows it: its own path, failures not ignored
md_cmd() { python3 -I -c 'import json, sys; print(json.dumps([sys.argv[1], sys.argv[1:], False]))' "$@"; }
# md_runs UNIT SETTING=COMMANDS... — each SETTING runs exactly COMMANDS (md_cmd lines; empty: none)
md_runs() {
  local u="$1" a out; shift
  for a in "$@"; do
    out="$(effective_cmds "$u" "${a%%=*}")" || return 1        # read it, or it isn't known to be safe
    [ "$out" = "${a#*=}" ] || return 1
  done
}
md_orders() { systemctl show "$1" -p "$2" --value 2>/dev/null | tr ' ' '\n' | grep -qxF "$MD_UNIT"; }
md_gate_cmd() { md_cmd /bin/sh -c '/usr/sbin/nft list chain inet hb_metadata output >/dev/null'; }
# md_live_ok LISTING — the loaded table drops both addresses in both chains, the output rules
# naming the pods' cgroup (nft prints the cgroup's id once it is gone)
md_live_ok() {
  awk -v cg="\"$MD_CG\"" -v v4="ip daddr $MD_V4 " -v v6="ip6 daddr $MD_V6 " '
    /^[[:space:]]*chain / {c = $2}
    c == "forward" && / drop/ && index($0, v4) {f4 = 1}
    c == "forward" && / drop/ && index($0, v6) {f6 = 1}
    c == "output" && / drop/ && index($0, v4 "socket cgroupv2 level 1 " cg " ") {o4 = 1}
    c == "output" && / drop/ && index($0, v6 "socket cgroupv2 level 1 " cg " ") {o6 = 1}
    END {exit !(f4 && f6 && o4 && o6)}' <<<"$1"
}
md_drops() { grep ' drop' <<<"$1" | grep -oE 'packets [0-9]+' | awk '{n += $2} END {print n + 0}'; }

chk_metadata() {
  [ "$METADATA" = true ] || { echo "not managed"; return 0; }
  command -v nft >/dev/null || { echo "needs nft (dnf install nftables)"; return 2; }
  command -v busctl >/dev/null || { echo "needs busctl (systemd's) to read what systemd will run"; return 2; }
  [ -e "$CGROUP_ROOT/cgroup.controllers" ] || { echo "needs cgroup v2: host-network pods are matched by their cgroup"; return 2; }
  if [ -d "$CGROUP_ROOT/kubepods.slice" ]; then
    echo "the kubelet uses the systemd cgroup driver (kubepods.slice), whose cgroup hb can't make before the kubelet does"; return 2
  fi
  local conf="" changes
  if nft_service_present; then
    conf="$(nft_service_file)"
    [ -n "$conf" ] || { echo "can't tell which file nftables.service loads"; return 2; }
    changes="$(md_service_file_changes "$conf")"
    if [ -n "$changes" ]; then
      echo "nftables.service's file $conf changes the ruleset ($changes): on this node keep firewall rules in a unit of their own, as microk8s-management-firewall does, and leave that file without rules"
      return 2
    fi
  fi
  # the files hb writes, and what systemd will run once every drop-in (a later one too) is applied
  local live d u cmds todo=() none="ExecStartPre= ExecStartPost= ExecStop= ExecStopPost= ExecCondition= ExecReload="
  cmp -s "$MD_RULES" <(md_rules_text) || todo+=("rule file")
  # shellcheck disable=SC2086
  { cmp -s "$UNITDIR/$MD_UNIT" <(md_unit_text) &&
    md_runs "$MD_UNIT" "ExecStart=$(md_cmd /usr/bin/mkdir -p "$CGROUP_ROOT/$MD_CG"; md_cmd /usr/sbin/nft -f "$MD_RULES")" $none; } \
    || todo+=("$MD_UNIT")
  [ "$(systemctl is-enabled "$MD_UNIT" 2>/dev/null)" = enabled ] || todo+=("not loaded at boot")
  for d in containerd kubelite; do
    u="snap.microk8s.daemon-$d.service"
    { cmp -s "$(md_gate_dropin "$d")" <(md_gate_text) && cmds="$(effective_cmds "$u" ExecStartPre)" && grep -qxF "$(md_gate_cmd)" <<<"$cmds" &&
      md_orders "$u" After && md_orders "$u" Wants; } || todo+=("$d may start without it")
  done
  if [ -n "$conf" ]; then
    { cmp -s "$MD_SERVICE_LOAD" <(md_service_load_text "$conf") && cmp -s "$MD_NFT_DROPIN" <(md_nft_dropin_text) &&
      md_runs nftables.service "ExecStart=$(md_cmd /usr/sbin/nft -f "$MD_SERVICE_LOAD")" "ExecReload=$(md_cmd /usr/sbin/nft -f "$MD_SERVICE_LOAD")" \
        "ExecStartPre=$(md_cmd /usr/bin/mkdir -p "$CGROUP_ROOT/$MD_CG")" ExecStartPost= ExecStop= ExecStopPost= ExecCondition=; } \
      || todo+=("nftables.service may flush every table or load without hb's")
  fi
  live="$(nft list table inet hb_metadata 2>/dev/null)"
  if ! md_live_ok "$live"; then
    if [ -z "$live" ]; then todo=("pods can reach the instance metadata service, and with it the instance role" "${todo[@]}")
    else todo=("the loaded rules don't block it all (a pods' cgroup that was made again?)" "${todo[@]}"); fi
  fi
  if [ ${#todo[@]} -gt 0 ]; then local out; out="$(printf '%s; ' "${todo[@]}")"; echo "${out%; }"; return 1; fi
  echo "pods, containers and host-network pods can't reach the instance metadata service, and containerd and kubelite start only with that in place ($(md_drops "$live") packets dropped since it was loaded)"
}
fix_metadata() {
  local d conf=""
  keep_copy "$MD_RULES"; keep_copy "$UNITDIR/$MD_UNIT"; keep_copy "$MD_NFT_DROPIN"; keep_copy "$MD_SERVICE_LOAD"
  for d in containerd kubelite; do keep_copy "$(md_gate_dropin "$d")"; done
  install -d -m 755 "$NFT_DIR" "$UNITDIR" && mkdir -p "$CGROUP_ROOT/$MD_CG" || return 1
  # a rule file nft doesn't take never replaces the one in place
  local tmp; tmp="$(mktemp "$NFT_DIR/.hb-metadata.XXXXXX")" || return 1
  if ! { md_rules_text > "$tmp" && chmod 644 "$tmp" && nft -c -f "$tmp"; }; then
    log "  nft doesn't accept the rules"; rm -f "$tmp"; return 1
  fi
  mv -f "$tmp" "$MD_RULES" || return 1
  nft_service_present && conf="$(nft_service_file)"
  (
    umask 022
    md_unit_text > "$UNITDIR/$MD_UNIT" || exit 1
    for d in containerd kubelite; do
      mkdir -p "$(dirname "$(md_gate_dropin "$d")")" && md_gate_text > "$(md_gate_dropin "$d")" || exit 1
    done
    if [ -n "$conf" ]; then
      md_service_load_text "$conf" > "$MD_SERVICE_LOAD" && nft -c -f "$MD_SERVICE_LOAD" || exit 1
      mkdir -p "${MD_NFT_DROPIN%/*}" && md_nft_dropin_text > "$MD_NFT_DROPIN" || exit 1
    fi
  ) || return 1
  systemctl daemon-reload || return 1
  systemctl enable "$MD_UNIT" >/dev/null 2>&1 || { log "  couldn't enable $MD_UNIT"; return 1; }
  systemctl restart "$MD_UNIT" || { log "  $MD_UNIT didn't load the rules (systemctl status $MD_UNIT)"; return 1; }
}

# up to three pods' network namespaces on this node: "PID" of a process in each, one per namespace
md_pod_netns() {
  local host pid ns seen=" "
  host="$(readlink "$PROC/1/ns/net" 2>/dev/null)"
  find "${HB_POD_CGROUPS:-$CGROUP_ROOT/$MD_CG}" -name cgroup.procs -exec cat {} + 2>/dev/null | while read -r pid; do
    ns="$(readlink "$PROC/$pid/ns/net" 2>/dev/null)" || continue
    [ -n "$ns" ] && [ "$ns" != "$host" ] && [[ $seen != *" $ns "* ]] || continue
    seen+="$ns "; echo "$pid"
    [ "$(wc -w <<<"$seen")" -ge 3 ] && break
  done
}
# md_probe PID SECONDS — try the metadata service from PID's network, within SECONDS: prints
# "blocked" (no answer, and hb's chain saw this very try: a counter for its source address and
# port, put in ahead of the drops for this try alone and taken out after), "answered ...", or
# "unproven WHY". Callers hold the probe lock, so tries never overlap.
md_probe() {
  local pid=$1 t=$2 net="$PROC/$1/ns/net" src port token handle code rc seen curl
  curl="$(command -v curl)"                       # found before env -i empties the environment
  src="$(timeout 3 nsenter --net="$net" -- ip -4 -o route get "$MD_V4" 2>/dev/null | sed -nE 's/.* src ([0-9.]+).*/\1/p')"
  [[ $src =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] || { echo "unproven (no route to it from there)"; return; }
  port=$((61000 + RANDOM % 1000)) token="hb probe $$ $RANDOM"
  nft insert rule inet hb_metadata forward ip saddr "$src" ip daddr "$MD_V4" tcp sport "$port" counter comment "\"$token\"" 2>/dev/null \
    || { echo "unproven (couldn't put its counter in)"; return; }
  handle="$(nft -a list chain inet hb_metadata forward 2>/dev/null | grep -F "comment \"$token\"" | sed -nE 's/.*# handle ([0-9]+).*/\1/p')"
  code="$(timeout "$t" nsenter --net="$net" -- env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin \
            "$curl" -q --noproxy '*' -s -o /dev/null -w '%{http_code}' --local-port "$port" \
            --connect-timeout 2 --max-time $((t - 1)) "http://$MD_V4/latest/meta-data/" 2>/dev/null)"
  rc=$?
  seen="$(nft list chain inet hb_metadata forward 2>/dev/null | grep -F "comment \"$token\"" | grep -oE 'packets [0-9]+' | awk '{print $2}')"
  [ -n "$handle" ] && nft delete rule inet hb_metadata forward handle "$handle" 2>/dev/null
  if [ -n "$code" ] && [ "$code" != 000 ]; then echo "answered HTTP $code"; return; fi
  case $rc in
    52|56) echo "answered (a connection, then nothing)" ;;           # it got as far as the service
    28) if [ "${seen:-0}" -gt 0 ]; then echo blocked; else echo "unproven (no answer, but hb's rule didn't see it)"; fi ;;
    7) echo "unproven (refused by something else)" ;;
    *) echo "unproven (couldn't try: exit $rc)" ;;
  esac
}
chk_metadata_live() {
  [ "$METADATA" = true ] || { echo "not managed"; return 0; }
  local t; for t in nsenter curl ip flock; do command -v $t >/dev/null || { echo "needs $t to try from a pod"; return 2; }; done
  nft list table inet hb_metadata >/dev/null 2>&1 || { echo "not loaded (the metadata item)"; return 1; }
  local pids pid result left why="" tried=0 start=$SECONDS budget="${MD_BUDGET:-20}" lock
  mapfile -t pids < <(md_pod_netns)
  [ ${#pids[@]} -gt 0 ] || { echo "no pod runs here to try from"; return 1; }
  # one try at a time (hb-status's check and one by hand, say); the lock goes with this shell
  mkdir -p "$HB_STATE" && exec {lock}>"$HB_STATE/metadata-probe.lock" && flock -w "$budget" "$lock" \
    || { echo "another try is still running"; return 1; }
  for pid in "${pids[@]}"; do
    left=$((budget - (SECONDS - start)))
    [ "$left" -ge 4 ] || break                       # each try needs 2 s to connect and a little more
    result="$(md_probe "$pid" $((left < 5 ? left : 5)))"
    tried=$((tried + 1))
    case "$result" in
      blocked) echo "a pod's request to the instance metadata service was just dropped by hb's rule"; return 0 ;;
      answered*) echo "a pod reached the instance metadata service ($result, from the network of process $pid): pods can get the instance role"; return 2 ;;
      *) why="${result#unproven }" ;;
    esac
  done
  echo "not confirmed: $tried pods tried, none dropped by hb's rule (last: $why)"; return 1
}
fix_metadata_live() {
  log "  waiting up to ${MD_WAIT} s for a pod to try from"
  local end=$((SECONDS + MD_WAIT)) left rc
  while left=$((end - SECONDS)); [ "$left" -gt 0 ]; do
    ( MD_BUDGET=$left chk_metadata_live >/dev/null ); rc=$?      # its own shell: the lock goes with it
    [ $rc -eq 0 ] && return 0
    [ $rc -eq 2 ] && return 1
    [ $((end - SECONDS)) -gt 1 ] && sleep 1
  done
  return 1
}

item_main "$@"
