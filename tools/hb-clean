#!/usr/bin/python3 -IB
"""hb-clean — free disk space from things that can be rebuilt: build output in
idle projects, stale caches, Docker leftovers.

  hb clean [plan] [TARGET...]        what would go and how much (changes nothing)
  hb clean apply [--yes] [TARGET...] remove it, asking before each action
  hb clean auto                      the daily timer: a plan while clean.dry_run is
                                     true, apply --yes once it is false (docker then
                                     only on clean.heavy_weekday or when the disk
                                     passes health.disk_warn_pct)
  hb clean report                    the last report auto wrote
  hb clean check                     one line from the last report

Targets:
  projects  git repos under clean.project_roots untouched for idle_days: run the
            repo's executable .hb-clean if it has one, else `make clean` if the
            Makefile has that target, else delete its git-ignored build folders
            (clean.build_dirs; .venv after venv_idle_days). Only git-ignored
            folders count, never tracked files, .env* or data/.
  caches    entries in ~/.cache (and ~/.npm/_cacache) untouched for cache_idle_days,
            for each of clean.users
  docker    stopped containers older than docker_container_days, unused images
            older than docker_image_days, build cache above docker_build_cache.
            Volumes are listed, never removed. Only with clean.docker = true.

Everything in a project or a cache runs with its owner's rights, not root's, as the
owner the plan saw: if a folder is swapped for something else after the plan, it is
left alone, and nothing here could reach beyond that owner's files anyway. A repo
owned by root is skipped. A folder holding another user's subfolder (a container's
build output, say) is kept and named in the notes: remove it by hand.

The local image registry (clean.registry_dir) is measured, never cleaned: its
size goes in the report, and the check warns once it passes clean.registry_warn.

Config ([clean] in hb.toml): dry_run, users, project_roots, idle_days,
venv_idle_days, build_dirs, cache_idle_days, docker, docker_container_days,
docker_image_days, docker_build_cache, heavy_weekday (1 = Monday ... 7 = Sunday),
registry_dir, registry_warn.
"""
import datetime
import fnmatch
import glob
import json
import os
import pwd
import re
import shutil
import stat
import subprocess
import sys
import time

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), os.pardir, "lib"))
import hbkit.pyversion  # noqa: E402,F401  (first: re-runs this tool on Python 3.11+ when needed)
from hbkit import config, util  # noqa: E402

TARGETS = ("projects", "caches", "docker")
DAY = 86400


class Action:
    def __init__(self, target, desc, size, fn):
        self.target, self.desc, self.size, self.fn = target, desc, size, fn


def human(n):
    for unit in ("B", "KB", "MB", "GB"):
        if n < 1000:
            return f"{n:.0f} {unit}" if unit == "B" else f"{n:.1f} {unit}"
        n /= 1000
    return f"{n:.1f} TB"


def walk_stats(path, uid=None):
    """(bytes on disk, newest mtime, first folder not owned by uid) of everything under path,
    symlinks not followed. Only folders count as foreign: a folder's owner can delete any file
    in it, but not empty a subfolder of someone else's."""
    total, newest, foreign, stack = 0, 0, None, [path]
    while stack:
        p = stack.pop()
        try:
            st = os.lstat(p)
        except OSError:
            continue
        total += st.st_blocks * 512
        newest = max(newest, st.st_mtime)
        if stat.S_ISDIR(st.st_mode):
            if foreign is None and uid is not None and st.st_uid != uid:
                foreign = p
            try:
                with os.scandir(p) as it:
                    stack.extend(e.path for e in it)
            except OSError:
                pass
    return total, newest, foreign


def inside(path, parent):
    return os.path.realpath(path).startswith(os.path.realpath(parent) + os.sep) and not os.path.islink(path)


def as_user(uid):
    """subprocess options that run a command as uid, in their home. Callers pass the uid the plan
    saw, never one read again from a path that may have been swapped since."""
    pw = pwd.getpwuid(uid)
    env = {"HOME": pw.pw_dir, "USER": pw.pw_name, "LOGNAME": pw.pw_name,
           "PATH": f"{pw.pw_dir}/.local/bin:{pw.pw_dir}/.cargo/bin:/usr/local/bin:/usr/bin",
           "GIT_OPTIONAL_LOCKS": "0"}
    opts = {"env": env, "errors": "surrogateescape"}
    if os.geteuid() == 0:
        opts.update(user=pw.pw_uid, group=pw.pw_gid, extra_groups=os.getgrouplist(pw.pw_name, pw.pw_gid))
    return opts


def unchanged(path, uid):
    """path is still a real folder of uid's, as it was in the plan."""
    try:
        st = os.lstat(path)
    except OSError:
        return False
    return stat.S_ISDIR(st.st_mode) and st.st_uid == uid


def delete_as(uid, path):
    """rm -rf path with uid's rights: None, or the error. A folder its owner made read-only (Go's
    module cache, pnpm) gets its write permission back for a second try."""
    opts = dict(as_user(uid), timeout=3600, cwd="/", stdin=subprocess.DEVNULL)
    rm = ("rm", "-rf", "--one-file-system", "--", path)
    rc, _, err = util.run(*rm, **opts)
    if rc:
        util.run("chmod", "-R", "u+rwx", "--", path, **opts)
        rc, _, err = util.run(*rm, **opts)
    return None if rc == 0 else (err.strip().splitlines() or [f"exit {rc}"])[-1][:200]


def remove(paths, parent, uid):
    """Delete paths with uid's rights, never root's."""
    def fn():
        if not unchanged(parent, uid):
            raise RuntimeError(f"{parent} changed since the plan; left alone")
        for p in paths:
            if not inside(p, parent):
                raise RuntimeError(f"{p} isn't inside {parent} any more; left alone")
            err = delete_as(uid, p)
            if err:
                raise RuntimeError(f"rm {p}: {err}")
        return "removed"
    return fn


# --- projects ----------------------------------------------------------------------

def find_repos(roots, skip):
    seen = set()
    for root in roots:
        for dirpath, dirs, files in os.walk(root):
            if ".git" in dirs or ".git" in files:
                if dirpath not in seen:
                    seen.add(dirpath)
                    yield dirpath
                dirs[:] = []
                continue
            depth = dirpath[len(root):].count(os.sep)
            dirs[:] = [d for d in dirs if depth < 4 and not d.startswith(".") and d not in skip]


def repo_owner(repo):
    """The uid everything in repo runs as, or None: not a real folder, root's, or no known user's."""
    try:
        st = os.lstat(repo)
        pwd.getpwuid(st.st_uid)
    except (OSError, KeyError):
        return None
    return st.st_uid if stat.S_ISDIR(st.st_mode) and st.st_uid != 0 else None


def git_lines(repo, uid, *args):
    rc, out, _ = util.run("git", "-C", repo, *args, "-z", timeout=300, **as_user(uid))
    return [p for p in out.split("\0") if p] if rc == 0 else None


def last_activity(repo, uid):
    files = git_lines(repo, uid, "ls-files", "-co", "--exclude-standard")
    if files is None:
        return None
    newest = 0
    for rel in files + [".git/index", ".git/HEAD", ".git/logs/HEAD"]:
        try:
            newest = max(newest, os.lstat(os.path.join(repo, rel)).st_mtime)
        except OSError:
            pass
    return newest


def build_output(repo, uid, cfg, idle_days):
    """Git-ignored folders in repo that clean.build_dirs (or .venv) names."""
    found = []
    for rel in git_lines(repo, uid, "ls-files", "-o", "-i", "--exclude-standard", "--directory") or []:
        rel = rel.rstrip("/")
        parts = rel.split("/")
        full = os.path.join(repo, rel)
        if any(p == "data" or p.startswith(".env") for p in parts) or not os.path.isdir(full) or os.path.islink(full):
            continue
        name = parts[-1]
        if name == ".venv":
            if idle_days >= cfg["venv_idle_days"]:
                found.append(full)
        elif any(fnmatch.fnmatch(name, pat) for pat in cfg["build_dirs"]):
            found.append(full)
    return found


def has_make_clean(repo, uid):
    """Read by the owner, with a time limit: the Makefile could be anything, a pipe for one."""
    for name in ("GNUmakefile", "makefile", "Makefile"):
        rc, _, _ = util.run("grep", "-qE", r"^clean[[:space:]]*:", "--", os.path.join(repo, name), timeout=30,
                            stdin=subprocess.DEVNULL, **as_user(uid))
        if rc == 0:
            return True
    return False


def run_in(repo, uid, *cmd):
    def fn():
        if not unchanged(repo, uid):
            raise RuntimeError(f"{repo} changed since the plan; left alone")
        rc, out, err = util.run(*cmd, cwd=repo, timeout=900, stdin=subprocess.DEVNULL, **as_user(uid))
        if rc != 0:
            raise RuntimeError(f"{' '.join(cmd)} exited {rc}: {(err.strip().splitlines() or [''])[-1][:200]}")
        return f"ran {' '.join(cmd)}"
    return fn


def plan_projects(cfg, now):
    actions, notes = [], []
    skip = set(cfg["build_dirs"]) | {"node_modules", ".venv"}
    for repo in find_repos(cfg["project_roots"], skip):
        uid = repo_owner(repo)
        if uid is None:
            notes.append(f"{repo}: owned by root or by no known user, skipped")
            continue
        last = last_activity(repo, uid)
        if last is None:
            notes.append(f"{repo}: git can't read it, skipped")
            continue
        idle = (now - last) / DAY
        if idle < cfg["idle_days"]:
            continue
        dirs, size = [], 0
        for d in build_output(repo, uid, cfg, idle):
            used, _, foreign = walk_stats(d, uid)
            if foreign:
                notes.append(f"kept {d}: {foreign} is another user's, and hb clean works with the owner's rights")
            else:
                dirs.append(d)
                size += used
        if not dirs:
            continue
        names = sorted({os.path.basename(d) for d in dirs})
        if os.access(os.path.join(repo, ".hb-clean"), os.X_OK):
            how, fn = "run .hb-clean", run_in(repo, uid, os.path.join(repo, ".hb-clean"))
        elif has_make_clean(repo, uid):
            how, fn = "make clean", run_in(repo, uid, "make", "clean")
        else:
            how, fn = f"delete {', '.join(names)}", remove(dirs, repo, uid)
        actions.append(Action("projects", f"{repo}: {how} (idle {idle:.0f} days, {len(dirs)} build folders)", size, fn))
    return actions, notes


# --- caches ------------------------------------------------------------------------

def plan_caches(cfg, now):
    actions, notes = [], []
    for user in cfg["users"]:
        try:
            pw = pwd.getpwnam(user)
        except KeyError:
            notes.append(f"no user {user}")
            continue
        home, uid = pw.pw_dir, pw.pw_uid
        if not unchanged(home, uid):
            notes.append(f"{home} isn't {user}'s own folder, skipped")
            continue
        base = os.path.join(home, ".cache")
        entries = []
        try:
            entries = [e.path for e in os.scandir(base) if not e.is_symlink()]
        except OSError:
            pass
        npm = os.path.join(home, ".npm", "_cacache")
        if os.path.isdir(npm) and not os.path.islink(npm):
            entries.append(npm)
        for path in sorted(entries):
            size, newest, foreign = walk_stats(path, uid)
            idle = (now - newest) / DAY
            if idle >= cfg["cache_idle_days"] and size > 0:
                if foreign:
                    notes.append(f"kept {path}: {foreign} is another user's, and hb clean works with the owner's rights")
                else:
                    actions.append(Action("caches", f"{path} (untouched {idle:.0f} days)", size, remove([path], home, uid)))
            elif size >= 10**9:
                notes.append(f"kept {path}: {human(size)}, used {idle:.0f} days ago")
    return actions, notes


# --- docker ------------------------------------------------------------------------

def docker(*args):
    rc, out, err = util.run("docker", *args, timeout=600)
    if rc != 0:
        raise RuntimeError(f"docker {args[0]} {args[1] if len(args) > 1 else ''}: {err.strip()[:200]}")
    return out


def docker_fn(*args):
    def fn():
        docker(*args)
        return "docker " + " ".join(args)
    return fn


def parse_size(text):
    m = re.match(r"([\d.]+)\s*([kKMGT]?)B", text.strip())
    if not m:
        return 0
    return int(float(m.group(1)) * 1000 ** " kMGT".index(m.group(2).replace("K", "k") or " "))


def created_age(text, now):
    try:
        return (now - datetime.datetime.strptime(text[:19], "%Y-%m-%d %H:%M:%S").timestamp()) / DAY
    except ValueError:
        return 0


def plan_docker(cfg, now):
    if not cfg["docker"]:
        return [], ["docker: not managed (clean.docker = false)"]
    actions, notes = [], []
    cdays, idays = cfg["docker_container_days"], cfg["docker_image_days"]

    old = []
    for line in docker("ps", "-a", "--filter", "status=exited", "--filter", "status=created",
                       "--filter", "status=dead", "--format", "{{.Names}}\t{{.CreatedAt}}").splitlines():
        name, created = line.split("\t", 1)
        if created_age(created, now) >= cdays:
            old.append(name)
    if old:
        actions.append(Action("docker", f"stopped containers older than {cdays} days: {' '.join(old)}", 0,
                              docker_fn("container", "prune", "-f", "--filter", f"until={cdays * 24}h")))

    df = {}                                            # docker system df, by type: its own reclaimable counts
    for line in docker("system", "df", "--format", "{{json .}}").splitlines():
        row = json.loads(line)
        df[row.get("Type")] = row
    ids = docker("ps", "-aq").split()
    used = set(docker("inspect", "--format", "{{.Image}}", *ids).split()) if ids else set()
    unused, size = [], 0
    for line in docker("image", "ls", "--no-trunc", "--format",
                       "{{.ID}}\t{{.Repository}}:{{.Tag}}\t{{.CreatedAt}}\t{{.Size}}").splitlines():
        iid, name, created, sz = line.split("\t")
        if iid not in used and created_age(created, now) >= idays:
            unused.append(name)
            size += parse_size(sz)
    if unused:
        # images share layers, so the sum of their sizes counts a layer once per image; Docker's own
        # figure for what unused images hold is an honest ceiling
        reclaim = parse_size(df.get("Images", {}).get("Reclaimable", ""))
        size = min(size, reclaim) if reclaim else size
        shown = ", ".join(sorted(set(unused))[:8]) + (", ..." if len(set(unused)) > 8 else "")
        actions.append(Action("docker", f"{len(unused)} unused images older than {idays} days ({shown}); "
                              "at most what Docker counts as reclaimable", size,
                              docker_fn("image", "prune", "-a", "-f", "--filter", f"until={idays * 24}h")))

    cap = parse_size(cfg["docker_build_cache"])
    row = df.get("Build Cache", {})
    have = parse_size(row.get("Size", ""))
    if have > cap:
        actions.append(Action("docker", f"build cache {human(have)}, trimmed to {cfg['docker_build_cache']}",
                              have - cap, docker_fn("builder", "prune", "-f", "-a",
                                                    "--max-used-space", cfg["docker_build_cache"])))
    dangling = docker("volume", "ls", "-q", "--filter", "dangling=true").split()
    if dangling:
        notes.append(f"docker: {len(dangling)} volumes no container uses (never removed): {' '.join(dangling)}")
    return actions, notes


PLANNERS = {"projects": plan_projects, "caches": plan_caches, "docker": plan_docker}


# --- registry (watched, not cleaned) ------------------------------------------------

def registry_size(cfg):
    """{bytes, images, tags, manifests} of the registry's storage, or None if there is none.
    Its images are multi-platform indexes, and registry 2.8's garbage collection breaks kept
    ones when told to remove untagged manifests, so hb only watches the size."""
    roots = sorted(glob.glob(cfg["registry_dir"])) if cfg.get("registry_dir") else []
    found = {"bytes": 0, "images": 0, "tags": 0, "manifests": 0}
    for root in roots:
        v2 = os.path.join(root, "docker", "registry", "v2")
        if not os.path.isdir(v2):
            continue
        found["bytes"] += walk_stats(root)[0]
        for path, dirs, _ in os.walk(os.path.join(v2, "repositories")):
            if "_manifests" in dirs:
                m = os.path.join(path, "_manifests")
                found["images"] += 1
                for key, sub in (("tags", "tags"), ("manifests", os.path.join("revisions", "sha256"))):
                    try:
                        found[key] += len(os.listdir(os.path.join(m, sub)))
                    except OSError:
                        pass
            dirs[:] = [d for d in dirs if not d.startswith("_")]
    return found if found["images"] or found["bytes"] else None


def registry_note(reg, cfg):
    return (f"registry: {human(reg['bytes'])}, {reg['images']} images, {reg['tags']} tags, "
            f"{reg['manifests']} manifests (watched, not cleaned; warns past {cfg['registry_warn']})")


def make_plan(cfg, targets):
    now, actions, notes = time.time(), [], []
    for t in targets:
        try:
            a, n = PLANNERS[t](cfg, now)
        except Exception as e:  # one broken target must not hide the others
            a, n = [], [f"{t}: ERROR {e.__class__.__name__}: {e}"]
        actions += a
        notes += n
    return actions, notes


def format_plan(actions, notes, heading):
    lines = [heading]
    for t in TARGETS:
        mine = [a for a in actions if a.target == t]
        if mine:
            lines.append(f"\n{t}: {human(sum(a.size for a in mine))}")
            lines += [f"  {human(a.size):>9}  {a.desc}" for a in sorted(mine, key=lambda a: -a.size)]
    if notes:
        lines.append("\nnotes:")
        lines += [f"  {n}" for n in notes]
    lines.append(f"\ntotal: {human(sum(a.size for a in actions))} in {len(actions)} actions")
    return "\n".join(lines) + "\n"


def confirm(question):
    try:
        with open("/dev/tty") as tty:
            print(f"{question} [y/N] ", end="", flush=True)
            return tty.readline().strip().lower().startswith("y")
    except OSError:
        return False


def apply(actions, yes):
    """([errors], [actions done])."""
    errors, done = [], []
    for a in actions:
        print(f"\n{human(a.size):>9}  {a.desc}")
        if not yes and not confirm("  remove?"):
            print("  skipped")
            continue
        try:
            print(f"  {a.fn()}")
            done.append(a)
        except Exception as e:
            errors.append(f"{a.desc}: {e}")
            print(f"  FAILED: {e}")
    return errors, done


def save_report(text, dry, actions, errors, reg, by_hand=False):
    """The last run, for hb clean check and the digest. A run by hand counts too."""
    jpath, tpath = report_paths()
    if reg is None:                                    # a run on some targets only: keep the last size seen
        reg = (util.read_json(jpath, None) or {}).get("registry")
    util.write_atomic(tpath, text)
    util.write_json(jpath, {"ts": int(time.time()), "dry_run": dry, "bytes": sum(a.size for a in actions),
                            "actions": len(actions), "errors": errors, "registry": reg, "by_hand": by_hand})


def report_paths():
    d = util.state_dir("clean")
    return os.path.join(d, "last.json"), os.path.join(d, "last.txt")


def disk_pct():
    du = shutil.disk_usage("/")
    return du.used * 100 / du.total


def cmd_auto(full):
    cfg = full["clean"]
    dry = cfg["dry_run"]
    heavy = (datetime.date.today().isoweekday() == cfg["heavy_weekday"]
             or disk_pct() >= full["health"]["disk_warn_pct"])
    targets = ["projects", "caches"] + (["docker"] if dry or heavy else [])
    actions, notes = make_plan(cfg, targets)
    reg = registry_size(cfg)
    if reg:
        notes.append(registry_note(reg, cfg))
    stamp = time.strftime("%Y-%m-%d %H:%M")
    text = format_plan(actions, notes, f"hb clean {'DRY RUN, nothing removed' if dry else 'run'}, {stamp}")
    errors, done = ([], actions) if dry else apply(actions, yes=True)
    if errors:
        text += "\nerrors:\n" + "".join(f"  {e}\n" for e in errors)
    print(text, end="")
    save_report(text, dry, done, errors, reg)
    return 1 if errors else 0


def cmd_check(cfg):
    jpath, _ = report_paths()
    rep = util.read_json(jpath, None)
    if not rep:
        print("ok: no report yet (hb-clean.timer writes one daily)")
        return 0
    when = time.strftime("%d %b %H:%M", time.localtime(rep["ts"]))
    if rep["errors"]:
        print(f"warn: {len(rep['errors'])} cleanup actions failed on {when} (hb clean report)")
        return 1
    reg = rep.get("registry")
    if reg and reg["bytes"] > parse_size(cfg["registry_warn"]):
        print(f"warn: registry {human(reg['bytes'])} ({reg['manifests']} manifests), "
              f"past clean.registry_warn {cfg['registry_warn']}")
        return 1
    verb = "reclaimable (dry run)" if rep["dry_run"] else "removed" + (" by hand" if rep.get("by_hand") else "")
    print(f"ok: {human(rep['bytes'])} {verb} on {when}" + (f"; registry {human(reg['bytes'])}" if reg else ""))
    return 0


def main(argv):
    args = argv[1:]
    verb = args.pop(0) if args and args[0] in ("plan", "apply", "auto", "report", "check", "help", "-h", "--help") else "plan"
    if verb in ("help", "-h", "--help"):
        print(__doc__.strip())
        return 0
    if os.geteuid() != 0:
        print("error: run with sudo", file=sys.stderr)
        return 2
    full = config.load()
    if verb == "auto":
        return cmd_auto(full)
    if verb == "check":
        return cmd_check(full["clean"])
    if verb == "report":
        try:
            with open(report_paths()[1]) as f:
                print(f.read(), end="")
            return 0
        except OSError:
            print("no report yet")
            return 1
    yes = "--yes" in args
    targets = [a for a in args if a != "--yes"] or list(TARGETS)
    bad = [t for t in targets if t not in TARGETS]
    if bad:
        print(f"hb-clean: unknown target {' '.join(bad)} (targets: {' '.join(TARGETS)})", file=sys.stderr)
        return 2
    actions, notes = make_plan(full["clean"], targets)
    reg = registry_size(full["clean"]) if not args else None
    if reg:
        notes.append(registry_note(reg, full["clean"]))
    if verb == "plan":
        print(format_plan(actions, notes, "hb clean plan (nothing removed)"), end="")
        return 0
    errors, done = apply(actions, yes)
    stamp = time.strftime("%Y-%m-%d %H:%M")
    text = format_plan(done, notes, f"hb clean apply by hand, {stamp} (what was removed)")
    if errors:
        text += "\nerrors:\n" + "".join(f"  {e}\n" for e in errors)
    save_report(text, False, done, errors, reg, by_hand=True)
    return 1 if errors else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
