#!/usr/bin/python3 -IB
"""hb-totp — the 6-digit code public SSH asks for after the key.

  hb totp status            who can answer the prompt, recovery codes left
  hb totp enrol USER        a new secret for an authenticator app (QR code or
                            typed), proven with one code; prints 10 recovery codes
  hb totp codes USER        10 new recovery codes; the old ones stop working
  hb totp ready USER...     exit 0 when every USER can answer the prompt
  hb totp check             one-line verdict (exit 0 ok, 1 attention)
  hb-totp verify            PAM's entry point (pam_exec expose_authtok): the code
                            on stdin, the user in PAM_USER; exit 0 lets them in

Codes follow RFC 6238: HMAC-SHA1, 6 digits, 30-second steps, one step of clock
drift either way, and a step that was used once is refused after. A recovery
code (ten characters, printed as XXXXX-XXXXX) works once and only its scrypt
hash is kept. Each user's file is /etc/hb/secrets/totp/<user>, root-only; a
file with recovery codes and no secret is fine (the rescue account's). Any
error refuses the login.

Guessing: sshd only shows the prompt after the key is accepted, allows
MaxAuthTries attempts per connection, and its PerSourcePenalties slow down an
address that keeps failing. sudo (hb harden's admins) has no such limits, so the
check keeps its own per account, shared by both and by parallel attempts: after
5 wrong answers in 15 minutes every answer is refused, a right one too, until the
oldest is 15 minutes old, and hb notify sends an SMS (fail) when that starts.
A right answer clears the count.

Config ([totp] in hb.toml): issuer, the name the authenticator app shows
(default: this host's short name).
"""
import datetime
import json
import os
import pwd
import re
import secrets
import socket
import subprocess
import sys
import time

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), os.pardir, "lib"))
import hbkit.start  # noqa: E402,F401  (first: Python 3.11+, and a quiet end when the output pipe closes)
from hbkit import otp, util  # noqa: E402

DIR = "/etc/hb/secrets/totp"
USER = re.compile(r"^[a-z_][a-z0-9_-]{0,31}$")
ALPHABET = "0123456789ABCDEFGHJKMNPQRSTVWXYZ"   # Crockford's base32: no I, L, O or U
N_CODES, LOW_CODES = 10, 3
# After FAIL_LIMIT wrong answers within FAIL_WINDOW seconds, every answer is refused, a right one
# too, until the oldest of them is FAIL_WINDOW old: one budget per account, shared by sshd and sudo
# and every process calling this at once (they take the same lock).
FAIL_LIMIT, FAIL_WINDOW = 5, 15 * 60
PATH_ENV = {"PATH": "/usr/sbin:/usr/bin:/sbin:/bin"}

# RFC 4226 / 6238 and the scrypt hashes live in lib/hbkit/otp.py, shared with the web shell.
STEP, DIGITS, DRIFT = otp.STEP, otp.DIGITS, otp.DRIFT
hotp, b32key, match_totp = otp.hotp, otp.b32key, otp.match_totp


# --- recovery codes -----------------------------------------------------------------

def new_code():
    raw = "".join(secrets.choice(ALPHABET) for _ in range(10))
    return f"{raw[:5]}-{raw[5:]}"


def norm_code(text):
    """A recovery code as stored (ten characters, no dash), or None."""
    t = text.upper().replace("-", "").replace(" ", "").translate(str.maketrans("ILO", "110"))
    return t if len(t) == 10 and all(c in ALPHABET for c in t) else None


def hash_code(code):
    return otp.scrypt_hash(code)


def code_matches(code, stored):
    return otp.scrypt_matches(code, stored)


# --- files ----------------------------------------------------------------------------

def user_path(user):
    if not USER.match(user):
        raise ValueError(f"{user!r} is not a user name")
    return os.path.join(DIR, user)


def load(user):
    try:
        with open(user_path(user)) as f:
            return json.load(f)
    except FileNotFoundError:
        return None


def save(user, data):
    os.makedirs(DIR, mode=0o700, exist_ok=True)
    util.write_atomic(user_path(user), json.dumps(data, indent=1) + "\n", mode=0o600)


def lock():
    os.makedirs(DIR, mode=0o700, exist_ok=True)
    return util.Lock(os.path.join(DIR, ".lock"))


def usable(data):
    return bool(data and (data.get("secret") or data.get("codes")))


# --- PAM --------------------------------------------------------------------------------

def answer(data, text, now):
    """Whether TEXT is a right code for DATA (which it updates: the step used, a recovery code
    gone), and how many recovery codes are left when one was used."""
    if re.fullmatch(r"\d{6}", text):
        if not data.get("secret"):
            return False, None
        step = match_totp(data["secret"], text, int(data.get("last_step", 0)), now)
        if step is None:
            return False, None
        data["last_step"] = step
        return True, None
    code = norm_code(text)
    if code is None:
        return False, None
    for i, stored in enumerate(data.get("codes", [])):
        if code_matches(code, stored):
            del data["codes"][i]
            return True, len(data["codes"])
    return False, None


def verify(env, raw, now=None):
    """0 lets the login through; everything else, including any error, is 1."""
    if env.get("PAM_TYPE") != "auth":
        return 1
    user = env.get("PAM_USER", "")
    if not USER.match(user):
        return 1
    text = raw[:512].decode("utf-8", "replace").replace("\0", "").strip()
    with lock():
        # the time is read under the lock, so attempts are judged in the order they hold it
        now = time.time() if now is None else now
        data = load(user)
        if not usable(data):
            return 1
        # a failure from the future (the clock went back) counts as now, rather than as expired,
        # and is kept as now, so it ages from here
        seen = data.get("fails", [])
        fails = [min(t, now) for t in seen if now - min(t, now) < FAIL_WINDOW]
        if len(fails) >= FAIL_LIMIT:
            if any(t > now for t in seen):
                data["fails"] = fails
                save(user, data)
            return 1                       # locked: not counted, so it ends FAIL_WINDOW after the oldest
        ok, left = answer(data, text, now)
        data["fails"] = [] if ok else fails + [now]
        save(user, data)
    if ok:
        if left is not None:
            announce(user, left)
        return 0
    if len(data["fails"]) == FAIL_LIMIT:
        locked(user)
    return 1


def locked(user):
    """An SMS (hb notify fail) that someone keeps giving wrong codes; detached."""
    try:
        subprocess.Popen([util.HB, "notify", "send", "fail", "totp.locked",
                          f"{FAIL_LIMIT} wrong codes for {user} in {FAIL_WINDOW // 60} minutes: "
                          f"codes refused until the oldest is {FAIL_WINDOW // 60} minutes old"],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True, env=PATH_ENV)
    except OSError:
        pass


def announce(user, left):
    """Banner note that a recovery code went; detached, so the login doesn't wait."""
    try:
        subprocess.Popen([util.HB, "notify", "send", "warn", "totp.code",
                          f"recovery code used for {user}; {left} left"],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True, env=PATH_ENV)
    except OSError:
        pass


def safe_verify():
    try:
        return verify(os.environ, sys.stdin.buffer.read(4096))
    except Exception:  # noqa: BLE001 - any failure refuses the login
        return 1


# --- verbs ---------------------------------------------------------------------------

def need_user(user):
    try:
        pwd.getpwnam(user)
        user_path(user)
        return True
    except (KeyError, ValueError):
        print(f"no user {user!r}")
        return False


def print_codes(user, codes):
    print(f"\nRecovery codes for {user}. Each works once at the code prompt, in place of")
    print("the 6 digits. Keep them off this server (a password manager, or on paper):\n")
    for i in range(0, len(codes), 2):
        print("    " + "    ".join(codes[i:i + 2]))
    print()


def new_codes():
    codes = [new_code() for _ in range(N_CODES)]
    return codes, [hash_code(norm_code(c)) for c in codes]


def issuer(cfg):
    return cfg["totp"]["issuer"] or socket.gethostname().split(".")[0]


def do_enrol(user, cfg):
    if not need_user(user):
        return 2
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        print("enrol needs a terminal")
        return 2
    old = load(user)
    if old and old.get("secret") and not util.ask(f"{user} already has a secret; replace it (the old one stops working)?"):
        print("nothing changed")
        return 1
    secret, step = otp.enrol(issuer(cfg), user)
    if secret is None:
        print("nothing saved")
        return 1
    codes, hashes = new_codes()
    with lock():
        save(user, {"secret": secret, "codes": hashes, "last_step": step,
                    "enrolled": datetime.date.today().isoformat()})
    print(f"\n{user} is enrolled.")
    print_codes(user, codes)
    return 0


def do_codes(user, plain):
    if not need_user(user):
        return 2
    if not plain and not util.ask(f"make 10 new recovery codes for {user} (the old ones stop working)?"):
        print("nothing changed")
        return 1
    codes, hashes = new_codes()
    with lock():
        data = load(user) or {"last_step": 0}
        data["codes"] = hashes
        data["codes_made"] = datetime.date.today().isoformat()
        save(user, data)
    if plain:
        print("\n".join(codes))
    else:
        print_codes(user, codes)
    return 0


def do_ready(users):
    missing = [u for u in users if not (USER.match(u) and usable(load(u)))]
    print(("not enrolled: " + ", ".join(missing)) if missing else "ready: " + ", ".join(users))
    return 1 if missing else 0


def enrolled():
    """{user: data} for every file in DIR."""
    out = {}
    try:
        names = sorted(os.listdir(DIR))
    except OSError:
        return out
    for n in names:
        if USER.match(n):
            try:
                out[n] = load(n)
            except (OSError, ValueError):
                out[n] = None
    return out


def describe(data):
    if not data:
        return "unreadable"
    n = len(data.get("codes", []))
    return ("app + " if data.get("secret") else "") + f"{n} recovery code{'' if n == 1 else 's'}"


def clock_synced():
    rc, out, _ = util.run("timedatectl", "show", "-p", "NTPSynchronized", "--value")
    return rc != 0 or out.strip() == "yes"   # unknown counts as fine


def verdict(cfg):
    users = enrolled()
    need = [l.split()[0] for l in cfg["ssh"]["keys"] if l.split()] if cfg["ssh"]["codes"] else []
    need += cfg["harden"]["admins"]          # their sudo takes the code
    if not users and not need:
        return 0, "ok: not in use"
    problems = [f"{u} not enrolled" for u in dict.fromkeys(need) if not usable(users.get(u))]
    problems += [f"{u} has {len(d.get('codes', []))} recovery codes left" for u, d in users.items()
                 if d and len(d.get("codes", [])) < LOW_CODES]
    problems += [f"{u}: file unreadable" for u, d in users.items() if d is None]
    if not clock_synced():
        problems.append("the clock isn't NTP-synchronised; codes depend on it")
    if problems:
        return 1, "warn: " + "; ".join(problems)
    return 0, "ok: " + ", ".join(f"{u} ({describe(d)})" for u, d in users.items())


def do_status(cfg):
    users = enrolled()
    if not users:
        print("nobody enrolled")
    for u, d in users.items():
        since = (d.get("enrolled") or d.get("codes_made") or "?") if d else "?"
        print(f"{u:<12} {describe(d)}, since {since}")
    print("clock: " + ("NTP-synchronised" if clock_synced() else "NOT synchronised"))
    return verdict(cfg)[0]


def main(argv):
    verb = argv[1] if len(argv) > 1 else "status"
    if verb == "verify":
        return safe_verify()
    if verb in ("help", "-h", "--help"):
        print(__doc__.strip())
        return 0
    if os.geteuid() != 0:
        print("error: run with sudo", file=sys.stderr)
        return 2
    from hbkit import config
    cfg = config.load()
    if verb == "status":
        return do_status(cfg)
    if verb == "check":
        rc, line = verdict(cfg)
        print(line)
        return rc
    if verb == "enrol" and len(argv) == 3:
        return do_enrol(argv[2], cfg)
    if verb == "codes" and len(argv) in (3, 4):
        return do_codes(argv[2], "--plain" in argv[3:])
    if verb == "ready" and len(argv) > 2:
        return do_ready(argv[2:])
    print(__doc__.strip(), file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
