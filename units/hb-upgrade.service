# Managed by hb install from units/; changes made here are overwritten.
[Unit]
Description=hb: nightly upgrade (dnf, held snaps), reboot only when needed and idle
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
Environment=HOME=/root
ExecStart=/opt/hb/hb upgrade run
Nice=10
TimeoutStartSec=2h
