# Managed by hb install from units/; changes made here are overwritten.
[Unit]
Description=hb: nightly restic backup
Wants=network-online.target
After=network-online.target remote-fs.target

[Service]
Type=oneshot
Environment=HOME=/root
ExecStart=/opt/hb/hb backup run
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=8h
