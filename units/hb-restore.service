# Managed by hb install from units/; changes made here are overwritten.
[Unit]
Description=hb: restore a random sample of the newest backup and compare it with the live files
Wants=network-online.target
After=network-online.target remote-fs.target

[Service]
Type=oneshot
Environment=HOME=/root
ExecStart=/opt/hb/hb restore drill
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=4h
