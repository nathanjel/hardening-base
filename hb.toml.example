# hb configuration. Copy to hb.toml in the checkout; `hb install apply` then
# copies it to /etc/hb/hb.toml (root's, mode 600), which every tool reads from
# then on. Anything left out keeps its default, and every default means "don't
# touch": empty lists, false, and "" for not managed.

[harden]
remove_accounts = []          # e.g. ["fedora"]: the cloud image's default user
remove_files = []             # files or folders, e.g. ["/etc/sudoers.d/90-cloud-init-users"]
permit_root_login = ""        # "no" to forbid root over SSH
sysctl = []                   # "key = value"; * matches any one name, e.g.
                              # ["net.ipv4.conf.*.send_redirects = 0", "kernel.yama.ptrace_scope = 1"]
llmnr = ""                    # "no" to switch off systemd-resolved's LLMNR responder (5355)

[k8s]
flavour = "microk8s"          # the only one supported
nodeport_addresses = []       # e.g. ["127.0.0.0/8"]: NodePorts on localhost only
token_off_namespaces = []     # namespaces whose pods never call the Kubernetes API
freeze_certs = false          # true: microk8s stops reissuing its API certificate (and
                              # restarting every container) whenever the host gains an address
cluster_agent_bind = ""       # e.g. "127.0.0.1:25000": the join agent, unused on one box
keep_restarting = []          # e.g. ["kubelite", "k8s-dqlite", "containerd"]: retry every 10 s for as
                              # long as it takes, where snapd's units give up after 5 quick failures

[health]
containers = []               # docker containers that must be running
urls = []                     # sites that must answer over verified TLS (status < 500)
mounts = []                   # mount points that must be mounted
registry = ""                 # e.g. "http://localhost:32000/v2/"
asterisk_container = ""       # checks trunk registrations; busy.d checks calls
disk_warn_pct = 80
disk_fail_pct = 90
reboot_fail_days = 7          # a newer kernel waiting this long counts as a failure
cert_warn_days = 14           # warn when a site's certificate expires sooner
nvme_wear_warn_pct = 80       # warn when an NVMe drive reports this much wear

[snapshot]
dir = "/.hb-snapshots"
keep_days = 14                # hb snapshot check warns about older ones. A snapshot keeps everything
                              # deleted after it on the same disk: on a busy disk, 1 or 2

[install]
timers = []                   # e.g. ["hb-status", "hb-backup", "hb-backup-maintain", "hb-clean"]

[notify]
sms_command = []              # argv that gets the text on stdin and exits 0 once queued,
                              # e.g. ["/usr/local/bin/send-sms", "<your number>"]; empty: banner only
sms_fallback = []             # tried when sms_command fails: a route that doesn't share its failures, e.g.
                              # ["/opt/hb/hooks/sms-supervoip", "--to", "+48...", "--sender", "<your sender>"]
sms_per_day = 5               # at most this many SMS in 24 hours
repeat_hours = 24             # the same alert again only after this long
retry_minutes = 60            # keep retrying an SMS that can't go out for this long

[alerts]
mdadm = false                 # true: mdmonitor reports RAID events through hb-notify
smartd = false                # true: install smartd and have it report through hb-notify

[backup]
repo = ""                     # e.g. "/mnt/backup/restic"; nothing runs while empty
password_file = "/etc/hb/secrets/restic-password"   # created by hb backup init
require_mount = ""            # e.g. "/mnt/backup": refuse to run unless this is mounted
paths = []                    # e.g. ["/etc", "/root", "/home", "/usr/local", "/var/lib/hb"]
exclude = []                  # restic patterns, e.g. ["/home/*/.cache", "node_modules"]
exclude_if_present = [".hb-nobackup"]   # skip the contents of folders holding this file
keep_daily = 7
keep_weekly = 5
keep_monthly = 12
warn_hours = 26               # warn when the last good backup is older
fail_hours = 50               # fail (SMS) when it is older: two nights missed
read_data_percent = 10        # share of the data read back in the first week of each month

[restore]
# hb restore drill (quarterly, hb-restore.timer): random files from the newest snapshot,
# restored and compared byte for byte with the live ones that haven't changed since.
sample_files = 200
max_file_mb = 200             # bigger files aren't picked
must_have = ["/etc/hb/hb.toml", "/var/lib/hb/state"]   # the drill fails if a snapshot lacks one
drill_days = 92               # the check warns a week after this

[rebuild]
# hb rebuild sets up a fresh box from the newest snapshot; it only ever adds what's missing.
files = ["/etc/yum.repos.d/*.repo", "/etc/pki/rpm-gpg/*", "/etc/docker/daemon.json", "/usr/local/bin/*", "/usr/local/sbin/*"]
data = []                     # empty: backup.paths without /etc, /usr/local and hb's own state
skip_namespaces = ["kube-system", "kube-public", "kube-node-lease", "ingress", "cert-manager",
                   "container-registry", "metallb-system", "observability"]   # microk8s' own

[inventory]
# hb inventory writes the state dump before each backup and notes what changed since the
# one before (hb inventory drift; the digest lists the last 24 hours).
drift_ignore = []             # regexes, e.g. "^k8s changed: default/Secret/" for renewing certificates

[disk]
# hb disk: the biggest folders, what grew, and big folders nobody touched (hb-disk.timer, Sundays).
show_gb = 2
stale_roots = ["/home", "/root", "/srv", "/opt", "/var/tmp", "/var/lib/hb/backup"]
stale_days = 30               # no file inside changed for this long
stale_gb = 1
stale_ignore = []             # globs: kept on purpose, e.g. "/srv/app/recordings"
skip = []                     # folders never walked (hb's snapshots never are)

[clean]
dry_run = true                # report only; set false once the reports look right
users = []                    # whose ~/.cache to clean
project_roots = []            # where to look for idle git repos
idle_days = 14
venv_idle_days = 90
build_dirs = ["target", "build", "dist", "__pycache__", ".pytest_cache", ".mypy_cache", "cmake-build-*", "node_modules"]
cache_idle_days = 30
docker = false                # true: prune stopped containers, old unused images, build cache
docker_container_days = 7
docker_image_days = 14
docker_build_cache = "15GB"
heavy_weekday = 6             # docker cleanup day once live: 1 = Monday ... 7 = Sunday
# The image registry is only measured: its size is in the report, and the check warns past registry_warn.
registry_dir = "/var/snap/microk8s/common/default-storage/container-registry-registry-claim-*"
registry_warn = "10GB"

[wg]
interface = "wg0"
address = ""                  # the server's tunnel address, e.g. "10.77.0.1/24"; empty: not managed
port = 51820
endpoint = ""                 # the name your PCs dial, e.g. "vpn.example.com"
peers = []                    # "NAME ADDRESS PUBLIC-KEY", the key from the PC's WireGuard app, e.g.
                              # ["desk 10.77.0.2 <44 characters ending in =>"]

[fw]
revert_minutes = 5            # unconfirmed changes go back after this long

# One table per zone hb fw manages; zones not listed stay as they are.
# [fw.zones.public]
# services = ["ssh", "http", "https", "wireguard"]
# rules = ["5060/udp from 192.0.2.0/27"]     # PORT/PROTO from NETWORK
# forward = true
#
# [fw.zones.wg]
# interfaces = ["wg0"]
# services = ["ssh"]
# ports = ["16443/tcp"]
# Also: target ("default", "ACCEPT", "DROP", "%%REJECT%%") and sources.
# `sudo hb fw export public` prints a zone as it is today, in this form.

[probe]
host = ""                     # the name to scan from outside
expect_tcp = []               # e.g. [22, 80, 443]: what should answer

[ssh]
keys = []                     # "USER TYPE KEY [COMMENT]", e.g. "alice ssh-ed25519 AAAA... alice@laptop";
                              # empty: hb ssh manages nothing
codes = false                 # true: key, then a 6-digit code (hb totp) from the internet
key_only_from = []            # networks where the key alone is enough, e.g. ["10.77.0.0/24"]
revert_minutes = 5            # an unconfirmed change undoes itself after this

[totp]
issuer = ""                   # the name the authenticator app shows; default: the short host name

[breakglass]
user = ""                     # e.g. "rescue"; empty: hb breakglass manages nothing
uid = 4700                    # a uid no account or container uses
host = ""                     # the name the kit connects to; default probe.host
test_days = 180               # hb check reminds you when the kit hasn't been used for longer
note = ""                     # top of the kit page: where the provider login is kept, who to call

[share]
# Samba on the WireGuard interface only (wg.interface, wg.address), for one user.
# Open 445/tcp in the WireGuard zone first: add "445/tcp" to fw.zones.<zone>.ports.
user = ""                     # e.g. "you"; empty: hb share manages nothing
shares = []                   # "NAME PATH", e.g. "workspaces ~/workspaces"; ~ is the user's home

[webshell]
# Your shell in a browser, over WireGuard (http://<wg address>:<port>). Open 7681/tcp in the
# WireGuard zone first. Public mode is optional: `hb webshell open 2h` publishes host through
# the cluster's ingress for that long, then closes by itself.
user = ""                     # whose shell; empty: hb webshell manages nothing
port = 7681
host = ""                     # public name, e.g. "shell.example.org" (a DNS record to this server); empty: WireGuard only
ingress_from = []             # where the ingress connects from (the pod network), e.g. ["10.1.0.0/16"]
ingress_class = "public"      # the cluster's ingress class
namespace = "default"         # where the Service, EndpointSlice, Certificate and Ingress go
issuer = ""                   # cert-manager ClusterIssuer for host, e.g. "letsencrypt"
middlewares = ""              # traefik router.middlewares annotation, e.g. "default-redirect-https@kubernetescrd"
max_hours = 12                # the longest window hb webshell open allows

[upgrade]
# Nightly at 04:30 (hb-upgrade.timer, add it to install.timers), retried every 30 minutes until
# window_end while the box is busy: a snapshot, dnf upgrade, then snap refresh and a reboot only when idle.
enabled = false
window_end = "07:00"
snaps = []                    # snaps whose auto-refresh is held and done here instead, e.g. ["microk8s", "snapd", "core22"]
snapshot_days = 3             # how long the pre-upgrade snapshots stay; 0: none (on a busy disk,
                              # where they'd hold days of deleted files: the backup is the way back)
force_after_days = 0          # 0: never reboot while busy; N: reboot anyway once it has waited N days

[busy]
# What busy.d counts as "someone is working": hb upgrade waits, and so do disruptive hb k8s steps.
idle_minutes = 60             # typing in any terminal or the web shell within this long
max_load = 2.0                # 5-minute load average
processes = ["make", "cargo", "rustc", "cc1", "cc1plus", "go", "gradle", "mvn", "npm", "pytest", "buildkitd", "dnf", "rpm"]

[digest]
# The morning summary (hb-digest.timer, 06:45). Reminders show in it and in the banner from their date on.
reminders = []                # "YYYY-MM-DD text"
