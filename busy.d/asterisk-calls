#!/usr/bin/env bash
# Busy while Asterisk has calls up. Not busy when there is no Asterisk container.
# Container name: health.asterisk_container in hb.toml.
c="$("${HB_ROOT:?}/tools/hb-config" get health.asterisk_container 2>/dev/null)"
[ -n "$c" ] && docker inspect "$c" >/dev/null 2>&1 || exit 0
n="$(docker exec "$c" asterisk -rx 'core show channels count' 2>/dev/null | awk '/active call/ {print $1}')"
[ "${n:-0}" -eq 0 ] && exit 0
echo "$n active call(s) in $c"
exit 1
